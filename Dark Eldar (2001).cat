        <characteristic name="AP" typeId="25ce-028f-0aae-2855">5</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Assault 6</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2"/>
      </characteristics>
    </profile>
    <profile name="Agoniser" id="1dce-9521-0810-0df1" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">4+</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">2</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Agonizers wound a 4+ regardless of the Toughness of the target and ignore all armor saves. Against vehicles, a roll of 6 causes a glancing hit regardless of the vehicle&apos;s Armour Value.</characteristic>
      </characteristics>
    </profile>
    <profile name="Hellglaive" id="8307-de36-e7d3-16c0" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">As User*</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">-</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Incorporates a Splinter Rifle. +1 S in the first round of combat after the user charges.</characteristic>
      </characteristics>
    </profile>
    <profile name="Talos Claws" id="85c9-6f3a-9cc3-cb24" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">2</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">No armor saves allowed. Against vehicles, roll only once for armor penetration regardless of the number of hits, but add +1 to the roll for each hit scored by the Talos after the first (e.g. if the Talos hits three times add +2 to its AP roll).</characteristic>
      </characteristics>
    </profile>
    <profile name="Punisher" id="f63e-81a8-5be7-636e" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">User +1</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">2</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">The punisher is a two-handed power weapon used by Dark Eldar Incubi. It also adds +1 to the user&apos;s Strength.</characteristic>
      </characteristics>
    </profile>
    <profile name="Poisoned Blade" id="c04e-5394-eec7-116c" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">2+</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">-</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Poisoned Blade always wound on a 2+ regardless of the victim&apos;s Toughness. However, this ability may not be combined with the ability of any other weapon in close combat.</characteristic>
      </characteristics>
    </profile>
    <profile name="Scissorhands" id="6b4d-c602-8f66-3478" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">2+</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">-</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Add +1 A to the user. Poisoned Blade always wound on a 2+ regardless of the victim&apos;s Toughness. However, this ability may not be combined with the ability of any other weapon in close combat.</characteristic>
      </characteristics>
    </profile>
