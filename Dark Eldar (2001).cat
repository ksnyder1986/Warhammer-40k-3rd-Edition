    <selectionEntry name="Urien Rakarth" id="f65f-1eb2-82e4-a947" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Infantry" id="1aa9-5bab-52c6-e222" hidden="false" primary="false" targetId="6953-6bba-0bb9-d49d"/>
