      </entryLinks>
      <infoLinks>
        <infoLink name="Combat Drugs" id="5deb-522e-1077-6a33" hidden="false" targetId="e622-df34-cea1-5528" type="rule"/>
      </infoLinks>
      <modifierGroups>
        <modifierGroup>
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
