          <rules>
            <rule name="Signum" id="ac25-1d26-28c2-6e75" hidden="false">
              <description>Each turn, you may re-roll one missed to hit shooting dice for the Command squad the Techmarine belongs to.</description>
            </rule>
          </rules>
        </selectionEntry>
