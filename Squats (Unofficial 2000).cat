              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry name="Holy Relic" id="7562-1530-32ff-854c" collective="false" hidden="false" import="true" type="upgrade">
          <comment>Solo portaestandarte, uno por ejercito</comment>
          <constraints>
            <constraint id="de0b-6967-b484-8083" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="956f-ab6c-cf44-55b2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="40"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="7cae-5791-3b34-f7e2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="atMost" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Holy Relic" id="ec33-bab4-2fc7-b001" hidden="false">
              <description>Once per battle. On any turn the model with the relic does not move they may reveal it. All friendly models that are within 2D6&quot; gain +1 Attacks for the rest of that turn. The relic may be revealed in the opposing player&apos;s turn assuming the model with the relic did not move in the previous turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Iron Halo" id="10e4-5f85-938b-565d" collective="false" hidden="false" import="true" type="upgrade">
          <comment>solo uno por ejercito</comment>
          <constraints>
            <constraint id="c606-1dfd-b2d7-26cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="b349-48f4-f402-7b6b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="25"/>
          </costs>
          <rules>
            <rule name="Iron Halo" id="402a-1321-d877-d955" hidden="false">
              <description>The iron halo grants a 4+ invulnerable save.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Clan Banner" id="0817-7074-23d1-9a2a" collective="false" hidden="false" import="true" type="upgrade">
          <comment>solo portaestandarte, solo se puede combinar con la reliquia a partir de 2.500 puntos de ejercito</comment>
          <constraints>
            <constraint id="1e02-1489-9a2b-a1bc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="6cb2-4e31-d604-5c93" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="60"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="7cae-5791-3b34-f7e2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="atMost" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Clan Banner" id="d90a-30e0-9661-79d6" hidden="false">
              <description>Once per battle. On any turn the model with the relic does not move they may reveal it. All friendly models that are within 2D6&quot; gain +1 Attacks for the rest of that turn. The relic may be revealed in the opposing player&apos;s turn assuming the model with the relic did not move in the previous turn.

Add +1 to the Squat combat resolution socre of any assault that takes place within 6&quot; of the Sacred Banner.
However, if the model bearing the standard is slain in close combat, then the enemy model that slew him captures the standard gains the +1 bonus to combat resolution from then on. It is possible for the model to change hands multiple times per game.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Krak Grenades" id="a21c-58ac-abf2-5db7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6df2-326e-5bfe-b0c9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="2"/>
          </costs>
          <infoLinks>
            <infoLink name="Krak Grenades" id="a599-6a8e-cdf3-5d5b" hidden="false" targetId="9c1b-bf93-059b-27f5" type="profile"/>
          </infoLinks>
        </selectionEntry>
        <selectionEntry name="Master-Crafted Weapon" id="322a-6fb6-a524-3263" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ba08-7a82-7ffd-e267" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="2"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
          <rules>
            <rule name="Master-crafted Weapons" id="5257-0761-f5d7-a207" hidden="false">
              <description>The bearer may re-roll one failed to hit roll per turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Meltabombs" id="2bb6-3772-a44b-afdc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2347-728c-ffbc-9566" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
