          </infoLinks>
        </selectionEntry>
        <selectionEntry name="Psychic Hood" id="e535-4918-086e-48dd" collective="false" hidden="false" import="true" type="upgrade">
          <comment>solo ancestros</comment>
          <constraints>
            <constraint id="9ec9-33a4-c99b-56b0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="25"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="3aba-97ee-9f04-1e25" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Psychic Hood" id="b399-df15-f08d-7905" hidden="false">
              <description>Declare you&apos;ll use the Psychic Hood after an opponent has successfully made a Psychic test, but before they have resolved the power. Each player rolls a D6 and adds their respective model&apos;s Leadership value. If the Space Marine beats the opposing model&apos;s score then the psychic power is nullified and may not be used that turn. Otherwise the power is unaffected. The Hood may be used each time an enemy model uses a power.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Sacred Banner" id="697c-6b2b-cf8d-3504" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dfd2-1e00-dfe7-7a1e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="7cae-5791-3b34-f7e2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="atMost" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Sacred Standard" id="0b17-db68-63ff-e3d2" hidden="false">
              <description>Add +1 to the Squat combat resolution score of any assault that takes place within 6&quot; of the Sacred Banner.
However, if the model bearing the standard is slain in close combat, then the enemy model that slew him captures the standard gains the +1 bonus to combat resolution from then on. It is possible for the model to change hands multiple times per game.</description>
            </rule>
          </rules>
        </selectionEntry>
