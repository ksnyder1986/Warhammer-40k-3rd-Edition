      <rules>
        <rule name="Hammer of Fury" id="595d-145f-1eda-adb2" hidden="false">
          <description>Roll 2D6 when determining total armour penetration against vehicles. Infantry hit by the power are pushed back 3&quot; directly away from the Ancestor. Vehicles that moved in the previous turn, and hit by the power, are Stunned in the next turn.</description>
        </rule>
      </rules>
