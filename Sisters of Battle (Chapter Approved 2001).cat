          <rules>
            <rule name="Sacred Banner of the Order Militant" id="8efd-321e-938c-08b3" hidden="false">
              <description>A unit with a model within 12&quot; of the Sacred Banner of the Order Militant may roll 3 dice for any Morale or Pinning test and discard the highest dice. However, if the model bearing the banner is slain in close combat, then the enemy model that slew her captures the banner and the enemy gains this bonus instead. It is possible for the banner to be recovered by the Sisters of Battle, which causes the new model to hold the banner.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Sacred Standard" id="5925-0429-7d37-fac9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="26f4-2e21-8db7-288e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="3601-f467-dd69-f9b1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="78f5-6d13-2873-6ee9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="1273-e50d-b746-3712" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="73a2-40cc-c7c6-1f3b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="740e-7670-823d-acd0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Sacred Standard" id="bdd2-0adb-b5ab-bf5a" hidden="false">
              <description>Any Imperial Units within 6&quot; of the Sacred Standard adds +1 to its combat resolution score. However, if the model bearing the banner is slain in close combat, then the enemy model that slew her captures the banner and the enemy gains this bonus instead. It is possible for the banner to be recovered by the Sisters of Battle, which causes the new model to hold the banner.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
