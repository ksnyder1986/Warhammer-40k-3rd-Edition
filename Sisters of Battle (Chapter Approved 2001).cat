      </infoLinks>
      <rules>
        <rule name="Sacred Rites" id="2b33-f0d6-cf96-000b" hidden="false">
          <description>Each Saraphim squad adds +1 Faith Points.</description>
        </rule>
        <rule name="Hit &amp; Run" id="2f85-f389-30e1-fac8" hidden="false">
          <description>Seraphim may choose to leave close combat. Declare this at the end of an Assault phase after all morale checks have been taken. The Seraphim then fall back 3D6 in any direction and regroup at the end of the move. Enemy models may only consolidate.</description>
        </rule>
      </rules>
