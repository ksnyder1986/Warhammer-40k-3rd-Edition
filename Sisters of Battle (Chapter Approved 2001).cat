              <repeats>
                <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="a063-c048-be5d-bf3b" shared="true" value="1"/>
              </repeats>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Exterminators" id="9f88-b707-bbb7-bcf3" hidden="false" typeId="7279-038a-b87a-ed0c" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="a08a-36f8-2fd3-b843">Exterminators are used once per battle in the first round of an assault. Exterminator attacks are resolved at Initiative 8 and are in addition to the models&apos; normal attacks. Roll a D6 for every enemy model in a unit fighting against the Redemptionists. The score required to hit the enemy depends upon the number of models in the Redemptionists unit. Models are hit by a S4 AP5 weapon.
* 1 to 5 Models: 6+ to hit
* 6 to 10 Models: 5+ to hit
* 11 to 15 Models: 4+ to hit
* 16 to 20 Models: 3+ to hit</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Upgrade One Model to Redemptor Priest" id="740e-7670-823d-acd0" collective="false" hidden="false" import="true" sortIndex="3" type="upgrade">
          <constraints>
            <constraint id="5f88-2c85-4c8c-2309" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
