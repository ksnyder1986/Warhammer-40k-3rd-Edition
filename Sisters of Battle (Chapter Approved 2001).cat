          <rules>
            <rule name="Sacred Rites" id="efc1-f9c8-c3a4-9a74" hidden="false">
              <description>A Redemptor Priest adds +1 Faith point.</description>
            </rule>
            <rule name="Fearless" id="8b80-eea9-aea8-3809" hidden="false">
              <description>While the Redemptor Priest is alive the squad they lead never has to fall back and is assumed to automatically pass any MOrale checks it is required to make (even against attacks that allow no test to be taken). Note that the unit can be pinned as normal.</description>
            </rule>
          </rules>
        </selectionEntry>
