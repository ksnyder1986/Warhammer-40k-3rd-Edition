      <rules>
        <rule name="Iron-willed" id="ff2b-bf93-17f8-8e90" hidden="false">
          <description>As soon as Lemartes is in close combat he must take a Leadership test. If he passes he has D3+3 Attacks that phase. If he fails he only has D3 attacks that phase.</description>
        </rule>
        <rule name="Rigid Discipline" id="4998-7232-301d-9799" hidden="false">
          <description>Any Blood Angels unit with a model within 6&quot; of Lemartes can re-roll the D6 when testing to restrain themselves at the start of the turn.</description>
        </rule>
      </rules>
      <selectionEntries>
