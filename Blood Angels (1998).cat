    <selectionEntry name="Death Company" id="6c49-6711-a182-f554" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Blood Angel" id="3dca-eb70-3687-10d5" hidden="false" primary="false" targetId="a527-734f-2081-58cd"/>
      </categoryLinks>
