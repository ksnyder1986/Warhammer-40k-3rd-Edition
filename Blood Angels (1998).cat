        <constraint id="bcd4-4216-fc66-e18a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="min" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Death Company" id="8446-b2f2-1785-0ff6" hidden="false" targetId="5fb7-b19b-e19c-0844" type="profile"/>
        <infoLink name="Fearless" id="5dec-5068-a5f3-fc06" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule"/>
        <infoLink name="Deep Strike" id="ec5a-114d-fb25-7ca9" hidden="false" targetId="5715-6219-5059-9bcf" type="rule"/>
        <infoLink name="And They Shall Know No Fear" id="9f5c-d999-0bda-6fbf" hidden="false" targetId="3f9b-513f-8f10-5cc6" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="The Red Thirst" id="b1a1-ed7a-a6ce-4928" hidden="false">
          <description>The only characters that can join the Death Company are Chaplains or Sanguinary High Priests, proving that they do not have an honour guard. A Death Company not led by one of these characters must move towards the nearest enemy unit as fast as possible and must make an assault if possible.</description>
        </rule>
        <rule name="Ignore Injury" id="a948-1898-bd89-aa02" hidden="false">
          <description>If a Death Company Space Marine loses a wound, roll a dice. On a 4+ the injury is ignored and the model continues fighting. This cannot be used against weapons which inflict instant death or against close combat weapons that allow no save.</description>
        </rule>
        <rule name="Deployment" id="f14b-b465-2c23-6c27" hidden="false">
          <description>The Death Company is deployed as Elites in scenarios where this is relevant.</description>
        </rule>
      </rules>
    </selectionEntry>
