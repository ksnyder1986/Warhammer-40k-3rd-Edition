      <rules>
        <rule name="Transfixing Glare" id="2b6b-8522-c2e9-45e8" hidden="false">
          <description>Any model in base contact with Mephiston in close combat must take a Leadership test. If it fails the model counts as having WS 1 for the rest of that round.</description>
        </rule>
        <rule name="Blood Fever" id="b235-bc24-94d2-4497" hidden="false">
          <description>If Mephiston&apos;s close combat opponents break, he must take a normal Leadership test. If he fails then he stops to quench his ravening bloodthirst and cannot move at all.</description>
        </rule>
