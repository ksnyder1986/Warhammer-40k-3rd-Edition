      <infoLinks>
        <infoLink name="Tycho" id="bf71-be9c-5b66-8f0f" hidden="false" targetId="7397-98bf-66be-6525" type="profile"/>
        <infoLink name="Boltgun" id="4a06-091c-e20b-751f" hidden="false" targetId="60bf-18fd-f6e6-6eb4" type="profile"/>
        <infoLink name="Bolt Pistol" id="ca21-6a49-a98e-3e1b" hidden="false" targetId="e9ac-c779-51bb-3c9a" type="profile"/>
        <infoLink name="Meltagun" id="6fa9-902e-7755-17f1" hidden="false" targetId="737d-c7ef-4cb5-e6fa" type="profile"/>
        <infoLink name="Frag Grenades" id="270d-38c2-5452-64d7" hidden="false" targetId="9dd4-e950-2419-5934" type="profile"/>
        <infoLink name="Krak Grenades" id="680a-59ef-787a-24f7" hidden="false" targetId="9c1b-bf93-059b-27f5" type="profile"/>
        <infoLink name="Artificer Armor" id="8dee-a9e1-a94d-1591" hidden="false" targetId="7a02-cc04-9d97-3493" type="rule"/>
        <infoLink name="Bionics" id="3d65-6903-0057-792c" hidden="false" targetId="93ed-72da-0689-8a2d" type="rule"/>
        <infoLink name="Purity Seals" id="2e09-5a92-7a09-af21" hidden="false" targetId="8fca-253c-bbf8-9510" type="rule"/>
        <infoLink name="Independent Character" id="a226-5bc4-40de-8870" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="f974-9355-4ddd-ccb5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Digi-lasers" id="8377-5ff7-17c8-52b0" hidden="false">
          <description>One model in base contact with Tycho, suffers a wound on a D6 roll of 4+ at the start of the round before any close combat attacks are made. Normal saving throws are allowed. In addition, the digi-lasers provides an extra close combat weapon (to 4 A).</description>
        </rule>
        <rule name="Embittered" id="2aa4-79cf-53b9-e7f5" hidden="false">
          <description>Any squad led by Tycho always moves towards the enemy D6&quot;</description>
        </rule>
        <rule name="Hates Orks" id="a0f1-c686-0fb5-18db" hidden="false">
          <description>When fighting against Orks, Tycho and any squad he leads automatically pass any Morale checks they are required to make. In close combat against Orks, Tycho always hits on a 3+.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Retinue" id="5b48-e533-9d83-f2bc" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="309c-5329-72ff-5005" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <entryLinks>
            <entryLink name="Blood Angels Honour Guard" id="b4a4-8675-2b72-cd37" collective="false" hidden="false" import="true" targetId="6d94-fc5b-d9d5-ca26" type="selectionEntry"/>
          </entryLinks>
