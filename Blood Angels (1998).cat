    <selectionEntry name="Brother Captain Tycho" id="5b52-fa19-64e5-2a60" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="HQ" id="c948-47f5-763e-941f" hidden="false" primary="true" targetId="a8a7-7a4b-5f7e-2138"/>
