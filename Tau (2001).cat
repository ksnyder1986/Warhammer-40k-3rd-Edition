    <selectionEntry name="Krootox" id="18de-0b66-0b31-85bd" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="c687-cf74-0e7e-adce" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="02dc-e73d-f9f7-357a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Attached Unit" id="f63a-d2a9-df66-57d0" hidden="false">
          <description>A unit of Krootox must be attacked to a Kroot Carnivore squad before the game. They are deployed along with the Kroot Carnivore squad as if they were all a single Troop choice selection from the Force Organisation chart (but the Krootox still occupies a Fast Attack choice). There cannot be more attached models (including Kroot Hounds) added to a Carnivor squad than Kroot.

Once attached, the Krootox function as part of the Carnivore squad they are attached to. Their Leadership and Armor save will be the same as the unit they are attached to.</description>
        </rule>
        <rule name="Toughness" id="fb74-40ac-1680-943a" hidden="false">
          <description>Krootox only have a Toughness of 3 for determing whether a weapon is capable of inflicting an instant kill, so weapons of Strength 6 or higher are able to kill them outright.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Krootox" id="2b4c-d10c-527b-bdbe" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="Krootox" id="7f47-a6e3-912d-34cb" collective="false" hidden="false" import="true" type="model">
              <constraints>
                <constraint id="3cde-1cbd-900b-aa4b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
                <constraint id="ef72-cdc8-b677-d09b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
