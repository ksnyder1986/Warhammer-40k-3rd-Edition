      </constraints>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="170"/>
      </costs>
      <entryLinks>
        <entryLink name="Crisis Battlesuit Bodyguard Team" id="0bc8-fd42-baf0-a8de" collective="false" hidden="false" import="true" targetId="0a71-e2d2-9661-1972" type="selectionEntryGroup"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Commander Farsight" id="081f-11d0-c2c4-04b1" hidden="false" targetId="a8a6-7b3c-f374-5939" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="Dawn Blade" id="98cd-27ad-cfab-7936" hidden="false">
          <description>Farsight counts as a Monstrous Creature in hand-to-hand combat, so he ignores Armour Saves and rolls 2D6+S for Armour Penetration against vehicles.</description>
        </rule>
        <rule name="Ork Fighter" id="8541-02ce-9b13-e6d7" hidden="false">
          <description>Any Tau unit in an army led by Farsight may improve both their WS and I by 1 at the cost of +5 points per model.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Aun&apos;shi" id="d3e6-c09f-29a2-3804" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="HQ" id="e5da-e4f2-5fd8-38b3" hidden="false" primary="true" targetId="a8a7-7a4b-5f7e-2138"/>
        <categoryLink name="Infantry" id="2620-1126-d3da-1d8b" hidden="false" primary="false" targetId="6953-6bba-0bb9-d49d"/>
      </categoryLinks>
      <constraints>
        <constraint id="b39a-b81d-e4ef-31aa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="105"/>
      </costs>
      <infoLinks>
        <infoLink name="Aun&apos;shi" id="c54e-b090-8d2a-eb70" hidden="false" targetId="36a1-be74-1347-8f58" type="profile"/>
        <infoLink name="Independent Character" id="8717-249f-b019-530b" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule"/>
        <infoLink name="Honour Blade" id="6c8d-a246-da6f-bcd4" hidden="false" targetId="e4b3-561f-f686-b18d" type="rule"/>
        <infoLink name="Invulnerable Saving Throw" id="94cd-c630-8840-aafe" hidden="false" targetId="97b3-810d-a09e-872b" type="rule"/>
        <infoLink name="Photon Grenades" id="906a-28ba-a827-f162" hidden="false" targetId="5c1c-6924-1f3c-f6b7" type="profile"/>
        <infoLink name="EMP Grenades" id="dac4-b445-5168-14d7" hidden="false" targetId="2140-93ef-49c8-1008" type="profile"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="02dc-e73d-f9f7-357a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Hard-wired Shield Generator" id="dfd7-71af-9bca-b3c1" hidden="false">
          <description>4+ Invulnerable Save</description>
        </rule>
        <rule name="Blade Master" id="bd46-1a14-6d8d-0265" hidden="false">
          <description>Aun&apos;shi&apos;s skill with the blade grants the following two abilities:
* He may use none, some, or all of his Attacks to parry. He must declare how many he will use at the start of close combat before any dice are rolled. For each Attack he forfiets, reduce the number of Attacks of each enemy attacking him by one (to a minimum of 1 each).
* As normal his honour blade grants +2 S, and additionally causes an automatic wound with no Armour save possible if he rolls a 6 to hit.</description>
        </rule>
        <rule name="Inspiring Presence" id="553e-efc1-c279-2c50" hidden="false">
          <description>Tau units may re-roll any Moral tests (passed or failed) if Aun&apos;shi is on the table. The re-rolled result stands. Any Tau units joined by Aun&apos;shi is fearless, passing all Morale checks and Pinning tests automatically.
Additionally, any Tau unit joined by Aun&apos;shi gain +1 I and +1 A in close combat while Aun&apos;shi remains with them.</description>
        </rule>
        <rule name="Price of Failure" id="2c5d-8a09-4e64-fc2e" hidden="false">
          <description>If Aun&apos;shi is killed, every friendly Tau unit on the tabletop must take a Morale check at the start of their next turn if not in close combat or already falling back. Any units that fail must Fall Back during thier next Movement phase.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Tiger Shark (IA)" id="3335-09bc-e144-dc02" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Super-Heavy" id="c9f1-dda5-b60c-7b8f" hidden="false" primary="true" targetId="6b90-dc9c-1a49-3fdc"/>
      </categoryLinks>
      <costs>
