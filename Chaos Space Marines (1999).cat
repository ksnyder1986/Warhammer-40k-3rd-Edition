        <selectionEntry name="Nurgle&apos;s Rot" id="0a9a-4ab4-cb26-915b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c5b6-a052-2497-69e9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="02a2-ad6f-5769-cd45" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Nurgle&apos;s Rot" id="2bca-7445-99e4-5190" hidden="false">
              <description>After normal attacks in close combat, roll a D6 for each living model in base contact with the bearer of this gift. On a roll of 6 they contract Nurgle&apos;s Rot and suffer a single wound, with no armour save allowed. Invulnerable saves may be taking as normal. Note this only applies to living foes, not to other Daemons, vehicles, Talos, Avatars or Wraithguard, for example (Necrons?).</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Plague Knife" id="eae9-61c8-d76a-88f1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fdc5-e1d9-3122-c9d9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="02a2-ad6f-5769-cd45" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="b39c-36bc-a368-00af" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Plague Knife" id="fa09-648b-ca3a-adbc" hidden="false">
              <description>A wound from a Plague Knife will kill mortal creatures outright on a D6 roll of 6, regardless of how many wounds they have. Note this only applies to living foes, not to other Daemons, vehicles, Talos, Avatars or Wraithguard, for example (Necrons?).</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Plague Sword" id="e8a7-f973-27ce-95fd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9e97-064e-acb6-5330" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="25"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="02a2-ad6f-5769-cd45" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Plague Sword" id="90f5-09cf-c341-ad35" hidden="false">
              <description>No armour saves are allowed against wounds inflicted by a Plague Sword. In addition, a wound from this weapon will kill mortal creatures outsight on a D6 roll of 4 or more, regardless of how many wounds they have. Note this only applies to living foes, not to other Daemons, vehicles, Talos, Avatars or Wraithguard, for example (Necrons?).</description>
            </rule>
          </rules>
        </selectionEntry>
