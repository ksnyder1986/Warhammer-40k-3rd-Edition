          <rules>
            <rule name="Searchlight" id="0470-8e66-97bd-e7ab" hidden="false">
              <description>Allow one unit spotted by the vehicle to be fired at by any other Chaos Space Marine units that are in range and have line of fire during a Night Fire mission, but allows the vehicle to be seen by all enemy units in their next shooting phase.</description>
            </rule>
          </rules>
