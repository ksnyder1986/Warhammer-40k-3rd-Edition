          <modifiers>
            <modifier field="name" type="set" value="Twin-Linked Heavy Bolter"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Fire Control" id="a0f5-519c-ce6d-8148" hidden="false">
          <description>The vehicle may always fire one additional weapon system to those that would normally be able to be fired giving the speed or status of the vehicle. This shot may even be targetting at a different target than that engaged by the crew. It is conducted with a BS 2.</description>
        </rule>
        <rule name="Infernal Device" id="23d2-e9e7-ba8a-14f2" hidden="false">
          <description>If the crew are stunned then the vehicle may still be moved directly ahead in a straight line up to its maximum move.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Abaddon the Despoiler" id="8e2e-a5ec-2a2f-ea33" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Cult of Chaos Undivided" id="c86a-4d32-11c9-5cd0" hidden="false" primary="false" targetId="fc86-93de-0aac-8e42"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="240"/>
      </costs>
      <infoLinks>
        <infoLink name="Abaddon" id="b76b-ea85-2d98-f052" hidden="false" targetId="8609-2166-e40a-7485" type="profile"/>
        <infoLink name="Terminator Armor" id="efcf-7313-b551-d9af" hidden="false" targetId="7988-95d2-59f5-7715" type="rule"/>
        <infoLink name="Storm Bolter" id="ebe8-c27a-dcf9-83cc" hidden="false" targetId="4c6c-9de1-00a8-8016" type="profile"/>
        <infoLink name="Lightning Claw" id="2d39-1dc2-e208-d77f" hidden="false" targetId="c7a3-7006-5226-8181" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="Chaos Undivided" id="ab6f-b50e-cc92-6be8" hidden="false">
          <description>Models bearing this mark may re-roll failed Morale checks</description>
        </rule>
        <rule name="Talon of Horus" id="98c4-0e1c-1341-aafb" hidden="false">
          <description>All Imperial units with a model within 6&quot; of Abaddon must subtract -1 from their Leadership. The only exception to this are Blood Angel Space Marines, who instead add +1 to their Leadership if they are within 6&quot; of it.</description>
        </rule>
        <rule name="Daemon Sword Drach&apos;nyen" id="685b-51ee-132b-2284" hidden="false">
          <description>Abaddon can make one attack with Drach&apos;nyen in addition to his normal three attacks with the Talon of Horus. The sword may not make more than one attack per turn and no attack bonuses can increase this. Any hit inflicted wounds automatically with no armour saving throw allowed. Vehicle struck by the blade are penetrated automatically. Any model wounded by the sword is slain outright no matter how many wounds it has.</description>
        </rule>
      </rules>
