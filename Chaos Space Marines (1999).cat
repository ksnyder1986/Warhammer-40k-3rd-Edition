                <condition childId="3cb1-645b-8bbb-3d49" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Talisman of Tzeentch" id="4272-0b09-6821-e2d2" hidden="false">
              <description>If an army includes a model with this talisman, opposing psykers suffer a -1 modifier to their Leadership for Psychic tests. If both sides have this gift, they cancel each other out.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Minor Psychic Power" id="cb81-f69a-a1b1-4086" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <infoLinks>
            <infoLink name="Minor Psychic Power" id="7fc0-1a68-9f0d-ea55" hidden="false" targetId="69af-f095-551d-130c" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="3cb1-645b-8bbb-3d49" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Daemon Prince Gifts" id="cfc5-f548-60d1-de97" collapsible="true" collective="false" hidden="false" import="true" publicationId="26e5-ce39-9a6e-4817">
      <constraints>
        <constraint id="813f-1411-d99d-705f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Daemonic Armour" id="ec12-fda6-f8b3-b052" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c020-69ae-6bb5-9024" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="25"/>
          </costs>
          <rules>
            <rule name="Daemonic Armour" id="5eff-5a20-a610-d41c" hidden="false">
              <description>The Daemon Prince gains a 3+ saving throw.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Daemon Weapon" id="c502-89b7-861f-4717" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f5f7-70df-993d-60a6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="30"/>
          </costs>
          <rules>
            <rule name="Daemon Weapon" id="75b4-7b49-f3b0-1388" hidden="false">
              <description>A Daemon Prince with this weapon gainst a +2 bonus to its Strength.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Eye of Tzeentch" id="36c1-f766-88af-d6b0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0c1b-5971-ea40-c622" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="25"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="f475-8c01-144f-84d5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Eye of Tzeentch" id="5b83-98b8-2903-9bcf" hidden="false">
              <description>The Daemon prince may re-roll any one of its shooting or close combat attacks in each shooting and assault phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Staff of Tzeentch" id="d149-821a-eb82-ad82" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5fa1-3937-77c9-7969" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="f475-8c01-144f-84d5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Staff of Tzeentch" id="bc7e-579e-854b-4025" hidden="false">
              <description>The Daemon Prince may move and use the Flames of Tzeentch psychic power. Instead of firing during the Movement phase, the attack is resolved in the Shooting phase as an Assault 1 weapon.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Lashing Tongue" id="a4de-fd12-fb42-9885" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5933-2ddb-3527-4aea" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="9959-dad5-6a75-753e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Lashing Tongue" id="ae6e-7d1f-7d13-1f32" hidden="false">
              <description>The Daemon Prince may deduct one Attack, to a minimum of 1, from any model in base contain with him during the Assault phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Nurgling Infestation" id="3fe1-2fe1-b447-5cb7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="329e-c26e-a0f0-30ed" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="02a2-ad6f-5769-cd45" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Nurgling Infestation" id="7aa9-30fc-0613-6ada" hidden="false">
              <description>The Nurgling grant the Daemon Prince an extra D6 Strength 3 attacks as they swarm forward to attack the enemy. These bonus attacks do not ignore armour saving throws and as results with an initiative of 3.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Poison-Barbed Tail" id="3233-847c-5dc4-f0d2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1b23-b27a-2b1b-fb39" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <rules>
            <rule name="Poison-Barbed Tail" id="e98a-841d-5a5e-6e28" hidden="false">
              <description>The Daemon Prince receives an extra attack in close combat, this extra attack does not ignore saving throws, but any wound caused will instantly kill its victim regardless of how many wounds the target originally had.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Rage of Khorne" id="8227-23b2-be86-8509" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="de92-5877-0e69-ba9a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="f2ef-463f-2bef-7912" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Rage of Khorne" id="4cfa-7810-af45-19bf" hidden="false">
              <description>The Daemon Prince receives D3 extra attacks when it charges instead of the normal 1. However, it must always move closer to the enemy in each Movement phase and it must always perform a sweeping advance after winning a close combat.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Rune of Chaos" id="36d2-6aa1-dfdb-6132" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="15e2-f0a3-0771-dc43" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="25"/>
          </costs>
          <rules>
            <rule name="Rune of Chaos" id="f6d5-91dc-619f-8178" hidden="false">
              <description>The Daemon Prince may ignore the instant death rule from attacks whose Strength is double is Toughness.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Terrifying Appearance" id="d616-e3ad-0b76-b368" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="42d5-3dbe-f48e-2224" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="30"/>
          </costs>
          <rules>
            <rule name="Terrifying Appearance" id="5dd6-7279-0295-015a" hidden="false">
              <description>A unit wishing to assault a Daemon Prince with a terrifying appearance must first pass a Leadership test in order to do so. If they fail, the unit may freely assault any other target in range. In addition, any unit that loses combat involving the Daemon Prince will automaticlaly fall back. Fearless units ignore these rules.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Wings" id="a54d-7426-62aa-e963" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0767-e547-10bd-6188" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="f9f2-3e04-500e-863d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Wings" id="6d3a-99a0-f2bd-33e1" hidden="false">
              <description>The Daemon Prince makes a 12&quot; move just as if he were wearing a jump pack, ignoring any intervening terrain between it and the target.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Daemon Prince Armoury" id="f9da-48b0-7301-fb4c" collapsible="true" collective="false" hidden="false" import="true">
