            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="f2ef-463f-2bef-7912" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Axe of Khorne" id="25d7-ffc5-722a-fef2" hidden="false">
              <description>Hits with the Ace of Khorne ignore armour saves. In addition, any to hit rolls of 6 allow the model to make an additional attack in close combat.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Collar of Khorne" id="ec6f-75fc-29eb-8234" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4fd2-270c-c2e7-08ec" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
