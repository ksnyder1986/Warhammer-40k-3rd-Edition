          </modifiers>
          <rules>
            <rule name="Smoke Launchers" id="080f-5cd8-eecd-ef45" hidden="false">
              <description>One per game, after moving, the vehicle can trigger the smoke launchers. The vehicle may not fire in the same turn as it used its smoke launchers. Any penetrating hits scored by the enemy in the next shooting phase count as glancing hits instead.</description>
            </rule>
          </rules>
