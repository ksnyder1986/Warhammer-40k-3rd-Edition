  <sharedInfoGroups>
    <infoGroup name="Salamander Special Rules" id="3565-50ac-4ca8-3c68" hidden="false">
      <rules>
        <rule name="Never Give Up" id="2de9-0306-c8ce-c773" hidden="false">
          <description>At the end of a game, the Salamanders player can decide to continue fighting for one more turn. Another whole game turn is played as normal (ie, each player gets one more turn) and the result of the battle is decided after that turn is finished.</description>
        </rule>
        <rule name="Self-Reliant" id="f860-605a-119c-a8d3" hidden="false">
          <description>Salamander models never have to take &apos;All On Your Own&apos; Morale checks.</description>
        </rule>
        <rule name="Sturdy" id="7270-38a6-ca77-3c1f" hidden="false">
          <description>All Salamanders, with the exception of Dreadnoughts, have their Initiative reduced by 1 point. They must also deduct 1&quot; from any advance or fall back moves they make.</description>
        </rule>
      </rules>
    </infoGroup>
  </sharedInfoGroups>
