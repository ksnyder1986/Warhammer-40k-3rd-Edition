  <sharedRules>
    <rule name="Energy Shield" id="37f7-73b9-c18f-f345" hidden="false">
      <description>Ignore one glancing or penetrating hit. The Energy Shield is reactivated on a D6 roll of 6 at the start of a future turn.</description>
    </rule>
    <rule name="Agile" id="f6f1-a0e7-50ca-8d97" hidden="false">
      <description>Agile vehicles can move up to 6&quot; and fire all weapons, or up to 12&quot; and fire one. They may not move more than 12&quot;.</description>
    </rule>
    <rule name="Lumbering" id="0fa4-8082-7ee6-db44" hidden="false">
      <description>Lumbering vehicles can move up to 6&quot; directly forward. At the end of the move they may pivot up to 90 degrees. Lumbering vehicles can fire all their weapons even when moving.</description>
    </rule>
    <rule name="War Machine Melee" id="bd5e-d812-9c26-01ee" hidden="false">
      <description>Ignores armour saves, rolls 2D6 for armour penetration, glancing and penetrating hits do D3 damage to structure points in addition to the results on War Machine Damage table; and may only be used against enemy vehicles, war machines, Monstrous models and buildings.</description>
    </rule>
    <rule name="AA Mount" id="4c41-fa17-488f-804c" hidden="false">
      <description>May shoot at flyers using the model&apos;s BS.</description>
    </rule>
    <rule name="Gatling" id="540a-4382-b94f-9fe0" hidden="false">
      <description>Use 3 templates placed next to each other with the long sides touching and the thinnest point placed at the weapon.</description>
    </rule>
  </sharedRules>
