    <selectionEntry name="Wraiths" id="9605-3b01-4680-5ca1" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Fast Attack" id="8b42-ab99-86aa-bcd2" hidden="false" primary="true" targetId="34e2-d53c-28ab-44cf"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Phase Out" id="cc9a-472d-1f5c-b1a3" hidden="false" targetId="d2b0-ba08-4fb1-d9f3" type="rule"/>
        <infoLink name="We&apos;ll Be Back!" id="e909-d1d4-2155-0516" hidden="false" targetId="e957-8c69-1203-279c" type="rule"/>
        <infoLink name="Close Combat Weapon" id="43c0-f09a-eb28-c8e4" hidden="false" targetId="46d5-85f2-d932-f0a2" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="Phase Shift" id="6e17-91e9-e720-9012" hidden="false">
          <description>Wraiths have a 3+ invulnerable save. When attacking models in or behind cover, Wraiths count as having frag grenades so will strike simultaneously.</description>
        </rule>
        <rule name="Wraithflight" id="d471-4acf-b35d-a272" hidden="false">
          <description>Wraiths move in the same manner as jetbikes but they regard no terrain as impassable and never have to take Difficult Terrain tests. Wraiths cannot end their move &quot;inside&quot; objects to avoid being shot at. They cannot move through enemy models or vehicles either.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Wraith" id="0b55-572d-2bf2-1528" collective="false" hidden="false" import="true" type="model">
          <categoryLinks>
            <categoryLink name="Necron" id="8fb0-412e-087a-5b1f" primary="false" targetId="6063-3ad9-f657-70bf"/>
          </categoryLinks>
          <constraints>
            <constraint id="9bd0-0ca9-3bec-4655" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
            <constraint id="f435-daa6-759c-dfae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="41"/>
          </costs>
          <infoLinks>
            <infoLink name="Wraith" id="6d29-417e-1050-1984" hidden="false" targetId="12bf-eaa6-5a59-7235" type="profile"/>
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Destroyers" id="410f-93e6-a768-471f" collective="false" hidden="false" import="true" page="19" publicationId="263c-b15e-84a3-a711" type="unit">
