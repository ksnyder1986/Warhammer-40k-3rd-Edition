      </infoLinks>
      <rules>
        <rule name="Souless" id="cce2-a46f-55e9-d9dd" hidden="false">
          <description>Any enemy unit with a model within 12&quot; of a Pariah counts as having Leadership 7, unless it would normally be less than that.</description>
        </rule>
        <rule name="Psychic Abomination" id="4939-faa3-a772-62eb" hidden="false">
          <description>Any psyker within 6&quot; of a Pariah at the start of their turn must take a Morale check or fall back along with any squad they are leading. If the psyker is in close combat at the time and fails the Morale check, he will not fall back but will only hit on a 6 in the Assault phase for that turn.</description>
        </rule>
      </rules>
