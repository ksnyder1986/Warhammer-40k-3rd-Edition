        <infoLink name="We&apos;ll Be Back!" id="6c1c-cdb7-e4d6-20f5" hidden="false" targetId="e957-8c69-1203-279c" type="rule"/>
        <infoLink name="Jetbikes" id="f592-90eb-9c6e-3734" hidden="false" targetId="4556-3c66-6ed4-87a0" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Destroyers" id="934a-76fb-8bac-7103" hidden="false" page="19" publicationId="263c-b15e-84a3-a711">
          <description>Destroyers may move and fire thieir gauss cannons.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Destroyer" id="8b66-1dc8-0223-646c" collective="false" hidden="false" import="true" type="model">
          <categoryLinks>
            <categoryLink name="Necron" id="c62a-83d7-342f-9b6a" primary="false" targetId="6063-3ad9-f657-70bf"/>
          </categoryLinks>
          <constraints>
            <constraint id="75ac-0899-0cac-cacf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="5"/>
            <constraint id="f578-09b0-84de-b195" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="3"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="50"/>
