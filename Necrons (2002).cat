          </infoLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Scarab Swarms" id="d450-12e3-bb56-1724" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Fast Attack" id="6a13-0ac0-1b3d-44cf" hidden="false" primary="true" targetId="34e2-d53c-28ab-44cf"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Fearless" id="401a-a9d0-ef96-6675" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule"/>
        <infoLink name="Deep Strike" id="29f2-3b1b-3c9e-efc4" hidden="false" targetId="5715-6219-5059-9bcf" type="rule"/>
        <infoLink name="Jetbikes" id="bae3-7952-bd71-955e" hidden="false" targetId="4556-3c66-6ed4-87a0" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Swarms" id="0815-f6b7-716f-f502" hidden="false">
          <description>Scarab Swarms move and fight in the same manner as jetbikes, but don&apos;t get the +1 Toughness bonus and may move through difficult terrain with no need to take a Difficult Terrain test. For the purpose of mission objectives, Scarabs can&apos;t capture table quarters, hold objectives, or count as surviving troops in a Meat Grinder battle.</description>
        </rule>
        <rule name="Vulnerable to Blasts" id="779d-5b7e-fd51-46ff" hidden="false">
          <description>Template, Ordnance and Blast marker weapons inflict two wounds instead of one on Scarab swarms. A weapon of Strength 6 or higher will, of course, instantly kill a swarm as normal.</description>
        </rule>
        <rule name="Small Target" id="e70a-7402-90f5-9fae" hidden="false">
          <description>Being extremely hard to hit in cover, the swarm&apos;s cover save is at a +1. Note that this doesn&apos;t give them a cover save if they wouldn&apos;t normally get one.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Scarab Swarm" id="7f23-0035-68df-1e55" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="8278-28e4-da9c-a9dd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="10"/>
            <constraint id="f1dc-b6ef-ac85-b0fd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="3"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="12"/>
          </costs>
          <infoLinks>
            <infoLink name="Scarab Swarm" id="9fc4-e86f-3c85-68b1" hidden="false" targetId="8dd7-2cb0-5c7b-221b" type="profile"/>
          </infoLinks>
        </selectionEntry>
        <selectionEntry name="Disruption Fields" id="dbd4-1244-c728-1393" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f33f-4b9a-1a94-2c23" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
          </costs>
          <modifiers>
            <modifier field="4ed5-2f92-9abc-2870" type="increment" value="4">
              <repeats>
                <repeat childId="7f23-0035-68df-1e55" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
              </repeats>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Disruption Field" id="1372-db27-cbea-a7b0" hidden="false">
              <description>Disruption Fields are used in assaults against vehicles. Any hit inflicted on a target by a unit equipped with disruption fields will score a glancing hit on a D6 roll of 6 regardless of the vehicles Armor value in exactly the same manner as gauss weapons.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Tomb Spyders" id="0164-f47e-2789-9154" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="90fe-224b-ba35-5368" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <rules>
        <rule name="Tomb Spyders" id="5289-117d-d3d6-efa7" hidden="false">
          <description>You may include 1-3 Tomb Spyders as a single Heavy Support choice, but Tomb Spyders are deployed as a single unit but do not have to be placed together and operate as independent units during the game.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Tomb Spyder" id="6c61-378b-e6c1-13dd" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="fe7a-1a6e-ad7a-43eb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
            <constraint id="f693-8c31-813e-9ba9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="55"/>
          </costs>
          <infoLinks>
            <infoLink name="Monstorous Creature" id="58a2-aabc-da02-de4c" hidden="false" targetId="445e-e873-2a3f-776f" type="rule"/>
            <infoLink name="Fearless" id="1d4d-427c-b715-8e9b" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule"/>
            <infoLink name="Tomb Spyder" id="3f50-b136-89ce-34d9" hidden="false" targetId="f746-4c0b-3966-cd99" type="profile"/>
          </infoLinks>
          <rules>
            <rule name="Hover" id="ad9d-0017-5908-d99a" hidden="false">
              <description>Tomb Spyders move by gravitic propulsion but far more ponderously than airborne Necrons like Destroyers. They move and assault in the same manner as models on foot, even though they hover low above the ground.</description>
            </rule>
            <rule name="Artificier" id="e3fb-750e-878d-14c4" hidden="false">
              <description>Each Necron turn, at the start of the Assault phase, a Tomb Spyder that is not in close combat can expend energy to create a Scarab Swarm, The swarm is placed in contact with the Spuder at the start of the Assault phase. Roll D6 for each swarm produced. On a 1, the Spyder takes a wound. Each swarm produced will form a unit with the Tomb Spyder that created it and must retain coherency with it for the remainder of the game. Swarms produced this way are not worth any victory points and are removed if the Tomb Sypder is destroyed.</description>
            </rule>
            <rule name="Necron Repair" id="a83f-3790-e563-b412" hidden="false">
              <description>A Necron model may still self-repair if they would not normally be able due to distance to a similar model if they are within 12&quot; of a Tomb Spyder and a unit they would be able to join is anywhere on the table. If the Necron repairs it will immediately join that model&apos;s unit.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Particle Projector" id="e532-e868-af02-96f3" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="de0e-c684-cb91-c1f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Staff of Light" id="73b3-219b-9447-0f1a" hidden="false" targetId="f0e1-c7e2-18e3-5e45" type="profile">
                  <modifiers>
                    <modifier field="name" type="set" value="Particle Projector"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <rules>
                <rule name="Particle Projector" id="5582-11f1-7f58-cc89" hidden="false">
                  <description>Reduce the Spyder&apos;s number of Attacks by one.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Heavy Destroyers" id="ada5-503a-1327-f244" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="7553-57d6-d4c2-8f95" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
