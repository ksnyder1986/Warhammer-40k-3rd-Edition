        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="eca8-ace3-d503-7923" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Living Metal" id="e53e-89e3-d356-011f" hidden="false">
          <description>Attacks which count the target&apos;s Armor Value as being less than it really is do not do so against the Monolith. Similarly, weapons that get additional Armor Penetration dice do not get the extra dice against the Monolith. Ordnance weapons still roll 2D6 and select the highest.</description>
        </rule>
      </rules>
    </selectionEntry>
