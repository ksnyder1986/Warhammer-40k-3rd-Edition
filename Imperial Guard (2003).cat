      </costs>
      <infoLinks>
        <infoLink name="Colonel-Commissar Ibram Gaunt" id="8297-176b-f0e3-320a" hidden="false" targetId="57c4-4a09-82ce-4286" type="profile"/>
        <infoLink name="Krak Grenades" id="d7dd-35cf-2820-b320" hidden="false" targetId="9c1b-bf93-059b-27f5" type="profile"/>
