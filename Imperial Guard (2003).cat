                    <condition childId="8be0-47e5-6a5a-a2bf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Ejector Seats" id="e8c7-d3bd-6264-d031" hidden="false">
              <description>If the aircraft is destroyed roll a D6. On a 1-3 nothing happens. On a 4+ the crewman successfully ejects. Roll a Scatter Dice and 4D6&quot; for the direction and distance from the aircraft the crewman lands. Each crewman counts a single Guardsman with a laspistol. They are considered to be below half strength for the purposes of moral checks, claiming table quarters, etc. If any crew survice the aircraft will only count as damaged for the purposes of Victory Points at the end of the game.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Flare/Chaff Launcher" id="411f-3144-a505-a2db" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2135-7f38-bdb6-e569" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
          <rules>
            <rule name="Flare/Chaff Launcher" id="8230-9646-df9d-bd10" hidden="false">
              <description>One use only. If the vehicle takes the Immobilised damage result then re-roll the result.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Armoured Cockpit" id="df2d-0504-d6bb-d7a2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3345-2242-54e3-0bf2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <rules>
            <rule name="Armoured Cockpit" id="7c14-6fd3-4060-bb6a" hidden="false">
              <description>If the aircraft takes the Crew Shaken, Crew Stunned, or Pilot Shaken result, then roll a D6. On a 4+ the result is ignored.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Infrared Targeting" id="0e5c-833d-fb5d-a72f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="00ba-d287-d063-8d08" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <rules>
            <rule name="Infrared Targeting" id="31f0-cfe3-df22-f17f" hidden="false">
              <description>The aircraft can re-roll the dice for the distance it can engage enemiers during a Night Fighting mission.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Illum Flare" id="ce35-8dfd-f475-f9ad" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7765-4442-3011-9e32" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="3"/>
          </costs>
          <rules>
            <rule name="Illum Flare" id="295a-b926-834c-8f28" hidden="false">
              <description>This flare is used in missions where the Night Fighting rules are in effect. They allow one enemy unit spotted by the aircraft to be fired at in the next turn by any other ground forces in range and that have line of sight.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Nose Art" id="46a6-3673-2835-876d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c634-12cc-d442-9e9b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <rules>
            <rule name="Nose Art" id="366f-10d4-6d8c-b9d2" hidden="false">
              <description>In the player&apos;s own turn, after the aircraft has attacked in the opponent&apos;s turn, the first unit to fail a Moral test may re-roll the test.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
