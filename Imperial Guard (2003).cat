    <profile name="Stormsword" id="eaad-f8f6-b10d-a8cf" hidden="false" typeId="36b6-ef06-48e4-cd45" typeName="Super Heavy Vehicle">
      <characteristics>
        <characteristic name="Front Armor" typeId="85f4-de3e-abeb-67f7">14</characteristic>
