        <infoLink name="Telepathic Order" id="916b-7a1b-8634-2ed1" hidden="false" targetId="be70-60f1-070f-c7ba" type="rule"/>
        <infoLink name="Psychic Ward" id="93ae-d867-1027-1248" hidden="false" targetId="8967-38e7-893a-8596" type="rule"/>
        <infoLink name="Psychic Lash" id="42e2-dd15-1b98-a1d7" hidden="false" targetId="1da3-c105-b700-5fc8" type="rule"/>
        <infoLink name="Machine Curse" id="2b80-86e5-421f-c0af" hidden="false" targetId="d2dd-9386-2ebe-dc40" type="rule"/>
        <infoLink name="Lightning Arc" id="7c3d-d9d0-f141-fdb1" hidden="false" targetId="76cc-a507-93d1-7ec5" type="profile"/>
      </infoLinks>
      <modifiers>
        <modifier field="680d-2adb-2b02-d928" type="set" value="0">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="b855-cc69-a67d-4db7" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="notEqualTo" value="1"/>
                <condition childId="ede9-f40a-bbd5-8441" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="notEqualTo" value="1"/>
                <condition childId="0b14-5bb1-1764-fc12" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="notEqualTo" value="1"/>
                <condition childId="ed5d-b825-1375-7554" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="notEqualTo" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Sanctioned Psyker Powers" id="c709-7864-7109-6457" hidden="false">
          <description>The psyker has one Psychic ability, selected at random by rolling a dice and consulting the table below:
1 - No usable power
2 - Telepathic Order
3 - Psychic Ward
4 - Psychic Lash
5 - Machine Curse
6 - Lightning Arc</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Commissars" id="f4c2-1a41-63e6-f5db" collective="false" hidden="false" import="true" type="model">
      <categoryLinks>
        <categoryLink name="Officer" id="f53c-b142-f8b8-d4b2" hidden="false" primary="false" targetId="3670-6ad0-8988-c35b"/>
