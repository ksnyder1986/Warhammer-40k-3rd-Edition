    <entryLink name="Librarian" id="d80a-494d-a84b-a915" collective="false" hidden="false" import="true" targetId="5338-cafe-fa14-f5d7" type="selectionEntry">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="d726-094e-45d1-5097" hidden="false" primary="true" targetId="a8a7-7a4b-5f7e-2138"/>
