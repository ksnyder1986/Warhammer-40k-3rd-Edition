          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <rules>
            <rule name="Spirit Stone" id="69c7-f5a5-853a-87b9" hidden="false">
              <description>If the vehicle suffers a &apos;crew shaken&apos; result, roll a D6. On a 4+ the vehicle is instead un affected. If the vehicle suffers a &apos;crew stunned&apos; result, roll a D6. On a 4 or 5 treat the result as a &apos;crew shaken&apos; result instead, and on a 6 the result is ignored.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Star Engines" id="4777-1d41-f54b-d370" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3f3c-0890-655f-ffbc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
          <rules>
            <rule name="Star Engines" id="8a45-e3f3-f12a-c1cd" hidden="false">
              <description>Instead of firing any weapons the vehicle may move 2D6&quot; in a straight line during the shooting phase. A vehicle may not use its star engines in the same turn that it embarks or disembarks units.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Vectored Engines" id="dfc1-ebc7-51ee-348d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
