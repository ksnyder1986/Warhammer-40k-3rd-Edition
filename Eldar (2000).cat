            </modifier>
          </modifiers>
          <rules>
            <rule name="Holo-field" id="f987-2a20-f54e-5a6e" hidden="false">
              <description>When rolling on the Damage table against this vehicle, the enemy must roll two dice and apply the lowest result.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Scythes" id="dbb1-3d00-fcfb-e293" collective="false" hidden="false" import="true" type="upgrade">
