      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Storm Troopers" id="be5f-3517-982d-bc1e" collective="false" defaultSelectionEntryId="584f-34cb-ab6f-bdc3" hidden="false" import="true">
          <constraints>
            <constraint id="b5c7-93e7-da3c-f8e8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="5"/>
            <constraint id="1fe0-5e68-02bb-c85a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="10"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Storm Trooper" id="584f-34cb-ab6f-bdc3" collective="false" hidden="false" import="true" type="model">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Frag Grenades" id="3f06-cd77-e54b-ee59" hidden="false" targetId="9dd4-e950-2419-5934" type="profile"/>
                <infoLink name="Hellgun" id="1153-0220-4b67-b862" hidden="false" targetId="efe9-35a9-ba8f-99a9" type="profile"/>
                <infoLink name="Targeter" id="7e11-8e18-b871-1ca9" hidden="false" targetId="e9b2-e53b-2414-1a22" type="rule"/>
                <infoLink name="Storm Trooper" id="0c5e-916b-0749-a744" hidden="false" targetId="b29d-f044-3296-03b8" type="profile"/>
              </infoLinks>
            </selectionEntry>
