          </costs>
          <rules>
            <rule name="AA" id="eece-cf91-a334-3bf2" hidden="false">
              <description>The Lascannon may fire at aircraft using its normal BS</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
