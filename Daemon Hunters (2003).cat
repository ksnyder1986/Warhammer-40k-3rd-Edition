    <selectionEntryGroup name="Space Marine Vehicle Upgrades" id="28e7-a207-4e89-bcb5" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Dozer Blade" id="28f0-8f6a-8958-03b8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="40e6-3d89-ea67-d31d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="6852-d18d-8c5c-5c96" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Dozer Blade" id="8678-bebd-36b3-bc24" hidden="false">
              <description>Re-roll failed Difficult Terrain tests as long as the model did not move more than 6&quot; that turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Extra Armor" id="ed29-cfc4-3d99-48c0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7501-945a-01d0-a4d2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
          <rules>
            <rule name="Extra Armour" id="7558-6c22-6084-a0a4" hidden="false">
              <description>Treat &apos;Crew Stunned&apos; results as &apos;Crew Shaken&apos; instead.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Hunter-killer Missile" id="2411-b66f-db92-87eb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bdbf-cb8c-c699-fe0f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
          <infoLinks>
            <infoLink name="Hunter-killer Missile" id="acd2-e718-2960-68bc" hidden="false" targetId="86d5-c5a0-fc04-7f5a" type="profile"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="6852-d18d-8c5c-5c96" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry name="Pintle-mounted Storm Bolter" id="7fb1-5a3d-a72f-f887" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="aa77-45aa-b16a-3f3e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <infoLinks>
            <infoLink name="Storm Bolter" id="4ebd-d5c0-ae10-f8c9" hidden="false" targetId="4c6c-9de1-00a8-8016" type="profile"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="6852-d18d-8c5c-5c96" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry name="Searchlight" id="b6f6-28c6-5db5-e459" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="823a-0298-0857-b476" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="1"/>
          </costs>
          <rules>
            <rule name="Searchlight" id="95c8-4283-f9e7-5b84" hidden="false">
              <description>During battles using Night Fight rules, one enemy unit spotted by the vehicle may be fired at by all other friendly units within range and that have line of sight, but by doing so the vehicle may be fired at by all enemy units in the next turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Smoke Launchers" id="b102-3dec-f417-2464" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a120-ccbd-160c-43ce" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="3"/>
          </costs>
          <rules>
            <rule name="Smoke Launchers" id="61b9-d88d-76eb-8f68" hidden="false">
              <description>Once per game, after completing its move, a vehicle with Smoke Launchers may trigger them. The vehicle may not fire this turn, but any penetrating hits scored by the enemy in the next shooting phase are instead turned into glancing hits.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Navy Vehicle Upgrades" id="61f9-f5a5-de01-6e89" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Ejector Seats" id="7223-41ce-b109-405f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f3e3-1fe6-7286-c676" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <rules>
            <rule name="Ejector Seats" id="b51f-fae3-28da-b335" hidden="false">
              <description>If the aircraft is destroyed roll a D6. On a 1-3 nothing happens. On a 4+ the crewman successfully ejects. Roll a Scatter Dice and 4D6&quot; for the direction and distance from the aircraft the crewman lands. Each crewman counts a single Guardsman with a laspistol. They are considered to be below half strength for the purposes of moral checks, claiming table quarters, etc. If any crew survice the aircraft will only count as damaged for the purposes of Victory Points at the end of the game.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Flare/Chaff Launcher" id="b102-8704-62ee-0590" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0e3f-85e8-bef4-405c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
          <rules>
            <rule name="Flare/Chaff Launcher" id="3491-e046-3b5b-f2a4" hidden="false">
              <description>One use only. If the vehicle takes the Immobilised damage result then re-roll the result.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Armoured Cockpit" id="3ccf-57f1-8189-4e99" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1b8e-94d2-d6d3-6e0e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <rules>
            <rule name="Armoured Cockpit" id="4850-ef62-40b7-3fa5" hidden="false">
              <description>If the aircraft takes the Crew Shaken, Crew Stunned, or Pilot Shaken result, then roll a D6. On a 4+ the result is ignored.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Infrared Targeting" id="069b-ded7-760e-9b43" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0502-b3f8-c05f-9021" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <rules>
            <rule name="Infrared Targeting" id="68dc-1a46-82b9-aa89" hidden="false">
              <description>The aircraft can re-roll the dice for the distance it can engage enemiers during a Night Fighting mission.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Illum Flare" id="4324-8c35-91c2-d609" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="305d-01f1-b5fa-7528" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="3"/>
          </costs>
          <rules>
            <rule name="Illum Flare" id="96b6-2f12-2db8-4271" hidden="false">
              <description>This flare is used in missions where the Night Fighting rules are in effect. They allow one enemy unit spotted by the aircraft to be fired at in the next turn by any other ground forces in range and that have line of sight.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Nose Art" id="768a-3083-ab69-57d4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7153-37ca-c54f-5f51" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <rules>
            <rule name="Nose Art" id="33d4-604c-8bd1-3831" hidden="false">
              <description>In the player&apos;s own turn, after the aircraft has attacked in the opponent&apos;s turn, the first unit to fail a Moral test may re-roll the test.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
