    <selectionEntry name="Orbital Strike" id="c1a4-d583-521f-064b" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="5786-bc0c-be2a-7302" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
      </categoryLinks>
      <constraints>
        <constraint id="bc5d-c516-7646-b659" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <rules>
        <rule name="Inaccuracy" id="15d1-149e-dce2-5c6f" hidden="false">
          <description>An Orbital Strike scatters just like ordinary ordnance weapons, except when a miss is rolled the distance scatterd is double the number scored on the D6. If a hit is rolled, the template deviates by the distance shown on the Hit Symbol.</description>
        </rule>
        <rule name="Pinning" id="79a0-1024-6410-e398" hidden="false">
          <description>All Orbital Strikes cause Pinning tests</description>
        </rule>
        <rule name="Placement" id="53ce-1374-fb3a-e28e" hidden="false">
          <description>The Ordnance Blast marker for the strike must be placed anywhere within the specified terrain piece</description>
        </rule>
        <rule name="Plotting" id="d863-9865-e6a2-8555" hidden="false">
          <description>The Orbital Strike must be keyed to a specific piece of terrain at the start of the battle. Make a note of the plotted target before forces are deployed but after deployment zones have been determined</description>
        </rule>
        <rule name="Timing" id="84a4-8695-b292-f477" hidden="false">
          <description>An orbital strike uses the Reserve special rule to determine when it strikes. Once the orbital strike passes the Reserve roll it fires each Space Marine shooting phases for the rest of the game. It cannot be stopped once started. The Space Marine player can opt to not roll for the onset of the orbital strike if they wish.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Orbital Strike Type" id="3ae2-0f8e-326e-4cf3" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="4083-9d3d-953c-8ea8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="8ab1-0413-e789-717f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
