  <sharedRules>
    <rule name="City Fighters" id="0aa2-ad12-6696-1869" hidden="false">
      <description>If this unit is in cover then its cover saving throw is increased by +1 point.</description>
    </rule>
    <rule name="Tank Hunters" id="152e-3207-7d66-4964" hidden="false">
      <description>The unit always passes any tests for tank shock and adds +1 to all Armour Penetration rolls.</description>
    </rule>
    <rule name="Citizens" id="28fc-a0b2-82ae-14c6" hidden="false">
      <description>You may reroll any reserve rolls for this unit.</description>
    </rule>
    <rule name="Sewer Rats" id="8fd7-c2ff-1577-b5d0" hidden="false">
      <description>The unit can use the special rules for Subterranean Movement to deploy, even in scenarios where these rules are not normally used.</description>
    </rule>
    <rule name="Stealthy" id="d99b-425a-ce2d-e136" hidden="false">
      <description>This unit may set up using the infiltrator rules. If infiltrators are not allowed in the scenario being played then the unit may make a free move immediately after both sides have deployed.</description>
    </rule>
    <rule name="Cunning" id="48e9-280b-8702-e4d7" hidden="false">
      <description>This unit may set up one booby-trap of your choice each game using the rules in the Cityfight book.</description>
    </rule>
    <rule name="Cityfight Veterans" id="a39a-0e41-19fe-c0e8" hidden="false">
      <description>Cityfight Veterans may always roll one extra dice for their difficult terrain tests in the city.
Cityfight Veterans who do not move during the movement phase reduce their target&apos;s cover save by -1 in addition to any other modifiers.</description>
    </rule>
  </sharedRules>
