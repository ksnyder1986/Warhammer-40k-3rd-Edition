          <modifiers>
            <modifier field="name" type="set" value="Co-axial Autocannon"/>
          </modifiers>
        </infoLink>
        <infoLink name="Searchlight" id="90fa-4461-dae4-f192" hidden="false" targetId="4877-41b8-d9e1-6da3" type="rule"/>
        <infoLink name="Smoke Launchers" id="6689-6e83-3981-cc4f" hidden="false" targetId="8573-0653-d612-e4de" type="rule"/>
        <infoLink name="Heavy Bolter" id="1d2d-f195-c21d-04dd" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Pintle-Mounted Heavy Bolter"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Hardened Crew" id="0c3b-9478-0d3e-6185" hidden="false">
          <description>The vehicle treats all &apos;Driver Stunned&apos; results on the damage tables as &apos;Crew Shaken&apos; instead.</description>
        </rule>
        <rule name="Skilled Gunnery" id="bcbd-5c95-aba2-a3fd" hidden="false">
          <description>Nominate a single weapon at the start of the shooting phase. You may re-roll any misses to-hit rolls with that weapon this turn. For ordnance, this allows you to re-roll the scatter dice.</description>
        </rule>
        <rule name="Tank Shock" id="0d2c-85c6-a6eb-fbc9" hidden="false">
          <description>Enemy infantry must test at -1 Leadership if they are Tank Shocked.</description>
        </rule>
        <rule name="Ordnance" id="9998-7380-82ff-bd8f" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule name="Lumbering Vehicle" id="6e84-3943-9c33-e66d" hidden="false">
          <description>Moves up to 6&quot; a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule name="Difficult Terrain" id="41b9-da1a-e0ff-8f20" hidden="false">
          <description>Ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3&quot; of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule name="Targetting" id="4e5d-5b1f-9081-83bf" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Stormsword (IA)" id="05a8-f26f-828b-b9ec" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="555"/>
      </costs>
      <entryLinks>
        <entryLink name="Vehicle Upgrades" id="5e90-6909-524f-51b9" collective="false" hidden="false" import="true" targetId="c0af-40a7-0f54-9847" type="selectionEntryGroup"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Stormsword" id="ce64-306e-cb71-6009" hidden="false" targetId="4650-2e47-08cf-dbec" type="profile"/>
        <infoLink name="Heavy Bolter" id="a9ba-86c5-f53b-e819" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Co-axial Heavy Bolter"/>
          </modifiers>
        </infoLink>
        <infoLink name="Heavy Bolter" id="af93-e3c8-e7fe-43fe" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Two Twin-Linked Heavy Bolters"/>
          </modifiers>
        </infoLink>
        <infoLink name="Heavy Flamer" id="d2ea-5e9c-44b3-a24a" hidden="false" targetId="6d36-2c09-dfc3-f257" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Two Heavy Flamers"/>
          </modifiers>
        </infoLink>
        <infoLink name="Twin-Linked" id="6ec7-65e0-bd37-793f" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Targetting" id="b9cf-6452-5c74-20cc" hidden="false">
          <description>Instead of picking one target for the Stormsword, pick a target for each of its weapons. The co-axial heavy bolter must fire at the same target as the Siege Cannon.</description>
        </rule>
        <rule name="Ordnance" id="e4b5-42cb-b996-38f8" hidden="false">
          <description>The stormsword may fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule name="Lumbering Vehicle" id="7eb3-bf83-9bbd-5f1b" hidden="false">
          <description>The stormsword can move up to 6&quot; a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule name="Difficult Terrain" id="d0d8-ac21-0a8e-24f3" hidden="false">
          <description>The Stormsword can ignore low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3&quot; of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
      </rules>
      <selectionEntries>
