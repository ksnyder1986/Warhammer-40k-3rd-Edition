        <selectionEntryGroup name="Snipers" id="fb3b-3f0a-d5f7-07e5" collective="false" defaultSelectionEntryId="1008-66eb-342b-ad8f" hidden="false" import="true">
          <constraints>
            <constraint id="1edf-5dae-2b2a-126d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
            <constraint id="19bd-126d-f5f7-ad02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Tanith Master Sniper" id="1008-66eb-342b-ad8f" collective="false" hidden="false" import="true" type="model">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Tanith Master Sniper" id="fc0d-36d3-0a9a-5c82" hidden="false" targetId="fe14-8df0-8592-4466" type="profile"/>
                <infoLink name="Sniper Rifle" id="0df2-524a-f5d8-6f2e" hidden="false" targetId="3825-4a6b-6aaa-8c99" type="profile"/>
                <infoLink name="Camo Cloak" id="2e1a-c5d5-6e42-3933" hidden="false" targetId="647d-f731-5d52-f8e4" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Ambush" id="7bfa-998e-123f-56ac" hidden="false">
                  <description>Set up using the Ambush rules in Codex: Catachans page 20.</description>
                </rule>
                <rule name="Camouflage" id="033c-a9a3-02ed-436f" hidden="false">
                  <description>Tanith Snipers have a 3+ cover save that cannot be improved or reduced by any factors (Camo Cloak already included).</description>
                </rule>
                <rule name="Master Snipers" id="82a2-ed7d-9ac9-22e3" hidden="false">
                  <description>Tanith Master Snipers may re-roll a failed to wound roll but must accept the second result.</description>
                </rule>
                <rule name="Disappear" id="98f2-80ac-cb0d-829d" hidden="false">
                  <description>Tanith Master Snipers never move. During your Movement phase, you may remove the sniper, representing the Master Sniper merging back into the shadows. Once removed, a Master Sniper may not return to the battlefield but doesn&apos;t count as having been killed for Victory point purposes. Tanith Master Snipers cannot claim table quarters or other objectives and don&apos;t have to be killed for an attacker to win Meat Ginder or Grand Assault.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
