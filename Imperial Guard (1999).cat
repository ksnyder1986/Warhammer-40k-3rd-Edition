        <infoLink name="Twin-Linked" id="f96a-907a-c763-ab65" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule"/>
        <infoLink name="Heavy Bolter" id="7bb7-a11b-a908-8aee" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
