    <selectionEntry name="Atlas Recovery Vehicle (IA)" id="cdb2-2e2d-f1e9-fe49" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="85"/>
      </costs>
      <entryLinks>
        <entryLink name="Vehicle Upgrades" id="ac68-c9b5-dca8-2267" collective="false" hidden="false" import="true" targetId="c0af-40a7-0f54-9847" type="selectionEntryGroup"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Atlas" id="3362-9530-1709-e31f" hidden="false" targetId="cd29-822f-abf7-7f05" type="profile"/>
        <infoLink name="Heavy Bolter" id="92a7-171d-83a4-82c3" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="3261-6601-5bfe-f5d0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Recovery Vehicle" id="8471-af9a-bd03-6d93" hidden="false">
          <description>The Atlast can drag any destroyed or immobilised vehicle (friend or foe) that starts the turn in contact with it. Both vehicles may move up to D6&quot; and must remain in base contact at the end of the move. Neither vehicle may shoot in the same turn that they are towing or being towed, except that the vehicle may fire one weapon at the Atlast if it is able and wants.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Cyclops (IA)" id="8fde-3c52-65c4-5a56" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="25"/>
      </costs>
      <entryLinks>
        <entryLink name="Chimera" id="6ed7-9e03-392a-677b" collective="false" hidden="false" import="true" targetId="7a19-0a0c-3e8c-e0d0" type="selectionEntry">
          <constraints>
            <constraint id="92e4-a0da-c472-5e85" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="49da-551d-33e9-68ec" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="49da-551d-33e9-68ec" type="set" value="1">
              <conditions>
                <condition childId="cf71-bdef-a981-47b6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Cyclops" id="36fd-8584-cf18-9260" hidden="false" targetId="3263-34b8-c755-931e" type="profile"/>
        <infoLink name="Demolition Charge" id="5b95-57aa-b096-990e" hidden="false" targetId="60f0-36e3-b539-71ac" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="Remote Controlled" id="ebaa-3e61-2aee-38a7" hidden="false">
          <description>The Cyclops is controlled by a single guardsman, or by the crew of a transporting Chimera. It moves independently of its controller, but it must remain with 48&quot; of the controller, otherwise it simple stops and cannot do anything until control is restored.
During the Imperial Guard Shooting Phase the Cyclops can be detonated. Place the Ordnance template centered on the Cyclops. It is destroyed during the explosion.</description>
        </rule>
        <rule name="Damage" id="1029-6003-4ffd-c84b" hidden="false">
          <description>The Cyclops is destroyed by any glancing or penetrating hits. When rolling for armour penetration, if a weapon scores a 6, and this results in a penetrating hit, then the Cyclops explodes as normal.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Operator" id="c8ca-8bd5-6d83-3066" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="798d-191a-1a6c-7110" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
