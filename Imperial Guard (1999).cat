          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule name="Difficult Terrain" id="6d5b-8bc8-caef-d433" hidden="false">
          <description>Ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3&quot; of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule name="Lumbering Vehicle" id="5e66-0279-abc9-15e3" hidden="false">
          <description>Moves up to 6&quot; a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule name="Tank Shock" id="100b-e9a8-3414-5384" hidden="false">
          <description>Enemy infantry must test at -1 Leadership if they are Tank Shocked.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Salamander Command Vehicle (IA)" id="2aa4-9ffa-1f3a-f926" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="100"/>
      </costs>
      <entryLinks>
        <entryLink name="Vehicle Upgrades" id="cc9e-807d-7d6e-d4f9" collective="false" hidden="false" import="true" targetId="c0af-40a7-0f54-9847" type="selectionEntryGroup"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Salamander" id="ab7f-edcf-b4ad-572c" hidden="false" targetId="e46b-5e10-d5a2-ee74" type="profile"/>
        <infoLink name="Heavy Flamer" id="5922-b0f8-0e5b-b56b" hidden="false" targetId="6d36-2c09-dfc3-f257" type="profile"/>
