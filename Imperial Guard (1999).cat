    <selectionEntry name="Baneblade (IA)" id="bb16-f01c-0c2c-4ac3" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="634"/>
      </costs>
      <entryLinks>
        <entryLink name="Vehicle Upgrades" id="716a-d0b5-bad9-7d77" collective="false" hidden="false" import="true" targetId="c0af-40a7-0f54-9847" type="selectionEntryGroup"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Heavy Bolter" id="6879-bf00-b23b-7cf2" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="3x Twin-Linked Heavy Bolters"/>
          </modifiers>
        </infoLink>
        <infoLink name="Twin-Linked" id="324b-4008-2325-6cd5" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule"/>
        <infoLink name="Baneblade" id="9bc4-5f0b-3b65-5f7c" hidden="false" targetId="6533-238a-6e25-f216" type="profile"/>
        <infoLink name="Baneblade Battle Cannon" id="a0ab-c516-9d85-8c3a" hidden="false" targetId="85dd-b3a9-328b-96d5" type="profile"/>
        <infoLink name="Demolisher" id="55d2-ca06-f9aa-225c" hidden="false" targetId="720f-5c52-b5ff-ee75" type="profile"/>
        <infoLink name="Lascannon" id="2004-4ac5-79ef-4ce8" hidden="false" targetId="a160-d79e-e7a9-2e9c" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="2x Lascannons"/>
          </modifiers>
        </infoLink>
        <infoLink name="Autocannon" id="19f9-8fe5-e6b8-f2b9" hidden="false" targetId="6128-e2af-037e-4d1a" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="Difficult Terrain" id="d994-18c1-4552-54ca" hidden="false">
          <description>The Stormsword can ignore low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3&quot; of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule name="Lumbering Vehicle" id="eb24-fa00-b574-ae7b" hidden="false">
          <description>The Baneblade can move up to 6&quot; a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule name="Ordnance" id="d93b-00cc-1025-f641" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule name="Targetting" id="f731-f583-c01e-0d89" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons. The co-axial autocannon must fire at the same target as the Baneblade Battle Cannon</description>
        </rule>
      </rules>
    </selectionEntry>
