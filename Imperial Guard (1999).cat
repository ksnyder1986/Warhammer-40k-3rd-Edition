    <selectionEntry name="Captain Obadiah Schfeer (IA)" id="e11a-b8f5-b754-644b" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="234"/>
      </costs>
      <infoLinks>
        <infoLink name="Leman Russ Vanquisher" id="8768-c327-df46-40bc" hidden="false" targetId="919f-bf50-b35d-742e" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Steel Dog Alpha"/>
            <modifier field="b109-f88e-dcc7-8a24" type="set" value="4"/>
          </modifiers>
        </infoLink>
        <infoLink name="Vanquisher Cannon" id="9cf9-7fb7-7664-c588" hidden="false" targetId="6ed6-d055-77b9-709e" type="profile"/>
