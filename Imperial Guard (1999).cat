    <selectionEntry name="Tanith Command HQ" id="7c5f-c897-1ea8-c4d3" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Gaunt&apos;s Ghosts" id="9047-6574-c14d-7db2" hidden="false" primary="false" targetId="8541-29cf-45ca-5d65"/>
        <categoryLink name="HQ" id="5941-37a3-b649-1256" hidden="false" primary="true" targetId="a8a7-7a4b-5f7e-2138"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Infiltrators" id="0827-4f7e-9e14-971a" hidden="false" targetId="b4ea-750c-d9a4-e398" type="rule"/>
        <infoLink name="Absolute Direction" id="529d-267e-4898-bf70" hidden="false" targetId="ea86-cee4-a47b-c214" type="rule"/>
