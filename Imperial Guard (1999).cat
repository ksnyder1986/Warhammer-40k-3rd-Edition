        <infoLink name="Lascannon" id="c057-88fc-9147-3af3" hidden="false" targetId="a160-d79e-e7a9-2e9c" type="profile"/>
        <infoLink name="Smoke Launchers" id="1ffe-3fa5-fa8b-ed0a" hidden="false" targetId="8573-0653-d612-e4de" type="rule"/>
        <infoLink name="Searchlight" id="60e3-b122-51a4-4f13" hidden="false" targetId="4877-41b8-d9e1-6da3" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="My Boys Love It" id="5e28-244d-ab0a-ac19" hidden="false">
          <description>Obadiah&apos;s tank is converted to varry a loud speaker system. Over this, he broadcasts orders to the rest of the company and loud Varolian martial music to inspire the boys and frighten the enemy (Varolian martial music is very loud, long, and to the untrained ear, quite painful). When Obadiah&apos;s tank forces a Tank Shock test on an enemy unit, they must make the test at -1 to their Leadership.</description>
        </rule>
        <rule name="Tank Hunters" id="6afa-183e-ca93-73a9" hidden="false">
          <description>Add +1 to all Armour Penetration rolls</description>
        </rule>
        <rule name="Improved Comms" id="504a-17ee-2559-7e95" hidden="false">
          <description>The Imperial Guard player may re-roll one Reserves roll per turn, and to re-roll the dice when checking to see if an enemy unit or obstacle is hit by a preliminary bombardment</description>
        </rule>
      </rules>
    </selectionEntry>
