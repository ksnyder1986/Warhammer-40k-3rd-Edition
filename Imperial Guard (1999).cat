        <infoLink name="Hellhound" id="5baf-4035-fd58-8eb5" hidden="false" targetId="8d33-84eb-ee2f-6531" type="profile"/>
        <infoLink name="Inferno Cannon" id="0f08-3024-92a7-75ae" hidden="false" targetId="6a00-06f9-5972-4b79" type="profile"/>
        <infoLink name="Heavy Bolter" id="bcdd-8e00-29d0-a518" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="Move &apos;n Shoot" id="df77-fcbc-aa21-5142" hidden="false">
          <description>A Hellhound that moves over 6&quot; can shoot in the shooting phase but only with its Inferno Cannon. If it moves over 6&quot; it must fire the caccnon via a side or rear facing.</description>
        </rule>
        <rule name="Fuel Tanks" id="c5f3-5ee6-1a64-ad74" hidden="false">
          <description>All glancing hits are treated as penetrating hits instead.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Rough Rider Squad" id="2418-a403-e4cb-b865" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <rules>
        <rule name="Trot" id="9e88-47d6-7c42-1561" hidden="false">
          <description>Rough Rider units may choose to trot during the movement phase. If they do they may move up to 9&quot; in the movement phase. But they may only charge 9&quot; in that turns assault phase and may only shoot pistols and may not enter or cross difficult terrain.</description>
        </rule>
      </rules>
