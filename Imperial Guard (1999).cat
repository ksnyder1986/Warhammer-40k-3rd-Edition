    <selectionEntry name="Hellhound" id="e7ef-e433-9126-7068" collective="false" hidden="false" import="true" type="model">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="70"/>
      </costs>
      <entryLinks>
        <entryLink name="Vehicle Upgrades" id="efdf-ebde-aeed-fb81" collective="false" hidden="false" import="true" targetId="c0af-40a7-0f54-9847" type="selectionEntryGroup"/>
