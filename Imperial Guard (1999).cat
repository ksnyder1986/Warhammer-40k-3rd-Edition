        <selectionEntry name="Archeotech" id="a40e-ae67-cc42-74fd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9bdb-1ed6-43bc-cd6b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4269-9829-5ea7-37f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="2c19-7729-2a55-326c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Archeotech" id="95d2-3852-7e16-1a2e" hidden="false">
              <description>Before each game, roll a D6 to see exactly what the Archeotech does.
1 - Nothing
2 - Against immobilised vehicles and bunkers the model may attack as if armed with a chainfist.
3 - The model counts as being armed with frag grenades.
4 - The owner gains a 5+ invulnerable save, but the save does not work against template or blast weapons. He also counts as four models when ascertaining which side outnumbers the other in close combat.
5 - Counts as a power sword.
6 - Counts as a master-crafted plasma pistol.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
