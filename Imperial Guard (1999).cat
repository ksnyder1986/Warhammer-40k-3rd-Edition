        <selectionEntry name="Siege Shells" id="6089-1491-11c8-1be3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3789-34f8-5c92-799d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
          <rules>
            <rule name="Siege Shells" id="3a03-7163-fcfc-76a5" hidden="false">
              <description>Choose to fire a siege round instead of a normal round. These rounds use the small Blast template, but roll 2D6+5 when rolling for Armour Penetration against bunkers and buildings instead of the normal 2D6 choose the highest. Siege shells affect models inside buildings on a 4+ instead of a 6.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Lord Commander Solar Macharius" id="7fe1-28b7-b695-d844" collective="false" hidden="false" import="true" type="unit">
      <constraints>
        <constraint id="3c92-9336-0a7c-1f9c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="173"/>
      </costs>
      <infoLinks>
        <infoLink name="Macharius" id="163b-befa-459b-d142" hidden="false" targetId="e07c-426c-a0e5-c4b9" type="profile"/>
        <infoLink name="Trademark Item" id="f39d-7a38-34f9-b348" hidden="false" targetId="0630-f0bd-6da5-e593" type="rule">
          <modifiers>
            <modifier field="name" type="set" value="Crimson Cloak"/>
          </modifiers>
        </infoLink>
        <infoLink name="Bolt Pistol" id="a588-fc92-da5c-4667" hidden="false" targetId="e9ac-c779-51bb-3c9a" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Master-crafted Bolt Pistol"/>
          </modifiers>
        </infoLink>
        <infoLink name="Power Weapon" id="1301-2b88-61e8-4d4d" hidden="false" targetId="5774-7187-2616-dd8a" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Master-crafted Power Weapon"/>
          </modifiers>
        </infoLink>
        <infoLink name="Independent Character" id="59f2-e42a-d299-8a83" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule"/>
        <infoLink name="Master-crafted Weapons" id="90fb-2a93-18fa-5c06" hidden="false" targetId="bfa6-639a-4ff4-e20e" type="rule"/>
        <infoLink name="Carapace Armor" id="4fae-e204-7ed4-453c" hidden="false" targetId="f1bf-49f9-4094-c2f9" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Helm of Macharius" id="191a-83f8-bf50-b296" hidden="false">
          <description>Macharius has a 3+ invulnerable save.</description>
        </rule>
        <rule name="Command Presence" id="dd61-3899-d803-3413" hidden="false">
          <description>Any Imperial Guard unit within 12&quot; of Macharius takes Morale and Pinning checks using his Leadership of 10</description>
        </rule>
        <rule name="Ferocious Charge" id="7138-1cd1-de6f-1b0e" hidden="false">
          <description>Macharius adds D3 attacks when he charges, instead of the normal +1.</description>
        </rule>
        <rule name="Old War Wounds" id="9200-768f-4d17-d36a" hidden="false">
          <description>Macharius&apos;s WS and A characteristics are determined randomly at the start of the battle.</description>
        </rule>
        <rule name="Master Strategist" id="35ef-a5ed-22d7-fd20" hidden="false">
          <description>An army including Macharius may choose to go first in any mission where this is normally decided randomly.</description>
        </rule>
      </rules>
    </selectionEntry>
