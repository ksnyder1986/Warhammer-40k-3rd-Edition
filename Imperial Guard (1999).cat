        <infoLink name="Open-Topped" id="9e4a-c9ed-e6c4-4451" hidden="false" targetId="4795-fd7c-2846-78ba" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Surveyor" id="5b59-4401-c040-df2f" hidden="false">
          <description>If enemy infiltrators set up with 4D6&quot; of a model with a surveyor then the model is allowed to take a &apos;free&apos; shot at them. If the model is part of a unit, the whole unit may shoot. These shots are taken before the battle begins and may cause the infiltrators to fall back.</description>
        </rule>
        <rule name="Improved Comms" id="7d60-bc40-8aad-f8b1" hidden="false">
          <description>The Imperial Guard player may re-roll one Reserves roll per turn, and to re-roll the dice when checking to see if an enemy unit or obstacle is hit by a preliminary bombardment</description>
        </rule>
      </rules>
    </selectionEntry>
