          <conditions>
            <condition childId="9aad-1b01-38fb-9597" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
            <condition childId="any" field="4ed5-2f92-9abc-2870" includeChildSelections="true" scope="force" shared="true" type="lessThan" value="1500"/>
          </conditions>
        </modifier>
      </modifiers>
