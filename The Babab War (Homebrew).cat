          </constraints>
          <infoLinks>
            <infoLink name="Terminator Armour" id="8634-a61f-35ee-dacb" hidden="false" targetId="fe7a-62df-712a-5bc5" type="rule"/>
            <infoLink name="Iron Halo" id="65f1-1706-0a4c-06fb" hidden="false" targetId="c214-19e6-edea-0f81" type="rule"/>
            <infoLink name="Purity Seals" id="924d-87a9-b335-3b56" hidden="false" targetId="8fca-253c-bbf8-9510" type="rule"/>
            <infoLink name="Heavy Flamer" id="6ddc-ae3a-35db-7f8f" hidden="false" targetId="6d36-2c09-dfc3-f257" type="profile"/>
            <infoLink name="Lightning Claw" id="09b0-f30b-b651-0357" hidden="false" targetId="c7a3-7006-5226-8181" type="profile">
              <modifiers>
                <modifier field="name" type="set" value="The Ghost Razors"/>
                <modifier field="24d8-2110-08fa-d844" type="set" value="User +1"/>
                <modifier field="492d-1f80-b777-26f2" type="set" value="May re-roll any failed wounds. Any successful Invulnerable Saves made against wounds from the Ghost Razors must be re-rolled."/>
              </modifiers>
            </infoLink>
            <infoLink name="Independent Character" id="39c4-cf28-49da-2558" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Huron" id="50b5-649a-2cdd-19b5" hidden="false" typeId="1e16-2bd8-7cad-379b" typeName="Unit">
              <characteristics>
                <characteristic name="WS" typeId="c704-6128-f143-935a">5</characteristic>
                <characteristic name="BS" typeId="7928-3a9b-6080-ed95">5</characteristic>
                <characteristic name="S" typeId="df03-6292-d3f5-f778">4</characteristic>
                <characteristic name="T" typeId="e5f6-94c4-de8c-5fa8">4</characteristic>
                <characteristic name="W" typeId="4dc2-c603-0bc5-0561">4</characteristic>
                <characteristic name="I" typeId="eeda-4fb4-901e-b70d">5</characteristic>
                <characteristic name="A" typeId="abbf-0d11-fd86-d938">4</characteristic>
