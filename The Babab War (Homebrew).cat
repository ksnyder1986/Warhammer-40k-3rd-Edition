    <selectionEntry name="Legion Sentry Battery" id="8e78-c1a7-220e-51fa" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="c120-bf7c-40b2-848c" primary="true" targetId="aacb-8a81-62c0-3db8"/>
