      </constraints>
      <selectionEntries>
        <selectionEntry name="Retaliator Enforcer" id="ff05-2b64-1ae6-bd3f" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="a9fc-7bc6-c7a5-b370" field="selections" scope="parent" shared="true" type="max" value="3"/>
            <constraint id="a4ae-33b6-8bb1-a7e2" field="selections" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
