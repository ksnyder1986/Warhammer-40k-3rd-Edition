      </categoryLinks>
      <selectionEntries>
        <selectionEntry name="Sentry Gun" id="02c3-663d-668b-bdf1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="01de-23c9-8307-59f1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="6"/>
            <constraint id="302d-2783-2116-e1d5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="3"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
          <infoLinks>
            <infoLink name="Weapon Plaform" id="a486-0226-3767-6eec" hidden="false" targetId="96fe-e706-c834-c073" type="profile">
              <modifiers>
                <modifier field="b109-f88e-dcc7-8a24" type="set" value="2"/>
              </modifiers>
            </infoLink>
            <infoLink name="Immobile" id="19e9-159c-0a19-5e93" hidden="false" targetId="468c-bd45-5505-589a" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Targetting Priority" id="b887-98ab-8d1f-3386" hidden="false">
              <description>A heavy bolter/assault cannon Sentry gun will fire at the nearest non-vehicle unit it can hit. A lascannon/multi-melta Sentry gun will fire at the closest enemy vehicle or monstrous creature it can hit. If no preferred target can be hit they will shoot at non-preferred targets.</description>
            </rule>
            <rule name="Damage" id="0e97-9857-1e7c-2296" hidden="false">
              <description>A Sentry Gun is destroyed by any glancing or penetrating hit.</description>
            </rule>
            <rule name="Firing Modes" id="2a02-b679-6a05-b170" hidden="false">
              <description>At deployment, you must select a firing mode. It cannot be changed once the game begins.

Point Defence Mode: Choose a fixed 90 degree arc. The gun will engage enemy targets up to 24&quot; away within the arc.

Sentry Mode: The gun will fire at the nearest enemy target within 12&quot; that it can see.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Weapon" id="55d0-c9f8-74b3-f90c" collective="false" defaultSelectionEntryId="24f5-e779-2ddb-ce8a" hidden="false" import="true">
