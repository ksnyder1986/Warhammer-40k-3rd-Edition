            <profile name="Centurion" id="6cc2-8d2e-c8a0-15c8" hidden="false" typeId="1e16-2bd8-7cad-379b" typeName="Unit">
              <characteristics>
                <characteristic name="WS" typeId="c704-6128-f143-935a">5</characteristic>
                <characteristic name="BS" typeId="7928-3a9b-6080-ed95">5</characteristic>
                <characteristic name="S" typeId="df03-6292-d3f5-f778">4</characteristic>
                <characteristic name="T" typeId="e5f6-94c4-de8c-5fa8">4</characteristic>
                <characteristic name="W" typeId="4dc2-c603-0bc5-0561">2</characteristic>
                <characteristic name="I" typeId="eeda-4fb4-901e-b70d">5</characteristic>
                <characteristic name="A" typeId="abbf-0d11-fd86-d938">3</characteristic>
                <characteristic name="Ld" typeId="f47e-b15a-8f58-703c">9</characteristic>
                <characteristic name="Sv" typeId="b309-5233-122f-82bb">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Astral Claws First" id="ba8b-7a66-17e8-15c7" hidden="false">
              <description>As an Astral Claws Space Marine, a Centurion still benefits from the Stubborn special rule, but it does not interact differently if he has joined an Auxilia unit. He does not suffer (or benefit) from the Intractable and The Strong and Strongest Alone rules.</description>
            </rule>
            <rule name="Tip of the Spear" id="a9cd-1660-4394-9d8a" hidden="false">
              <description>A Centurion must be taken in any Tyrant&apos;s Legion army over 1500 points, regardless of the force allocation chart being used. Centurions count as a Commander level Space Marine Hero for the Proud and Arrogant Badab War Special Rule.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
