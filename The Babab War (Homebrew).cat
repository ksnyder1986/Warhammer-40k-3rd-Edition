    <selectionEntry name="Chapter Master Lias Issodon" id="f863-a6ff-c22d-9f8a" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="175"/>
      </costs>
      <modifiers>
