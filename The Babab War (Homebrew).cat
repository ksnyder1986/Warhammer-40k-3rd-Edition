      </infoLinks>
      <modifiers>
        <modifier field="error" type="add" value="Tyberos cannot be taken in a force less than 1500pts.">
          <conditions>
            <condition childId="0fea-6343-575d-301b" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
            <condition childId="any" field="4ed5-2f92-9abc-2870" includeChildSelections="true" scope="force" shared="true" type="lessThan" value="1500"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Circling Predators" id="48a6-c3a2-cb14-459d" hidden="false">
          <description>In a turn in which a Tyberos and his Red Brethren Terminator Squad Deep Strikes onto the battlefield, they may move D3&quot; towards the nearest enemy unit during the assault phase. If they move into base contact, they count as being engaged in close combat and may fight in melee that turn, but they do not count as charging.</description>
        </rule>
        <rule name="Red Brethren" id="7ddd-0010-5858-ab3f" hidden="false">
          <description>If Tyberos is accompanied by a Red Brethren Terminator Squad, both he and the squad automatically pass all Pinning and Morale Checks they are required to make.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Tyberos" id="b68e-6424-a2bd-75d6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="78db-1aa4-71f3-be1a-min" field="selections" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="78db-1aa4-71f3-be1a-max" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <infoLinks>
