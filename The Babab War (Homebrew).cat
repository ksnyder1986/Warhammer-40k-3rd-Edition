<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue name="The Badab War (Homebrew)" id="e2b4-3c55-5ca1-3f39" authorUrl="https://drive.google.com/file/d/1eqFeEO-WrMVzMxg-0bsc7G0MGgaLF3jf/view?usp=sharing" battleScribeVersion="2.03" gameSystemId="96e2-b781-50d7-3d18" gameSystemRevision="7" library="false" revision="6" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
