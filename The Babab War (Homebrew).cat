                <characteristic name="Sv" typeId="b309-5233-122f-82bb">2+</characteristic>
              </characteristics>
            </profile>
            <profile name="The Lifetaker" id="9475-95e1-2266-86d7" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
                <characteristic name="S" typeId="24d8-2110-08fa-d844">User +1</characteristic>
                <characteristic name="AP" typeId="25ce-028f-0aae-2855">2</characteristic>
                <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
                <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Master-Crafted; Two Handed; Instant Death on to wound rolls of 6</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Grehdalin&apos;s Bones" id="d85f-5db0-5195-8d43" hidden="false">
              <description>Grendalin&apos;s Bones confer a 2+ Armour Save and when Kane would suffer from Instant Death he only takes a single wound instead.</description>
            </rule>
            <rule name="Honour of the Chapter" id="3369-a914-dcb9-0e8e" hidden="false">
              <description>Both Kane and any Space Marine squad he joins automatically pass all Leadership tests they are required to make.</description>
            </rule>
            <rule name="Commander of Legend" id="fa35-3120-7d53-29ff" hidden="false">
              <description>Kane counts as a Chapter Master for the Proud and the Arrogant Badab War special rule.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
