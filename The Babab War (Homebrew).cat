      <selectionEntries>
        <selectionEntry name="Earthshaker Cannon" id="2660-10a5-780d-cee7" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c925-6ed3-b88f-12ff-min" field="selections" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="c925-6ed3-b88f-12ff-max" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="51"/>
