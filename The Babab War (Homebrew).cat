                        <infoLink name="Laspistol" id="c6f8-9b98-34cd-1966" hidden="false" targetId="95a9-d270-d218-1772" type="profile"/>
                      </infoLinks>
                    </selectionEntry>
                    <selectionEntry name="Sniper Rifle" id="ecdf-1366-9bab-d395" hidden="false" import="true" type="upgrade">
                      <costs>
                        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
                      </costs>
                      <infoLinks>
                        <infoLink name="Sniper Rifle" id="fe8c-4b2e-36e3-4c7b" hidden="false" targetId="3825-4a6b-6aaa-8c99" type="profile"/>
                      </infoLinks>
                      <modifiers>
