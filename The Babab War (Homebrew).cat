    <selectionEntry name="Venerable Ancient Bray&apos;arth Ashmantle" id="f2ac-cdbb-8b41-a9d2" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="HQ" id="c631-775c-4c16-752f" primary="true" targetId="a8a7-7a4b-5f7e-2138"/>
