      <modifiers>
        <modifier field="error" type="add" value="Captain Zhrukhal Androcles cannot be taken in a force less than 1500pts.">
          <conditions>
            <condition childId="3482-6b22-bdc9-8d50" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
