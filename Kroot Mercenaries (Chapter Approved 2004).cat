          </costs>
          <rules>
            <rule name="Blood of the Stalker" id="c390-2891-4954-637d" hidden="false">
              <description>In missions where the Kroot can infiltrate, the character and his kindred may deploy D6&quot; closer to the enemy that indicated in the scenario set-up instructions.</description>
            </rule>
          </rules>
        </selectionEntry>
