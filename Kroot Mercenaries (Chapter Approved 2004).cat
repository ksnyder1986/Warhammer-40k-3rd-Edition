    <selectionEntry name="Tracker Kindred" id="5bea-5105-6368-8ea1" collective="false" hidden="false" import="true" type="unit">
      <infoLinks>
        <infoLink name="Cavalry" id="8cbb-47d3-bae9-015f" hidden="false" targetId="0e80-1d1e-f91a-11fe" type="rule"/>
        <infoLink name="Infiltrators" id="78d7-0ac6-5680-c532" hidden="false" targetId="b4ea-750c-d9a4-e398" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Native Cavalry" id="87f8-01e4-1421-44a5" hidden="false"/>
        <rule name="Native Trackers" id="d6be-2275-84e3-4fb5" hidden="false"/>
        <rule name="Native Scouts" id="179f-c5cd-9dd2-c0a7" hidden="false"/>
        <rule name="Eaters of the Dead" id="d663-6943-db40-ada0" hidden="false">
          <description>Kroot must pass a Leadership test in order to pursue a foe defeated in close combat or make a sweeping advance. If the test is failed the Kroot must instead consolidate. If a Kroot Shaper is in the squad then they MUST consolidate, they have no choice.</description>
        </rule>
        <rule name="Fieldcraft" id="876c-e960-71a8-9142" hidden="false">
          <description>Kroot gain +1 to their cover save in woods or jungles. Kroot in woods or jungles do not roll a Difficult Terrain test; they may always move up to 6&quot;. If they do not move in the movement phase they may see and shoot through 12&quot; of woods or jungle terrain rather than the normal 6&quot;</description>
        </rule>
      </rules>
