        <entryLink name="Space Marine Vehicle Upgrades" id="40d0-bb4c-9268-32a1" collective="false" hidden="false" import="true" targetId="93a4-c4f2-3183-a640" type="selectionEntryGroup"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Venerable Dreadnought" id="c172-4d76-85f1-93f4" hidden="false" targetId="51e5-f2dc-8261-e34f" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="Hard to Kill" id="3286-afbc-5497-f776" hidden="false">
          <description>Venerable Dreadnoughts are extraordinarily tenacious. When taking a glancing or penetrating hit, you may force your opponent to re-roll the resulting damage.</description>
        </rule>
        <rule name="Old &amp; Wise" id="1997-cb72-6374-c27b" hidden="false">
          <description>Venerable Dreadnoughts are revered ancient warriors who are extremely wise in the ways of war. If an Iron Hands army includes one of them then it may re-roll the dice if the mission being played has a dice roll to see who gets the first turn.</description>
        </rule>
      </rules>
