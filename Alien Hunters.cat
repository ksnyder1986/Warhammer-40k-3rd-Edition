              <description>4+ Armour Save</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Frag Grenades" id="f574-9756-4350-16ca" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
