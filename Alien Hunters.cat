        <selectionEntry type="upgrade" import="true" name="Rosarius" hidden="false" id="ddaf-8290-5baa-42e5" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2008-b3a2-0976-522d" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
