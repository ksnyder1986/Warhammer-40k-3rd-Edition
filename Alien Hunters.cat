        <selectionEntry type="upgrade" import="true" name="Inquisitorial Mandate" hidden="false" id="6b03-632e-ae9c-85d2">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b872-13ea-df8a-7931"/>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="59bc-336c-dca6-35a5" includeChildSelections="true"/>
          </constraints>
          <rules>
            <rule name="Inquisitorial Mandate" id="4ba4-5fc5-4605-7d30" hidden="false">
              <description>A model bearing an Inquisitorial Mandate may reveal it once per battle. This may be done at any time, as long as the model with the Mandate does not move in the turn it is revealed. On the turn the Mandate is revealed, all friendly models with 2D6&quot; recieve a +1 Attack bonus for the rest of that turn.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="notInstanceOf" value="0" field="selections" scope="ancestor" childId="2f5b-253a-02ea-74d9" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" childName="Ordo Xenos Inquisitor Lord"/>
