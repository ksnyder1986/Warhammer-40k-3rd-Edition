        <selectionEntry type="upgrade" import="true" name="Camo Netting" hidden="false" id="8598-f02c-fff1-55d0" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="409e-95f9-6e9f-0983" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Camo Netting" id="0ccc-486a-5ff6-2c2c" hidden="false">
              <description>In scenarios using the Hidden Set-up rules, vehicles carrying camo netting can be set up hidden anywhere in their deployment zone.</description>
            </rule>
