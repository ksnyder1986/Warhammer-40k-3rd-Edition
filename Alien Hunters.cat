    <selectionEntry name="Deathwatch Landraider Crusader" id="3128-58cd-1ecc-9fa0" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Deathwatch" id="9c18-03fa-e4fd-f725" primary="false" targetId="fb40-23ff-db43-ac2f"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="255"/>
      </costs>
      <entryLinks>
        <entryLink name="Alien Hunters Vehicle Upgrades" id="d484-82cc-0e9e-a5b0" hidden="false" import="true" targetId="27d0-afe4-bb00-2151" type="selectionEntryGroup"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Deathwatch" id="138a-d56b-24dd-9ba1" hidden="false" targetId="8517-3f49-0164-eb63" type="infoGroup"/>
        <infoLink name="Assault Cannon" id="3e8b-686e-f2ad-e9b9" hidden="false" targetId="3f9c-e7c1-c442-3b7c" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="2x Twin-Linked Assault Cannon"/>
          </modifiers>
        </infoLink>
        <infoLink name="Boltgun" id="9574-5dd0-93d8-454f" hidden="false" targetId="60bf-18fd-f6e6-6eb4" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="2x Hurricane Pattern Bolters"/>
            <modifier field="d3f6-19e8-ac9e-ae13" type="set" value="Rapid Fire 3"/>
            <modifier field="492d-1f80-b777-26f2" type="set" value="Twin-Linked. Counts as 3 Bolters."/>
          </modifiers>
        </infoLink>
        <infoLink name="Land Raider" id="afff-7dbc-d6e7-2ae9" hidden="false" targetId="06fe-33b7-e2f7-b6e8" type="profile">
          <modifiers>
            <modifier field="ec07-2d55-2ba5-6080" type="set" value="15 Marines. 8 Terminators."/>
          </modifiers>
        </infoLink>
        <infoLink name="Multi-melta" id="1974-576e-f5ed-5a35" hidden="false" targetId="7077-4e34-5c92-5320" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="Deus Ex Machina (IA)" id="5df0-f59f-e62b-07ad" hidden="false">
          <description>If the crew are stunned then the Machine Spirit will take over temporarily. The Land Raider may be moved directly forward up to its maximum move.</description>
        </rule>
        <rule name="Fire Control (IA)" id="3966-9c85-623f-ffa3" hidden="false">
          <description>The Land Raider may always fire one additional weapon system to those it would normally be able to fire. This shot may be against a different target to that engaged by the crew. Automatic targeting is less accurate and therefore conducted with BS2. If the crew are stunned or shaken, the Machine Spirit may still fire a weapon using this rule.</description>
        </rule>
        <rule name="Frag Assault Launchers" id="ad68-1841-8798-392a" hidden="false">
          <description>Any unit that assaults on the same turn it disembarks from the Crusader counts as having frag grenades</description>
        </rule>
        <rule name="Extra Armour" id="3a23-f240-bd48-5658" hidden="false">
          <description>Count the &apos;Crew Stunned&apos; result as &apos;Crew Shaken&apos; instead</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Orbital Strike" id="1408-0bba-0c12-7be6" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Alien Hunter Heavy Choices" id="193a-4dd4-1f8b-7d45" primary="false" targetId="5544-1919-07c4-fba5"/>
      </categoryLinks>
      <constraints>
        <constraint id="9526-a061-6729-2c02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <rules>
        <rule name="Inaccuracy" id="56e8-27a4-014a-235e" hidden="false">
          <description>An Orbital Strike scatters just like ordinary ordnance weapons, except when a miss is rolled the distance scatterd is double the number scored on the D6. If a hit is rolled, the template deviates by the distance shown on the Hit Symbol.</description>
        </rule>
        <rule name="Pinning" id="e016-6f32-0330-5464" hidden="false">
          <description>All Orbital Strikes cause Pinning tests</description>
        </rule>
        <rule name="Placement" id="463e-b2ba-32d7-023d" hidden="false">
          <description>The Ordnance Blast marker for the strike must be placed anywhere within the specified terrain piece</description>
        </rule>
        <rule name="Plotting" id="09d0-b1fd-b5ba-d4ff" hidden="false">
          <description>The Orbital Strike must be keyed to a specific piece of terrain at the start of the battle. Make a note of the plotted target before forces are deployed but after deployment zones have been determined</description>
        </rule>
        <rule name="Timing" id="754b-1d60-8ec7-1769" hidden="false">
          <description>An orbital strike uses the Reserve special rule to determine when it strikes. Once the orbital strike passes the Reserve roll it fires each Space Marine shooting phases for the rest of the game. It cannot be stopped once started. The Space Marine player can opt to not roll for the onset of the orbital strike if they wish.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Orbital Strike Type" id="eac0-1065-f1dd-d834" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="2b85-e661-3f39-3994" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="856e-6028-256f-ec24" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
