        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Extra Armor" hidden="false" id="4fd8-bd57-403c-7524" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d283-19c6-41f2-2052" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Extra Armour" id="170d-46d1-b28e-6c61" hidden="false">
              <description>Count the &apos;Crew Stunned&apos; result as &apos;Crew Shaken&apos; instead</description>
