    <selectionEntryGroup name="Alien Hunters Vehicle Upgrades" id="27d0-afe4-bb00-2151" hidden="false" collective="false" import="true" collapsible="true">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Dozer Blade" hidden="false" id="a91b-53b5-9c0a-b735" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="30bd-a70f-1371-1405" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Dozer Blade" id="9a35-bf1a-1b4d-a27c" hidden="false">
              <description>Re-roll failed Difficult Terrain tests as long as the model did not move more than 6&quot; that turn.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Extra Armor" hidden="false" id="2b9d-9bae-5ff1-f158" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="54f0-a6c0-b24a-e6ad" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Extra Armour" id="c8b5-0671-693e-e06f" hidden="false">
              <description>Treat &apos;Crew Stunned&apos; results as &apos;Crew Shakeen&apos; instead.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hunter-killer Missile" hidden="false" id="78b4-28cb-8b73-c7f7" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6dbc-e617-57fc-bebc" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
