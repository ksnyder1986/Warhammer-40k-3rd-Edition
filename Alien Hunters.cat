    <selectionEntry type="unit" import="true" name="Medusa (IA)" hidden="false" id="07a9-f490-6f44-670c" collective="false">
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="equalTo" value="0" field="selections" scope="force" childId="3261-6601-5bfe-f5d0" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
