        <selectionEntry type="upgrade" import="true" name="Improved Comms" hidden="false" id="cb85-2c3c-a52c-3e6c" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="19d1-4897-2cf3-3223" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Improved Comms" id="cabd-5793-1013-b5a7" hidden="false">
              <description>The Imperial Guard player may re-roll one Reserves roll per turn, adn to re-roll the dice when checking to see if an enemy unit or obstacle is hit by a preliminary bombardment</description>
