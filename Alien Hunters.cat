            <rule name="AA" id="c4c8-e6d1-a1f4-d01f" hidden="false">
              <description>The Lascannon may fire at aircraft using its normal BS</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
