                <selectionEntryGroup name="Xeno Specaility" id="96a8-24f3-a874-f6c3" hidden="false">
                  <constraints>
                    <constraint id="376d-fa1e-98f7-9952-min" field="selections" scope="parent" shared="true" type="min" value="1"/>
                    <constraint id="376d-fa1e-98f7-9952-max" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <selectionEntries>
                    <selectionEntry name="Eldar" id="e0ef-744d-6255-656a" hidden="false" import="true" type="upgrade">
                      <rules>
                        <rule name="Eldar Xenologist" id="31e8-90d5-a3d0-b405" hidden="false">
                          <description>The Inquisitor as well as all members of their retinue gain benefits against Eldar, Dark Eldar, Harlequins, etc. They may re-roll to wound rolls of 1 and against vehicles may re-roll armour penetration rolls of 1.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry name="Necrons" id="0abc-87ef-810d-6a01" hidden="false" import="true" type="upgrade">
                      <rules>
                        <rule name="Necrons Xenologist" id="f52b-b4ea-c82d-579b" hidden="false">
                          <description>The Inquisitor as well as all members of their retinue gain benefits against Necrons, C&apos;tan, etc. They may re-roll to wound rolls of 1 and against vehicles may re-roll armour penetration rolls of 1.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry name="Orks" id="574a-4ba1-e24f-0434" hidden="false" import="true" type="upgrade">
                      <rules>
                        <rule name="Ork Xenologist" id="ac25-1ad9-8615-8c5c" hidden="false">
                          <description>The Inquisitor as well as all members of their retinue gain benefits against Orks, Grots, Squigs, etc. They may re-roll to wound rolls of 1 and against vehicles may re-roll armour penetration rolls of 1.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry name="Tau" id="6f54-1e25-b684-9115" hidden="false" import="true" type="upgrade">
                      <rules>
                        <rule name="Tau Xenologist" id="0849-148d-4c0b-64ac" hidden="false">
                          <description>The Inquisitor as well as all members of their retinue gain benefits against Tau, Kroot, Vespids, etc. They may re-roll to wound rolls of 1 and against vehicles may re-roll armour penetration rolls of 1.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry name="Tyranids" id="87a7-754b-6c80-0e41" hidden="false" import="true" type="upgrade">
                      <rules>
                        <rule name="Tyranid Xenologist" id="22f2-2e1d-9d89-2c90" hidden="false">
                          <description>The Inquisitor as well as all members of their retinue gain benefits against Tyranids, Genestealer Cults, etc. They may re-roll to wound rolls of 1 and against vehicles may re-roll armour penetration rolls of 1.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry name="Xenos Minoris" id="bc28-31e3-01c5-b352" hidden="false" import="true" type="upgrade">
                      <rules>
                        <rule name="Minoris Xenologist" id="3bf7-d098-1ff7-9d6b" hidden="false">
                          <description>The Inquisitor as well as all members of their retinue gain benefits against non-standard Xenos (such as those from Creature Features). They may re-roll to wound rolls of 1 and against vehicles may re-roll armour penetration rolls of 1.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
              </selectionEntryGroups>
            </selectionEntry>
