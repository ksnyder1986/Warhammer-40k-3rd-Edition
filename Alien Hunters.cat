          </constraints>
          <rules>
            <rule name="Orbital Intel" id="e64c-cdb3-d18d-a75a" hidden="false">
              <description>After deployment is complete (including infiltrators and scouts) but before determining who has the first turn, any single infantry unit within 6&quot; of this model may be redeployed up to 12&quot;, but must abide by all the mission&apos;s deployment zones and rules.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Terminator Armour" hidden="false" id="7fd1-40c9-6c66-fc22">
