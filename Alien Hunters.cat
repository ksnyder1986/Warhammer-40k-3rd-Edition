        <selectionEntry type="upgrade" import="true" name="Auspex" hidden="false" id="2119-1403-a137-497e" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9c72-7c32-c43c-09f7" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Auspex" id="d15d-7920-1eb2-99c8" hidden="false">
              <description>If enemy infiltrators set up within 4D6&quot; of a model with a auspex, then that model and the unit they are attached to is allowed to take a &quot;free&quot; shot at them. These shots are taken before the battle begins and may cause the infiltrators to fall back.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="2"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Adamantine Mantle" hidden="false" id="aa4b-2e0d-2fcd-a4f1">
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="35"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8439-0f46-1eaf-7eaf"/>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="b798-8a15-93f2-0565" includeChildSelections="true"/>
          </constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="notInstanceOf" value="1" field="selections" scope="parent" childId="6901-980c-4b19-1320" shared="true" childName="Deathwatch Captain"/>
                    <condition type="notInstanceOf" value="1" field="selections" scope="parent" childId="1a3a-12b4-1d45-47b2" shared="true" childName="Deathwatch Master"/>
                  </conditions>
