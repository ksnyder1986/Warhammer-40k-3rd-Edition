          </costs>
          <infoLinks>
            <infoLink name="Hunter-killer Missile" id="e0c2-a0e3-f9ac-2037" hidden="false" targetId="86d5-c5a0-fc04-7f5a" type="profile"/>
          </infoLinks>
        </selectionEntry>
        <selectionEntry name="Improved Comms" id="cb85-2c3c-a52c-3e6c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="19d1-4897-2cf3-3223" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <rules>
            <rule name="Improved Comms" id="cabd-5793-1013-b5a7" hidden="false">
              <description>The Imperial Guard player may re-roll one Reserves roll per turn, adn to re-roll the dice when checking to see if an enemy unit or obstacle is hit by a preliminary bombardment</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Mine Sweeper" id="04c3-f503-5f08-c056" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="108d-cd92-e03f-75e5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1503-9582-1e82-99d8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Mine Sweeper" id="1225-5ead-fd1b-efaf" hidden="false">
              <description>The vehicle may enter a minefield without being attack. Any minefield the vehicle moves across is cleared and removed from play</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Pintle Storm Bolter" id="3219-af03-bf51-dcba" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1770-ac59-0773-ca6f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
