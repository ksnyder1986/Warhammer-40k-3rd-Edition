        </modifier>
        <modifier field="error" type="add" value="You must include two Space Marine Ally troop choices before adding {root-entry}">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="any" childName="any" field="selections" includeChildSelections="true" scope="self" shared="true" type="atLeast" value="1"/>
