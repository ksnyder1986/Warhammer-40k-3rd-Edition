              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Adamantine Mantle" id="134a-2564-d988-7327" hidden="false">
              <description>The character wears a cloak or cape made of the strongest materials. The character does not suffer Instant Death when wounded by a weapon whose
Strength is at least twice the character‘s Toughness, taking a single wound instead.</description>
            </rule>
          </rules>
        </selectionEntry>
