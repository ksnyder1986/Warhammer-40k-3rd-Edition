            <rule name="Master-crafted Weapons" id="02f8-44a8-4cc5-a430" hidden="false">
              <description>The bearer may re-roll one failed to hit roll per turn.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Medallion Crimson" hidden="false" id="b9ec-d21f-edc6-a7c2" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cb6a-2916-9cb2-1dda" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Medallion Crimson" id="9652-135d-3f5e-185a" hidden="false">
              <description>The first time the bearer is wounded by an attack that causes instant death he takes a single wound instead.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Melta Bombs" hidden="false" id="197a-5d05-cf84-7c25" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2e62-f0f5-6de9-3b88" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <infoLinks>
            <infoLink name="Melta Bombs" id="8a7d-1227-95fd-3ab3" hidden="false" targetId="87d0-8c40-7bcb-8cbb" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Surveyor" hidden="false" id="47ac-2741-0b43-82d8" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="802a-1aa7-ccd1-f501" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Surveyor" id="ba8e-4ca3-09af-a9d5" hidden="false">
              <description>If enemy infiltrators set up with 4D6&quot; of a model with a surveyor then the model is allowed to take a &apos;free&apos; shot at them. If the model is part of a unit, the whole unit may shoot. These shots are taken before the battle begins and may cause the infiltrators to fall back.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="2"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Honorifica Imperialis" hidden="false" id="f0d8-9ede-2c7e-ce46" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="force" shared="true" id="fb95-a278-3801-7338" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4f95-4ca1-f8a9-f6ad" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Honorifica Imperialis" id="6103-47a7-6e35-15ee" hidden="false">
              <description>The wearer gains the stats of a Heroic Senior Officer, but does not become an officer or an independent character</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="25"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Macharian Cross" hidden="false" id="f3b0-b481-df6e-2b95" collective="false">
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="0" field="selections" scope="ancestor" childId="9b26-b663-04dc-1998" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f49f-e897-0224-79bf" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Machine Curse" id="34bb-6d7b-e973-6993" hidden="false">
              <description>Make the Psychic test at the start of the Assault phase. If passed the power is effective until the end of the same Assault phase. Make one close combat attack against a vehicle in base contact with the Psyker. If a hit is scored, roll a D6:
1 - 3: No effect
4 - 5: Inflict Glancing Hit
6 : Inflict Penetrating Hit</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Refractor Field" hidden="false" id="4045-815b-a8b7-18cb" collective="false">
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="0" field="selections" scope="ancestor" childId="9b26-b663-04dc-1998" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1890-90b9-5dd2-eb86" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Refractor Field" id="7928-4953-f146-d886" hidden="false">
              <description>Gain a 5+ invulnerable save</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Trademark Item" hidden="false" id="b767-db27-99ba-7126" collective="false">
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="0" field="selections" scope="ancestor" childId="9b26-b663-04dc-1998" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a26d-0369-506a-2856" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Trademark Item" id="4bef-cc69-df36-c864" hidden="false">
              <description>A unit led by a person who carries a trademark item may re-roll any failed Morale or Pinning checks it suffers. However, if the character is slain, the unit must pass a Morale test to avoid falling back.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Navy Vehicle Upgrades" id="af51-b222-5ced-6781" hidden="false" collective="false" import="true" collapsible="true">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Ejector Seats" hidden="false" id="4579-6be6-7d54-be8f" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="208b-05e2-ccd6-112d" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Ejector Seats" id="1962-85e9-15e1-be4e" hidden="false">
              <description>If the aircraft is destroyed roll a D6. On a 1-3 nothing happens. On a 4+ the crewman successfully ejects. Roll a Scatter Dice and 4D6&quot; for the direction and distance from the aircraft the crewman lands. Each crewman counts a single Guardsman with a laspistol. They are considered to be below half strength for the purposes of moral checks, claiming table quarters, etc. If any crew survice the aircraft will only count as damaged for the purposes of Victory Points at the end of the game.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Flare/Chaff Launcher" hidden="false" id="5020-a5c5-4d6d-c5f5" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e762-f88c-8310-41cb" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Flare/Chaff Launcher" id="feff-6681-6a90-ae7f" hidden="false">
              <description>One use only. If the vehicle takes the Immobilised damage result then re-roll the result.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Armoured Cockpit" hidden="false" id="b7a2-67f4-4c1d-0112" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="635a-b40e-76bd-73bd" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Armoured Cockpit" id="b5e2-29dc-e3a9-66b1" hidden="false">
              <description>If the aircraft takes the Crew Shaken, Crew Stunned, or Pilot Shaken result, then roll a D6. On a 4+ the result is ignored.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Infrared Targeting" hidden="false" id="b0de-d04c-a07a-83c2" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3a0e-ebb9-d644-f410" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Infrared Targeting" id="d100-c60f-bfaf-ad67" hidden="false">
              <description>The aircraft can re-roll the dice for the distance it can engage enemiers during a Night Fighting mission.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Illum Flare" hidden="false" id="27e8-96bb-1f30-be61" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b9f7-4bd1-e249-e97d" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Illum Flare" id="fcca-ddd1-7e4a-3145" hidden="false">
              <description>This flare is used in missions where the Night Fighting rules are in effect. They allow one enemy unit spotted by the aircraft to be fired at in the next turn by any other ground forces in range and that have line of sight.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="3"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Nose Art" hidden="false" id="a1e5-566b-ee4a-c12a" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c8bb-4f69-c846-7427" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="Nose Art" id="a0b0-6f27-31c9-c1ec" hidden="false">
              <description>In the player&apos;s own turn, after the aircraft has attacked in the opponent&apos;s turn, the first unit to fail a Moral test may re-roll the test.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
