    <selectionEntryGroup name="Xenos Artefacts" id="157b-54a2-175d-9638" hidden="false">
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="5637-57af-0978-1fc2" childName="Inquisitor" field="selections" scope="parent" shared="true" type="notInstanceOf" value="1"/>
                <condition childId="bb42-b139-e132-cd80" childName="Inquisitor Lord" field="selections" scope="parent" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        <modifier field="error" type="add" value="Deathwatch will not work with Radical Inquisitors">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="157b-54a2-175d-9638" childName="Xenos Artefacts" field="selections" scope="parent" shared="true" type="atLeast" value="1"/>
                <condition childId="fb40-23ff-db43-ac2f" childName="Deathwatch" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry name="Chronometron" id="7d50-9b47-22d4-2ad5" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7f4a-34d3-b1db-b900" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <rules>
            <rule name="Chronometron" id="210b-ab6b-005d-df8c" hidden="false">
              <description>An Inquisitor with a Chronometron, and any unit they have joined, rolls an extra dice and discards the lowest when determining how far they can make a sweeping advance or fall back move.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Gaze of Flame" id="7527-9e97-1e5b-c446" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="551f-bfff-b5ca-5b8b" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
          <rules>
            <rule name="Gaze of Flame" id="aa5e-cb21-1660-bd9c" hidden="false">
              <description>Models belonging to units which charge into combat with the bearer of the Gaze of Flame gain no bonus to their Attacks for charging. Additionally, models fighting in a close combat involving a character with a Gaze of Flame suffer -1 Leadership penalty in addition to any other modifiers.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Neural Shredder" id="1cfc-3857-f029-effa" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6099-cc2a-5a83-3de4" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
          <profiles>
            <profile name="Neural Shredder" id="f297-6453-2374-88a9" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Template</characteristic>
                <characteristic name="S" typeId="24d8-2110-08fa-d844">8</characteristic>
                <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
                <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Assault 1</characteristic>
                <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Roll against the target&apos;s Leadership to wound, not their Toughness. Automatically causes a Glancing Hit against vehicles, but only rolls a D3 on the Vehicle Damage table.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Shadowfield" id="7211-b97d-6f6d-c119" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7061-03c4-4e1e-947e" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="35"/>
          </costs>
          <rules>
            <rule name="Shadowfield" id="0624-17e0-b4de-8060" hidden="false">
              <description>A Shadowfield provides its owner a 2+ invulnerable save, but if the save is ever failed the field is destroyed for the remainder of the game. In the event the bearer suffers multiple wounds in a single phase roll each save individually to determine exactly when the field shorts out.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Solar Pulse" id="b0c4-825b-01df-22dd" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c71b-2b9e-18d0-ac04" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <rules>
            <rule name="Solar Pulse" id="ffe7-4df0-59ab-a1f1" hidden="false">
              <description>The Solar Pulse is used at the beginning of the Alien Hunter turn. If the Night Fighting rules are in effect, they will cease to apply during the Alien Hunter turn in which the Solar Pulse is used. If the Night Fighting rules are not in use then for the following enemy turn after the Solar Pulse is used, the Night Fighting rules will apply to any unit firing at the character wearing the Solar Pulse (and
any unit it has joined). If a unit cannot see the character as a result they may redirect their fire at another target.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Spirit Stones" id="c846-e97b-2a96-a492" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8108-99c5-2e5d-f2af" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20"/>
          </costs>
          <rules>
            <rule name="Spirt Stones" id="af7c-ec27-eabb-46aa" hidden="false">
              <description>A psyker with spirit stones can use two psychic powers per turn, but not the same power twice. </description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Void Sabre" id="8a50-5690-f028-5793" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="78e8-6c49-ac8b-50a4" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
          <profiles>
            <profile name="Void Sabre" id="6aaa-5263-617d-f590" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
                <characteristic name="S" typeId="24d8-2110-08fa-d844">User +1</characteristic>
                <characteristic name="AP" typeId="25ce-028f-0aae-2855">-</characteristic>
                <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
                <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Rending</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Rending" id="8633-b9a6-a8f2-f9b2" hidden="false">
              <description>Inflict a wound automatically and ignore armour saves on to-hit rolls of 6. Other successful hits must roll to wound as normal. If the owner rolls a 6 for Armour Penetration they then can roll an additional dice to determine the total Armour Penetration value.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
