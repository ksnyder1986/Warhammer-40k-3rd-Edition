      <profiles>
        <profile name="Medusa" typeId="0ef1-7861-4312-c7aa" typeName="Vehicle" hidden="false" id="7068-e7ef-487d-9b67">
          <characteristics>
            <characteristic name="Front Armor" typeId="6723-22c2-f6f0-6cbf">12</characteristic>
            <characteristic name="Side Armor" typeId="ef72-8ecb-1637-97bb">10</characteristic>
            <characteristic name="Rear Armor" typeId="99bc-d564-3760-e4b0">10</characteristic>
            <characteristic name="BS" typeId="b109-f88e-dcc7-8a24">3</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Siege Shells" id="26ff-8a98-614c-bbca" hidden="false">
          <description>May choose to fire siege shells instead of normal shells. Roll 2D6+5 when rolling for Armour penetration for the Medusa siege gun against bunkers.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Open-Topped" id="138a-e2ab-4381-3250" hidden="false" targetId="4795-fd7c-2846-78ba" type="rule"/>
