          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="notInstanceOf" value="0" field="selections" scope="ancestor" childId="2f5b-253a-02ea-74d9" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" childName="Ordo Xenos Inquisitor Lord"/>
                    <condition type="notInstanceOf" value="0" field="selections" scope="ancestor" childId="7765-d1cc-97d7-ab17" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" childName="Ordo Xenos Inquisitor"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
