                    <condition childId="5544-1919-07c4-fba5" childName="Alien Hunter Heavy Choices" field="selections" includeChildSelections="true" scope="force" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
