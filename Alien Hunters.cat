        <selectionEntryGroup name="Hunting Lance" id="4c8a-fb99-ea79-7f5c" hidden="false" collective="false" import="true">
          <modifierGroups>
            <modifierGroup type="and">
              <comment>This logic may seem odd. What happens is that when # of RRs is 5, the max number of lances shoots up to 9. By subtracting by 4 when we reach five, we counteract the fact it adds in four extra lances. We cannot set the max to 0 because it does not display the option to select lances without it being a max &gt; 0.</comment>
              <modifiers>
                <modifier type="increment" value="1" field="ef3f-7a78-a3a9-f3c0">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="parent" childId="e121-be11-46e8-6910" shared="true" roundUp="false" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
                  </repeats>
                  <conditions>
                    <condition type="greaterThan" value="4" field="selections" scope="parent" childId="e121-be11-46e8-6910" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
                  </conditions>
                </modifier>
                <modifier type="decrement" value="1" field="ef3f-7a78-a3a9-f3c0">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="parent" childId="7ce6-1941-424d-9686" shared="true" roundUp="false" percentValue="false" includeChildSelections="true" includeChildForces="true"/>
                  </repeats>
                </modifier>
                <modifier type="decrement" value="4" field="ef3f-7a78-a3a9-f3c0">
                  <conditions>
                    <condition type="greaterThan" value="4" field="selections" scope="parent" childId="e121-be11-46e8-6910" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
                  </conditions>
                </modifier>
              </modifiers>
            </modifierGroup>
          </modifierGroups>
          <constraints>
            <constraint type="max" value="4" field="selections" scope="parent" shared="true" id="ef3f-7a78-a3a9-f3c0" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Hunting Lance" hidden="false" id="35fa-dcce-4077-4d24" collective="false">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="3"/>
              </costs>
              <profiles>
                <profile name="Hunting Lance" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon" hidden="false" id="ec9f-498c-9f2e-2dd9">
                  <characteristics>
                    <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
                    <characteristic name="S" typeId="24d8-2110-08fa-d844">User/User +2 when charging</characteristic>
                    <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
                    <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
                    <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">One use. Must be used in first close combat phase the model participates in. Add +2 S and +1 I if the model charged. Ignores armour saves.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
