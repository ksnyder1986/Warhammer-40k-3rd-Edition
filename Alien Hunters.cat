          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Pintle-mounted Storm Bolter" hidden="false" id="7017-1b7e-961c-df09" collective="false">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8e43-18a5-e5e0-7b75" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
