          </costs>
          <infoLinks>
            <infoLink name="Plasma Gun" id="118e-a6ef-847b-527c" hidden="false" targetId="112a-baea-9eeb-b1b5" type="profile"/>
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
