          </costs>
          <rules>
            <rule name="Surveyor" id="f468-eed0-41b0-5182" hidden="false">
              <description>If enemy infiltrators set up with 4D6&quot; of a model with a surveyor then the model is allowed to take a &apos;free&apos; shot at them. If the model is part of a unit, the whole unit may shoot. These shots are taken before the battle begins and may cause the infiltrators to fall back.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Honorifica Imperialis" id="fd0f-d021-3a03-4351" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1912-7f85-377d-1a48" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
            <constraint id="3a02-544e-0344-afb3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
