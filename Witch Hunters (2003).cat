      <selectionEntryGroups>
        <selectionEntryGroup name="Flagellants" id="2a6c-1993-9631-1c8f" collective="false" defaultSelectionEntryId="6576-b963-bf8e-c61a" hidden="false" import="true">
          <constraints>
            <constraint id="d174-d4ec-c725-5762" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="3"/>
            <constraint id="f81a-7634-d3a1-0410" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="6"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Arco-flagellant" id="6576-b963-bf8e-c61a" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="35"/>
              </costs>
              <infoLinks>
                <infoLink name="Fearless" id="4f72-82b2-effe-55c6" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule"/>
                <infoLink name="Invulnerable Saving Throw" id="f00a-4f15-303a-28df" hidden="false" targetId="97b3-810d-a09e-872b" type="rule"/>
                <infoLink name="Power Weapon" id="882d-2781-d12c-511b" hidden="false" targetId="5774-7187-2616-dd8a" type="profile"/>
              </infoLinks>
              <rules>
                <rule name="Dangerous to Know" id="0317-e403-4bed-e7e4" hidden="false">
                  <description>Arco-flagellants may not ride in vehicles. They cannot capture table quarters, objectives, or count as surviving troops in a Meat Grinder mission. In addition, no other models may ever join a unit of Arco-flagellants.</description>
                </rule>
                <rule name="Implant Injectors" id="8504-3b39-dcae-9018" hidden="false">
                  <description>The Arco-flagellant&apos;s stimm injectors can be activated at the beginning of any of the Witch Hunter&apos;s movement phases. For the remainder of the game they are subject to the Holy Rage (pg 24) rule. However, on a roll of 6 for additional movement remove a model as a casualty.
In close combat, roll a D6 at the beginning of each Assault phase to determine the number of Attacks it may make that phase, in additional to the bonus for assaulting that turn. Should a 6 be rolled, the model will be removed as a casualty at the end of the Assault phase after it resolves its attacks.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
