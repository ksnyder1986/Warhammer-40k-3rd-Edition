    <selectionEntry name="Arco-flagellants" id="75e8-963b-d44e-77cd" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Elites" id="9ba6-6d18-1d3a-65b5" hidden="false" primary="true" targetId="6d25-b346-c314-6911"/>
      </categoryLinks>
