              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="70"/>
              </costs>
              <infoLinks>
                <infoLink name="Lance Strike" id="aaa8-cf50-bc4f-76e7" hidden="false" targetId="9cb1-4f2e-f134-c371" type="profile"/>
              </infoLinks>
            </selectionEntry>
