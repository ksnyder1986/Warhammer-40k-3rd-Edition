        <infoLink name="Jump Packs" id="e8d4-bd3a-96eb-aeae" hidden="false" targetId="2563-092a-a5bc-992f" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Faithful" id="46f9-dd96-95c5-224d" hidden="false">
          <description>Add 1 Faith Point</description>
        </rule>
        <rule name="Angelic Visage" id="ea8a-7b7b-5a7b-87ca" hidden="false">
          <description>Any Adepta Sororitas unit with a model within 6&quot; of at least one model in the Seraphim unit adds +1 to their Leadership, up to a maximum of 10. Note that other units of Seraphim do not benefit from this rule.</description>
        </rule>
        <rule name="Hit and Run" id="dbf2-26b1-36d6-4104" hidden="false">
          <description>At the end of a round of close combat, Seraphims may choose to break off if they and at least some of their close combat opponents do not have to fall back. She falls back 3D6&quot; in any direction and automatically regroups at the end of the move. Enemy models that were in the close combat may only consolidate.</description>
        </rule>
      </rules>
