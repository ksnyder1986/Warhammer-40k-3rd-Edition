                  <modifiers>
                    <modifier field="name" type="set" value="Twin-linked Heavy Bolter"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Sisters Repentia" id="4283-2c1e-14e2-b1f1" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Elites" id="1f87-ef3c-74c7-9c09" hidden="false" primary="true" targetId="6d25-b346-c314-6911"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Priest" id="62f0-cd3f-55c0-1f0d" hidden="false" import="true" targetId="3adf-82c9-2af9-31f3" type="selectionEntry"/>
      </entryLinks>
      <rules>
        <rule name="Only in Death Does Duty End" id="c280-6fb2-a1b6-cbe2" hidden="false">
          <description>At the start of the Movement phase roll a D6 to see if the unit is gripped so strongly by the desire to repent that is must rush towards the enemy. On a 1 or 2 they are subject to the Holy Rage (pg 24) rule.</description>
        </rule>
        <rule name="Righteous Zeal" id="83e7-39fe-a005-df65" hidden="false">
          <description>Should the Repentia ever fail a Morale check they will move 2D6&quot; towards the nearest enemy unit instead of fall back, at the end of the enemy Shooting phase. Should this extra move take them into contact with an enemy unit, they count as having charged in the subsequent Assault phase. In close combat the squad automatically passes any Morale checks it is required to make.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Mistress" id="7558-d32f-df57-5e11" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="f247-ead7-983d-4e7e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="05ff-55a1-5d92-90ac" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="30"/>
          </costs>
          <infoLinks>
            <infoLink name="Mistress" id="b5a1-9c38-e9d3-38ff" hidden="false" targetId="d75d-484f-3fb9-5d8d" type="profile"/>
            <infoLink name="Neural Whip" id="ceae-2157-48b0-3eec" hidden="false" targetId="eac5-4345-8c0f-7049" type="profile"/>
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
