        <infoLink name="Instability" id="186d-a0f5-b618-2b1a" hidden="false" targetId="4d84-04be-e208-c7ce" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Small Target" id="5186-b94a-6a62-a770" hidden="false">
          <description>Nurglings&apos; cover save is at +1. They do not block line of sight to anything behind them.</description>
        </rule>
        <rule name="Vulnerable to Blasts" id="e2a8-7e34-d8ae-94b8" hidden="false">
          <description>Template, Ordnance and Blast marker weapons inflict two wounds instead of one on nurglings.</description>
        </rule>
        <rule name="Mischievous" id="c6ec-af88-a521-b731" hidden="false">
          <description>Nurglings may never hold table quarters or objectives</description>
        </rule>
      </rules>
