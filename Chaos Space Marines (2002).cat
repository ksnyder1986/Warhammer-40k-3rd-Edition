              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Personal Icon" id="417e-3179-ae5d-7944" hidden="false">
              <description>The model bears the Icon of the God aligned with their Mark. This Icon can be used for Daemon Summoning just like unit Icons.</description>
            </rule>
