      <profiles>
        <profile name="Talon of Horus" id="19ff-ac48-fb4b-26f4" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
            <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
            <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
            <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignore armour saves. Re-roll failed to wound rolls</characteristic>
          </characteristics>
        </profile>
        <profile name="Talon of Horus" id="0919-f474-ab72-3d56" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">24&quot;</characteristic>
            <characteristic name="S" typeId="24d8-2110-08fa-d844">4</characteristic>
            <characteristic name="AP" typeId="25ce-028f-0aae-2855">5</characteristic>
            <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Rapid Fire</characteristic>
            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Twin-Linked</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemon Sword Drach&apos;nyen" id="9c61-0ae4-8740-77c4" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
            <characteristic name="S" typeId="24d8-2110-08fa-d844">*</characteristic>
            <characteristic name="AP" typeId="25ce-028f-0aae-2855">*</characteristic>
            <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">The sword makes one attack per turn, with no re-rolls. A hit ignores armour saves and kills the victim outright. Vehicles suffer an automatic penetrating hit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Chaos Terminator Armour" id="8681-20d9-e4f9-6b3a" hidden="false">
          <description>As normal Terminator armour, but the invulnerable save is increased to 4+. Additionally, any psychic power used against Abaddon, or that includes him in its area of effect, is nullified on a D6 roll of 4+.</description>
        </rule>
        <rule name="Mark of Chaos Ascendant" id="649c-b442-f6a3-1277" hidden="false">
          <description>The Mark of Chaos Ascendant is counted as a Mark of Chaos Undivided for troop selection purposes. Additionally he is Fearless and automatically passes all moral checks and Pinning tests he is called upon to make.</description>
        </rule>
      </rules>
      <selectionEntries>
