    <selectionEntry name="Mark of Chaos Undivided" id="cd3d-c65d-0f5a-bdde" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <modifiers>
        <modifier field="category" type="add" value="e9f2-4b8e-c0b1-bb50"/>
      </modifiers>
      <rules>
        <rule name="Mark of Chaos Undivided" id="6772-35c2-84f9-707e" hidden="false">
          <description>The unit/model may re-roll all failed Morale checks. To benefit from the reroll, all members of the unit that is testing must have the Mark of Chaos Undivided.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Mark of Khorne" id="958a-4953-9c9c-2605" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Fearless" id="a3a7-fc29-60d6-3991" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="category" type="add" value="039c-5796-7006-0975"/>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="2bd3-6edb-d462-4c45" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Blood Frenzy" id="2c4e-acc9-3592-e41d" hidden="false">
          <description>- Gain +1 Attack.
- Gain Fearless.
- Must charge any enemy in range at the start of the Assault phase.
- At start of the Movement phase, roll a D6 for each unit with Blood Frenzy (do not roll for vehicles, Dreadnoughts, bikes or models using Daemonic Flight). On a 1 or 2 they advance a normal move +1D6&quot; towards the nearest enemy instead of moving normally. If mounted in a transport they will disembark before moving.
- Units that make the compulsory move from Blood Frenzy may not fire any weapons.
- If victorious in an assault they must sweeping advance unless the models are equipped with Terminator armour or they won due to &apos;moral high ground.&apos;
- A character with Blood Frenzy may not join a unit without it and a character without Bloody Frenzy may not join a unit with it.</description>
        </rule>
      </rules>
    </selectionEntry>
