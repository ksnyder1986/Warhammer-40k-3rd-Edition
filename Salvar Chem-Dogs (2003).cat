  <sharedInfoGroups>
    <infoGroup name="Savlar Chem-Dogs" id="4067-362a-414b-d61e" hidden="false">
      <infoLinks>
        <infoLink name="Scavengers" id="218d-aa6d-f273-7adf" hidden="false" targetId="56bd-9279-b9df-5645" type="rule"/>
        <infoLink name="Nitro-Chem Inhaler" id="3f97-9147-9348-6463" hidden="false" targetId="c75e-7f7f-5409-bb7f" type="rule"/>
      </infoLinks>
    </infoGroup>
  </sharedInfoGroups>
  <sharedRules>
    <rule name="Scavengers" id="56bd-9279-b9df-5645" hidden="false">
      <description>Savlar Chem-Dogs may never make a sweeping advance after a combat.</description>
    </rule>
    <rule name="Nitro-Chem Inhaler" id="c75e-7f7f-5409-bb7f" hidden="false">
      <description>Savlar Chem-Dogs ignore negative modifiers to their Morale checks, and will test on the unmodified Leadership of the unit or character that is leading it all times.
In addition, if they do fail a Morale check, they will become pinned instead of falling back. However, they fall back in close combat as normal.</description>
    </rule>
    <rule name="Chem-Riders" id="b0df-bc87-7a32-f38d" hidden="false">
      <description>All Savlar Chem-Riders benefit from an Invulnerable 5+ save.</description>
    </rule>
  </sharedRules>
</catalogue>
