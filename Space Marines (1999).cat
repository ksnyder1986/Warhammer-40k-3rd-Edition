                <condition childId="7dbe-7b9c-89fc-d346" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="primary-catalogue" shared="true" type="notInstanceOf" value="0"/>
                <condition childId="e2b4-3c55-5ca1-3f39" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="primary-catalogue" shared="true" type="notInstanceOf" value="0"/>
