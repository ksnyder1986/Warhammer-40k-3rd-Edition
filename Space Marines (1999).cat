    <selectionEntry name="Chaos Relic" id="cea6-461f-9a78-4c1c" hidden="false" import="true" type="upgrade">
      <comment>Relictors</comment>
      <constraints>
        <constraint id="0eec-eeaf-3921-3ea9" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="50"/>
      </costs>
      <infoGroups>
        <infoGroup name="Chaos Banner Rules" id="96b9-36de-c80b-1579" hidden="false">
          <profiles>
            <profile name="Rapturous Standard" id="1c4d-2720-9b4c-8a3a" hidden="false" typeId="7279-038a-b87a-ed0c" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="a08a-36f8-2fd3-b843">Once per game at the start of the Shooting Phase any model within 6&quot; gains the Feel no Pain special ability for the remainder of the turn.</characteristic>
              </characteristics>
            </profile>
            <profile name="Banner of Rage" id="4a72-fea3-6fc4-b19f" hidden="false" typeId="7279-038a-b87a-ed0c" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="a08a-36f8-2fd3-b843">Once per battle release its power. In any Assault phase the models in the same unit as the model bearing the Banner gain +1 A.</characteristic>
              </characteristics>
            </profile>
            <profile name="Icon of Chaos Undivided" id="395b-08c6-b2d3-e6b4" hidden="false" typeId="7279-038a-b87a-ed0c" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="a08a-36f8-2fd3-b843">Any unit or model 6&quot; becomes Fearless.</characteristic>
              </characteristics>
            </profile>
            <profile name="Plague Banner" id="e968-dbac-bb4b-81a5" hidden="false" typeId="7279-038a-b87a-ed0c" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="a08a-36f8-2fd3-b843">Once per battle cause any one enemy unit within 6&quot; to take D6 wounds with no armour or cover saves possible.</characteristic>
              </characteristics>
            </profile>
            <profile name="Blasted Standard" id="6c71-8da3-ece5-1fa2" hidden="false" typeId="7279-038a-b87a-ed0c" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="a08a-36f8-2fd3-b843">Once per battle in the player&apos;s Shooting Phase the standard can be aimed at any enemy unit with a model with 6&quot; of the Icon Bearer and may even target a unit in close combat. The spell inflicts 2D6 S6 AP4 hits.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="71f1-cbf9-c4ed-47ac" childName="Relictor" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Chaos Relic" id="f5bb-361f-6ef5-941d" hidden="false">
          <description>Before the game begins roll a D6 to determine which banner the relic represents.
1 - Icon of Chaos Undivided
2 - Icon of Chaos Undivided
3 - Banner of Rage
4 - Plague Banner
5 - Rapturous Standard
6 - Blasted Standard</description>
        </rule>
      </rules>
    </selectionEntry>
