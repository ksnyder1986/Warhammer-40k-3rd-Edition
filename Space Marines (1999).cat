              <conditions>
                <condition childId="8f0b-3e54-c10f-0a71" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Horsetail Talismans" id="345d-536b-15c7-a831" hidden="false">
              <description>This Holy Relic can be revealed in each and every White Scars&apos; Movement Phase during which the bearer has moved and is no longer in a vehicle. Any unit of White Scares infantry or bikes that have at least one model within 6&quot; of the bearer when it is revealed may move an extra D6&quot; rather than firing in the following Shooting phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Grimoire Pandaemonica" id="951c-b07e-c2ee-33c4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="591e-f5ac-6897-28d4" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1"/>
