        <selectionEntry name="Exchange Smite for Quickening" id="b5eb-cf90-023a-202b" hidden="false" import="true" sortIndex="2" type="upgrade">
          <comment>Howling Griffons</comment>
          <constraints>
            <constraint id="cd2a-f1d9-48b4-f4ba" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
