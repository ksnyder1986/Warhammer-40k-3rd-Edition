<catalogue name="Space Marines (1999)" id="9d6b-d195-877e-09cb" battleScribeVersion="2.03" gameSystemId="96e2-b781-50d7-3d18" gameSystemRevision="2" library="false" revision="15" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <catalogueLinks>
    <catalogueLink name="Imperial Guard (2003)" id="5836-5984-1cf5-3980" importRootEntries="false" targetId="04bd-002e-d5fe-e9a6" type="catalogue"/>
    <catalogueLink name="Daemon Hunters (2003)" id="4bdf-012b-fbcf-8e41" targetId="c8cb-cc69-1e43-3319" type="catalogue"/>
  </catalogueLinks>
  <categoryEntries>
    <categoryEntry name="Blood Angel" id="a527-734f-2081-58cd" hidden="false"/>
    <categoryEntry name="Sanguinary Priest" id="5709-6bb9-f3f9-07f2" hidden="false"/>
    <categoryEntry name="Librarian" id="02ee-bc24-ec98-8712" hidden="false"/>
    <categoryEntry name="Chaplain" id="b216-ba2e-4d56-b986" hidden="false"/>
    <categoryEntry name="Standard Bearer" id="6c91-d214-036a-50a2" hidden="false"/>
    <categoryEntry name="Techmarine" id="2e99-a0cf-9812-b860" hidden="false"/>
    <categoryEntry name="Dark Angel" id="a0a1-0673-b637-2cc4" hidden="false"/>
    <categoryEntry name="Grand Master" id="5992-9b5f-b0e9-d902" hidden="false"/>
    <categoryEntry name="Deathwing" id="d0ac-cb49-d41e-bba3" hidden="false"/>
    <categoryEntry name="Black Templar" id="0e24-d2c1-5ce8-e7cb" hidden="false"/>
    <categoryEntry name="Salamander" id="3c77-1326-2bf2-1b97" hidden="false"/>
    <categoryEntry name="Ravenwing" id="d056-919e-b449-186d" hidden="false"/>
    <categoryEntry name="Dreadnought" id="8dd2-2313-fb9d-0368" hidden="false"/>
    <categoryEntry name="Death Company" id="4663-cb6b-fa64-6b84" hidden="false"/>
    <categoryEntry name="Cursed Founding" id="2de3-5ccc-967b-e580" hidden="false"/>
    <categoryEntry name="White Scars" id="8f0b-3e54-c10f-0a71" hidden="false">
      <rules>
        <rule name="Born in the Saddle" id="9cab-28f8-2d8a-76ce" hidden="false">
          <description>White Scars on bikes may re-roll any failed Difficult Terrain tests, but must accept the new result. They may also use an additional close combat weapon while riding a bike for +1 attack.</description>
        </rule>
        <rule name="Counter-Attack" id="7f1a-e974-8026-83d5" hidden="false">
          <description>White Scars mounted on Bikes can react quickly to any attack. When a unit of White Scars mounted on bikes has been assault they may moved up to 6&quot; to get into base contact.</description>
        </rule>
        <rule name="Hit &amp; Run" id="8986-c9ca-f107-84c9" hidden="false">
          <description>White Scares mounted on bikes (but not squads including Attack Bikes) may choose to leave close combat. Declare this at the end of any Assault phase after all Morale checks have been taken. The Bikes fall back 3D6&quot; in any direction and then regroup at the end of the move. Enemy models may only consolidate.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Imperial Fists" id="4c67-7c9c-ef81-4805" hidden="false">
      <rules>
        <rule name="Blind To The Risks" id="f347-d63e-3351-17d8" hidden="false">
          <description>In a mission with a variable game length, when the game ends, the Imperial Fists&apos; opponent may choose that a single extra turn of the game is played.</description>
        </rule>
        <rule name="Fortifications" id="5c33-aa85-201e-360b" hidden="false">
          <description>Imperial Fists received +1 AP against bunkers, and their own bunkers have AV 14.</description>
        </rule>
        <rule name="Hidden Set-Up" id="deb8-6a7f-960e-f91c" hidden="false">
          <description>When moving over a minefield, Imperial Fists only trigger a mine on a 6+.</description>
        </rule>
        <rule name="Obstacles" id="b8d9-5743-fba9-d9d5" hidden="false">
          <description>Imperial Fists tank traps have AV 12.</description>
        </rule>
        <rule name="Preliminary Bombardment" id="a81c-8995-d52b-3125" hidden="false">
          <description>When resolving a preliminary bombardment, the Imperial Fists receive one extra roll for every 500 points being used. This can result in a single unit being hit several times. The Imperial Fists cannot choose to roll extra dice against a unit that has already been attacked. All the dice attacking a particular unit must be rolled together at the same time.</description>
        </rule>
        <rule name="Stubborn Defense" id="a0a2-5bed-852e-1c55" hidden="false">
          <description>When occupying fortifications in missions where they are the defenders, Imperial fists are treated as being stubborn. They will automatically pass any Morale Checks even in situations where normally they would automatically fail. They may never use the voluntary fall back option rule, but test for pinning as normal. Outside of fortifications they get no benefit.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Iron Hands" id="3bf5-6158-26f8-ea64" hidden="false"/>
    <categoryEntry name="Relictor" id="71f1-cbf9-c4ed-47ac" hidden="false"/>
    <categoryEntry name="Astral Claw" id="4032-b922-a004-b37c" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="a65d-9351-4d61-323b" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Intractable" id="473d-659f-3210-b8f5" hidden="false">
          <description>At the start of the turn, roll a D6 for each Astral Claws character, unit, or dreadnought that is not in close combat, war fired upon in the previous turn, and is within 24&quot;, line of sight, and within range of at least one unit in the Astral Claws unit. On the roll of 2-6 the unit acts normally for the turn. On a roll of 1, the unit will instead stubbornly refuse to move and must remain stationary.


The units that roll a 1 may not move in the movement phase or the assault phase, but can shoot as normal. In addition, they count as being stubborn for the remainder of that turn and all the following enemy turn even if they are not usually stubborn. In the unit is a Dreagnought it may ignore crew stunned and crew shaken results for that turn.


Note that Fast Attack units do not have the Intractable rule.</description>
        </rule>
        <rule name="The Strong and Strongest Alone" id="063f-2bdd-a6b0-14a1" hidden="false">
          <description>At the end of a game, the Astral Claws player can decide to continue fighting for one more turn. Another whole game turn is played as normal and the result of the battle is decided once that full game turn is finished. This decision is given to the Astral Claws player regardless of whether the game has a fixed length or random length.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Lamenters" id="c644-6c81-7124-50da" hidden="false">
      <rules>
        <rule name="Legacy of Woe" id="a13d-401f-afb2-6a91" hidden="false">
          <description>The Lamenter&apos;s Opponent may always choose to play an extra turn regardless of which mission is being played.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Executioners" id="982a-882e-5534-9a80" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="e6d8-743e-c00c-4a94" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Bitter Mettle" id="32c9-a56e-5825-d003" hidden="false">
          <description>Execution Space Marines ignore all negative modifiers to Leadership (including losing a combat, being outnumbered, etc.)</description>
        </rule>
        <rule name="Legacy of Rann" id="2bb9-899b-a9f9-2bd0" hidden="false">
          <description>Any Executioners Veteran or Command Squad members may take a boarding shield at +2pts per model. In addition, any Executioners model that may have a close combat weapon may exchange it for a Chain Axe at +1pts per model.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Mantis Warriors" id="815d-1d48-c255-50b6" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="cb19-d8fb-be2a-4a61" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Shadow Killers" id="2b14-fb73-01c6-8c74" hidden="false">
          <description>Mantis Warrior infantry units in Power or Artificer Armour gain the Move Through Cover Veteran Skill at no additional cost. Roll an extra D6 when moving through difficult terrain.</description>
        </rule>
        <rule name="Ambush" id="8b5e-fbb0-36b3-7ca8" hidden="false">
          <description>If a Mantis Warrior squad which has the majority of its unit in cover completes a charge move, they gain +1 WS and +1 Initiative for the remainder of that Assault Phase.</description>
        </rule>
        <rule name="Expansive Airwing" id="9351-54d5-43b6-fee9" hidden="false">
          <description>Any Mantis Warriors vehicle that is arriving from reserves may enter from either their normal deployment edge, or from the sides of the board on their controlling player&apos;s table half.</description>
        </rule>
        <rule name="Children of Prophecy" id="b324-3ed8-6a9e-f200" hidden="false">
          <description>Mantis Warriors have a Strategy Rating of 4 and may re-roll their dice to see who takes first turn.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Carcharodons" id="f1a1-0c19-d0b9-00bd" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="c846-07d6-e7b2-08ad" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Reavers of the Outer Dark" id="83d2-1b42-c640-83f0" hidden="false">
          <description>Opponents of Carcharodons receive an additional -1 Leadership modifier when resolving moral checks for losing melee.</description>
        </rule>
        <rule name="Blood Hunger" id="184d-6996-dcb8-75ab" hidden="false">
          <description>If a Carcharodons unit has won a combat, they must attack a sweeping advance. If for any reason the Carcharodons unit must consolidate (for example, Terminator armour), it must do so toward the nearest enemy model that they can see. 


In addition, any Carcharodons Space Marine or Scout may exchange their bolter for a bolt pistol and close combat weapon for no additional cost.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Exorcists" id="058a-e77a-e4a4-a523" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="d8dc-1928-bd7b-d448" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Hexagramatic Wards" id="ca36-66b4-52f9-12c1" hidden="false">
          <description>Every time an enemy psyker uses a power that targets an Exorcists Space Marine (but not Scouts, Scout Bikers, or vehicles) and requires a Psychic test, that unit can resist it by rolling a D6 and adding the highest Leadership value in the squad. The enemy psyker must roll equal to or higher on a D6 plus their own Leadership value to penetrate the psychic defenses. If the psyker rolls under the Exorcists total, the power fails. Note that the Exorcist cannot use both this special rule and the psychic hood on a single enemy power.</description>
        </rule>
        <rule name="Expanded Scout Cadre" id="c906-529d-4c7e-4819" hidden="false">
          <description>Due to extra companies of neophytes that the Exorcists keep, they are often deployed in larger formations even in open battle. 


Exorcist&apos;s Scout Squad may take up to an additional 10 Scouts at a reduced cost of 12 points per model. If numbering 15 or more models, a second scout may take a heavy weapon.</description>
        </rule>
        <rule name="Rumoured Ordo Malleus Connections" id="4b7d-2c14-4e75-46b5" hidden="false">
          <description>It is rumoured that the Exorcists maintain strong ties to the Ordo Malleus and often calls in favours or long forgotten blood-oaths if required.


Any character that has access to the Space Marine Armoury may also elect to purchase up to 30pts of items from the Codex: Daemon Hunters armoury counting as an Inquisitor, Inquisitory Lord and Grey Knight for selection purposes.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Fire Angels" id="ae28-4205-b154-1e6d" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="12df-9e8b-fbea-aa3c" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Armoured Might" id="2992-6b68-2fc3-adcb" hidden="false">
          <description>Fire Angels Rhino, Razorbacks, Predators, Vindicators and Whirlwinds cost 10 points less than normal.</description>
        </rule>
        <rule name="Crushing Treads" id="e1b8-09e0-944d-654c" hidden="false">
          <description>Enemy units taking Morale Checks caused by a Tank Shock roll 3D6 and choose the two highest. All Fire Angel vehicles front armour counts a 1 higher when an opponent attempts a Death and Glory attack.</description>
        </rule>
        <rule name="Main Battle Tanks" id="882f-bbc7-3122-c499" hidden="false">
          <description>The Fire Angels have access to a fourth Heavy Support Slot reserved for a Predator Destructor or Predator Annihilator.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Howling Griffons" id="5cf2-3b70-9fd5-518e" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="dc79-eb68-8d21-af73" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Into the Fray" id="fb41-46a6-4ed7-751c" hidden="false">
          <description>Any Howling Griffon model gains +1 Initiative for the Assault Phase in which they have charged. In addition, they gain +1&quot; of movement to any consolidation or sweeping advance rolls.</description>
        </rule>
        <rule name="Night World Camouflage" id="aba0-f2d9-54a0-7794" hidden="false">
          <description>If any Howling Griffons unit is painted appropriately they gain +1 to any cover save in missions using the Night Fighting special rules.</description>
        </rule>
        <rule name="The Bounty of Mancora" id="8466-302f-d1e4-9353" hidden="false">
          <description>A Howling Griffons army has a spare &quot;HQ&quot; slot (so 3 instead of the usual 2) available to it, but it must only be used for a Librarian or Howling Griffons Chief Librarian.</description>
        </rule>
        <rule name="Expanded Librarium" id="02b6-9e07-4bc8-e1b2" hidden="false">
          <description>Any Howling Griffons Librarian or Chief Librarian may elect to swap out Smite for the Quickening power.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Marines Errant" id="f948-e881-4bbb-7140" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="bc49-3a21-6165-a7cc" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="From the Void" id="d55a-5725-088a-94a1" hidden="false">
          <description>All Marines Errant Infantry that deploy from Deep Strike count as +1 BS on the turn they arrive. In addition, any Tactical, Veteran and Devastator Squads gain the Deep Strike rule for free. If any Independent Character joins one of these squads they also gain the rule, but must remain with the squad for the entire battle.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Minotaurs" id="b931-27cc-5a8c-b7e4" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="8d66-7109-9cbc-e2db" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Sanctioned Fratricide" id="c115-8f67-f02e-2664" hidden="false">
          <description>When targeting opposing Space Marines of any kind, all Minotaurs Space Marines may re-roll their failed to-hit rolls during the first round of any combat.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Novamarines" id="87ae-2d19-2103-537f" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="66e2-a19a-a884-d5ba" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Legacies of the Crusade" id="4fc2-f998-3cfb-3df7" hidden="false">
          <description>Any Dreadnought, Predator, Vindicator or Whirlwind can be upgraded to a War Relic at +10 points.


A Model upgraded to a War Relic ignores the first Glancing OR Penetrating hit it receives in a battle.


If a War Relic is destroyed, every Novamarines unit within 6&quot; must take a pinning test.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Raptors" id="f08f-ce2a-7d8a-b69b" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="a7b8-7319-9f06-b361" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Strike From the Shadows" id="c09c-96e3-f53d-b316" hidden="false">
          <description>Any Raptors Space Marine in Power or Artificer Armour (without a Jump Pack) has the Move Through Cover Veteran Skill at no additional cost.</description>
        </rule>
        <rule name="Scout Masters" id="5e36-6d2e-1a95-7831" hidden="false">
          <description>Any Raptors Space Marine Hero may replace their Power Armour for Carapace Armour (4+ Armour Save) and gain the Infiltrator Veteran Skill for free. They may also purchase a Sniper Rifle for +5pts.</description>
        </rule>
        <rule name="Legendary Marksmen" id="ea98-9f10-08c0-8ba4" hidden="false">
          <description>If a non-vehicle unit remains stationary, successful to-hit rolls of a 6 in the shooting phase automatically wound. This does not apply to pistol weapons, assault weapons, blast weapons, guess-range weapons, or rapid fire weapons firing twice.</description>
        </rule>
        <rule name="Heavy Reconnaissance" id="707c-6aa2-38c2-5ab3" hidden="false">
          <description>Any Veteran Sergeant or Veteran Space Marine Squad Member may replace their Bolter with a Sniper Rifle for no additional cost.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Sons of Medusa" id="ef26-a921-d2ef-db29" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="8d55-b0fb-6f4d-f49b" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="More Machine than Man" id="30aa-17a7-967a-a02c" hidden="false">
          <description>Sons of Medusa Characters and Veteran Sergeants may purchase bionics for half their usual cost.


In addition, any Sons of Medusa units consisting wholly of Infantry may be upgraded to have bionics for +3pts per model. If this is chosen the whole unit must be so upgraded (but Veteran Sergeants still pay the +5pts instead).</description>
        </rule>
        <rule name="Implacable Advance" id="8ff4-eda6-1799-80f2" hidden="false">
          <description>Sons of Medusa Space Marines may re-roll any Pinning check they are required to make, but may never make a sweeping advance after winning combat. They may only consolidate instead.</description>
        </rule>
        <rule name="The Chamber Ferrum" id="748d-fe12-fa8c-c13b" hidden="false">
          <description>Any model with access to the Space Marine Armoury may select Techmarine Only items in addition to what are normally allowed (exluding Servo-Arms for Jump Pack equipped models).</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Star Phantoms" id="80a0-9a53-e345-0687" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="f5ca-0531-3114-73d7" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Extensive Chapter Armoury" id="f187-3154-a200-cf36" hidden="false">
          <description>The Star Phantoms maintain a large and esoteric armoury, favoring melta and plasma weapons above all else. 


In a Star Phantoms army the following costs are used for the following weapons instead of the normal cost.


Plasma Pistol 12pts; Plasma Gun 5pts; Meltagun 8pts; Combi-Melta 12pts; Combi-Plasma 12pts.


In addition, Command Squads, Veteran Squads and Tactical Squads can replace a Lascannon with a Plasma Cannon or Multi-Melta for free.


Finally, all Melta and Plasma weapons are discounted by -5pts for Dreadnoughts and Devastator Squads.</description>
        </rule>
        <rule name="Hail of Destruction" id="b375-2ee5-0e65-f3b2" hidden="false">
          <description>One of the Star Phantoms core tenets are the gaining and maintaining of ranged superiority, even eschewing their otherwise staunch following the Codex Astartes to gain this advantage.


During the First Turn of the game, any unsaved wounds from Star Phantoms Heavy Weapons cause the target unit to take a Pinning Test.</description>
        </rule>
        <rule name="Orbital Wave Attack" id="4aa6-4108-bb3b-1f46" hidden="false">
          <description>Any Star Phantoms units deploying via deepstrike may choose to re-roll any reserve rolls of a 1. 


In addition, any Devastator Squads that arrive via Deepstrike may fire Heavy Weapons as if they hadn&apos;t moved, but with a Ballistic Skill of 2.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Red Scorpions" id="3fb6-a855-466f-b770" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="6c73-d9f4-91bf-1bc5" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Purity Above All Else" id="fe58-1ccf-8a4a-87b8" hidden="false">
          <description>Any Sergeant or Veteran Sergeant may purchase a Reductor and Narthecium as if they were an Apothecary.</description>
        </rule>
        <rule name="Fortitude and Contempt" id="b559-e4d9-0db6-a703" hidden="false">
          <description>Red Scorpion Space Marines may re-roll any failed Leadership test caused by taking Shooting Casualties and they may also re-roll any Pinning Checks they are required to take. However they always count their cover save as one less than usual (a 5+ cover save from being in a forest becomes a 6+, for instance) and can result in the loss of any cover save. Additionally, no Red Scorpion Space Marine can use the Infiltrators Veteran Skill.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Fire Hawks" id="3720-d7ec-3d56-b928" hidden="false">
      <infoLinks>
        <infoLink name="Drop Pods" id="59e0-1bc6-ab45-b8b2" hidden="false" targetId="e75a-c8bc-ad0d-01af" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="On Wings of Fire" id="913e-c162-df0a-eb56" hidden="false">
          <description>All Hand Flamer, Flamer, and Heavy Flamer attacks made by Fire Hawks are at +1 Strength on a turn in which they arrive from reserves.</description>
        </rule>
        <rule name="Panoply of Flame" id="8294-34bc-4f69-4662" hidden="false">
          <description>Any model that may usually take a heavy bolter may instead opt to take a heavy flamer at the same cost.


In addition to this, any model that may usually take a plasma pistol may instead choose to take a Hand Flamer for +5 pts.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Apothecary" id="25e1-76ae-f902-c820" hidden="false"/>
    <categoryEntry name="DW Command Squad" id="d99a-2923-e740-0464" hidden="true"/>
    <categoryEntry name="Jump Pack Techmarine" id="3428-2456-6ea8-2548" hidden="true">
      <comment>For Blood Angels</comment>
    </categoryEntry>
  </categoryEntries>
  <entryLinks>
    <entryLink name="Commander" id="42a3-487a-8d98-5c47" collective="false" hidden="false" import="true" targetId="043b-1cc7-9a38-8133" type="selectionEntry"/>
    <entryLink name="Force Commander" id="1659-1b68-f96c-07de" collective="false" hidden="false" import="true" targetId="27b5-cd84-8100-e413" type="selectionEntry"/>
    <entryLink name="Leader" id="f153-c5dc-554c-7c3d" collective="false" hidden="false" import="true" targetId="1bae-6fdc-fadc-4aa1" type="selectionEntry"/>
    <entryLink name="Librarian" id="225c-2985-99bd-95aa" collective="false" hidden="false" import="true" targetId="5338-cafe-fa14-f5d7" type="selectionEntry"/>
    <entryLink name="Chaplain" id="db22-57a8-7f98-9408" collective="false" hidden="false" import="true" targetId="45a7-a086-7339-c739" type="selectionEntry"/>
    <entryLink name="Land Raider" id="c7aa-bc62-8004-61f9" collective="false" hidden="false" import="true" targetId="0432-2db6-5eda-20d8" type="selectionEntry">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="021e-e53a-e7ae-18be" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
      </categoryLinks>
