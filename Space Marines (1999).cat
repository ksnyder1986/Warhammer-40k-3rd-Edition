    <selectionEntry name="Orbital Strike (IA)" id="9419-6303-5744-f2b2" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="118e-86f2-5b4e-3cb5" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="3261-6601-5bfe-f5d0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
        <modifier field="error" type="add" value="can only be taken when a Damocles Command Rhino is in the roster.">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="9419-6303-5744-f2b2" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
                <condition childId="56bf-16e9-79ee-abd3" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        <modifier field="error" type="add" value="cannot be taken at the same time as Imperial Navy Support.">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="9419-6303-5744-f2b2" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
                <condition childId="3e43-ec0f-64ff-daaa" field="selections" includeChildSelections="true" scope="force" shared="true" type="greaterThan" value="0"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup name="Strike" id="d064-40aa-7c75-089d" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="d75e-da63-9ffe-352e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="8c55-8b6c-10af-a1de" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <rules>
            <rule name="Plotting" id="927d-2e56-f581-a7ad" hidden="false">
              <description>The Orbital Strike must be keyed to a specific piece of terrain at the start of the battle. Make a note of the plotted target before forces are deployed but after deployment zones have been determined</description>
            </rule>
            <rule name="Timing" id="d44e-df6c-f95e-c152" hidden="false">
              <description>An orbital strike uses the Reserve special rule to determine when it strikes. Once the orbital strike passes the Reserve roll it fires each Space Marine shooting phases for the rest of the game. It cannot be stopped once started. The Space Marine player can opt to not roll for the onset of the orbital strike if they wish.</description>
            </rule>
            <rule name="Placement" id="dc29-7619-949f-8bc1" hidden="false">
              <description>The Ordnance Blast marker for the strike must be placed anywhere within the specified terrain piece</description>
            </rule>
            <rule name="Inaccuracy" id="a4ef-ff8b-b32c-5623" hidden="false">
              <description>An Orbital Strike scatters just like ordinary ordnance weapons, except when a miss is rolled the distance scatterd is double the number scored on the D6. If a hit is rolled, the template deviates by the distance shown on the Hit Symbol.</description>
            </rule>
            <rule name="Pinning" id="785d-9333-5372-b764" hidden="false">
              <description>All Orbital Strikes cause Pinning tests</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Lance Strike" id="0be5-6e22-c8de-a80e" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="70"/>
              </costs>
              <profiles>
                <profile name="Lance Strike" id="3b32-25fa-23c6-e7a4" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
