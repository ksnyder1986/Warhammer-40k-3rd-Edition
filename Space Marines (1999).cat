                <condition childId="5f4b-7f68-c2c9-adbf" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
                <condition childId="f95f-54de-870f-a05e" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
