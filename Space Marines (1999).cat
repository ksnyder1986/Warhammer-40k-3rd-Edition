      <rules>
        <rule name="Plasma Blaster" id="cc12-4bb3-4e14-5e9d" hidden="false" page="123" publicationId="26e5-ce39-9a6e-4817">
          <description>The Plasma Blaster is a combi-weapon that incorporates two plasma guns on a weapon mount suitable for replacing the storm bolter on a suit of terminator armour. The Plasma Blaster counts as a twin-linked plasma gun that always shoots as if Invictus is stationary.</description>
        </rule>
      </rules>
