    <selectionEntry name="Hyperious Air Defence Battery (IA)" id="fde5-3ce5-0c7a-820c" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="185c-cf39-577d-213e" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="3261-6601-5bfe-f5d0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Battery" id="21e9-0efc-b045-a446" hidden="false">
          <description>The platforms do not need to be deployed together, although each Hyperios platform must be less than 36&quot; from the command platform.</description>
        </rule>
        <rule name="Firing Mode" id="82d8-3330-5084-1855" hidden="false">
          <description>The battery is always set to Air Defense mode. When an incoming aircraft is detected the control console selects the nearest platforms and relays the targetting information. The Hyperios then activates, spins, tracks, and fires.</description>
        </rule>
        <rule name="Victory Points" id="a737-6d17-43a4-9439" hidden="false">
          <description>The Air Defense Battery cannot claim to occupy table quarters or objectives.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Command Platform" id="64ec-afc8-48cc-9f2c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e9cb-6215-e57e-9fb5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="21da-2a32-b853-9f02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
