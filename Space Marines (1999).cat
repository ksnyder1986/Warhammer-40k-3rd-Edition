        <infoLink name="Close Combat Weapon" id="1126-37ed-d828-d7ca" hidden="false" targetId="46d5-85f2-d932-f0a2" type="profile"/>
        <infoLink name="Frag Grenades" id="3b41-bbc3-7394-fc05" hidden="false" targetId="9dd4-e950-2419-5934" type="profile"/>
        <infoLink name="Melta Bombs" id="392b-10c7-c40f-6cd2" hidden="false" targetId="87d0-8c40-7bcb-8cbb" type="profile"/>
        <infoLink name="Master-crafted Weapons" id="fe89-6ea4-fd9c-766f" hidden="false" targetId="0e54-6618-9b31-0f81" type="rule"/>
        <infoLink name="Auspex" id="d50d-28a5-e9d1-a35e" hidden="false" targetId="00e2-88f3-119d-9df3" type="rule"/>
        <infoLink name="Teleport Homer" id="34ed-62e6-4bcf-9480" hidden="false" targetId="250f-507f-ea1b-b164" type="rule"/>
        <infoLink name="Stubborn" id="6379-9ec5-b6ad-72fe" hidden="false" targetId="1eb7-6961-7e16-d0b6" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Evade Detection" id="0fc9-c331-1785-66b7" hidden="false">
          <description>As long as Naaman and his unit didn&apos;t fire in the previous turn, any unit wanting to shoot at him or his unit must check to see if they can spot him first using the rules for Night Fighting. If the Night Fighting rules are already in effect then the normal spotting distances is halved.</description>
        </rule>
        <rule name="Brush Aside Blow" id="feab-81b7-440f-4960" hidden="false">
          <description>Naaman may ignore the first hit he suffers in any round of close combat.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Cursed Founding Chapter Trait" id="2d90-f1cd-cb02-4881" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="6419-cf4a-754f-c9d8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="5f74-5b1f-6338-274b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <selectionEntryGroups>
        <selectionEntryGroup name="Chapter Traits" id="8169-5175-e8c0-daa3" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="5dd6-81f2-1a3b-f347" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="b255-a112-425b-fd4f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Ossific Blades" id="de30-a151-25ec-ed7a" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
              </costs>
              <rules>
                <rule name="Ossific Blades" id="61dc-83f6-b39e-d5fe" hidden="false">
                  <description>Any hit rolls of 6 in close combat inflicts an automatic wound with no Armor Saves possible</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Berserkers" id="15c3-ec03-9025-925c" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
              </costs>
              <rules>
                <rule name="Berserkers" id="ff3e-9df3-45f7-ff76" hidden="false">
                  <description>-All models gain +1 Attack and pass all Morale and Pinning tests.








-Must also Assault the nearest enemy in range at the start of their Assault Phase








-Must Sweeping Advance on successful Assault unless wearing Terminator Armor or having &quot;moral high ground&quot;</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Apparitions" id="4ddc-8876-f834-c73d" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
              </costs>
              <rules>
                <rule name="Apparitions" id="62e4-02fb-e74d-dadd" hidden="false">
                  <description>Always deploys in Deep Strike before the game begins. May be set up anywhere on the battlefield not within the opponent&apos;s deployment zone.








Infantry and Vehicles also receive a 6+ Invulnerable Save.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Aura of Doom" id="ede0-0b37-8811-4023" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
              </costs>
              <rules>
                <rule name="Aura of Doom" id="a268-52cf-8ee3-1ae3" hidden="false">
                  <description>Assaulting enemies must take a Leadership test. Units who automatically pass Morale checks do not test.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Immolation" id="919e-2da6-2f65-7175" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
              </costs>
              <rules>
                <rule name="Immolation" id="a6d9-55df-a73a-a51d" hidden="false">
                  <description>Always receives a 5+ Cover Save from enemy shooting and always counts as in cover when being charged by the enemy.




No units other than Cursed Knights may take or enter a transport</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Augmented Skeleton" id="911a-793b-d817-c409" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
              </costs>
              <rules>
                <rule name="Augmented Skeleton" id="34b6-6975-cc0c-ff3d" hidden="false">
                  <description>Every model gains +1 Toughness</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Stormraven Gunship (Homebrew)" id="fb33-3e36-b9a7-679d" collective="false" hidden="false" import="true" type="unit">
      <comment>Based on vehicle design rules and 7th edition stats

Skimmer-Normal
Points for Armour:
Front 12 = 10
Side 11 = 30
Rear 10 = 10
Armour &lt; 46 = 10
Normal Speed = 10
Skimmer = 20

Transport = 12</comment>
      <categoryLinks>
        <categoryLink name="Heavy Support" id="4d80-95e7-1cbe-1da1" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="102"/>
