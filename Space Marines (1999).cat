                <condition childId="1bae-6fdc-fadc-4aa1" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
                <condition childId="043b-1cc7-9a38-8133" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
