          <description>Units in drop pods are always in Reserve, even in missions that do not normally allow reserves to be used</description>
        </rule>
        <rule name="Drop Pod Deployment" id="bb02-b5bd-8249-4eb3" hidden="false">
          <description>See 1st Edition Imperial Armour v2</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Deathwind Drop Pod (IA)" id="9470-3822-9925-43d2" collective="false" hidden="false" import="true" type="model">
