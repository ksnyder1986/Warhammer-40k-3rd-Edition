        <rule name="Stormraven Gunship (Homebrew)" id="2b31-c6e9-afdc-5f33" hidden="false">
          <description>Based on the vehicle design rules in Chapter Approved 2004. The vehicle is a Fast Skimmer with a transport capacity of 12 models or 1 dreadnought.</description>
