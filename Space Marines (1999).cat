          </infoLinks>
        </selectionEntry>
        <selectionEntry name="Hyperios Platform" id="74f8-241c-210b-ed40" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a268-ea8e-5594-0b78" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="4"/>
            <constraint id="81e3-30ac-e4fc-6ffc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="35"/>
          </costs>
          <infoLinks>
            <infoLink name="Weapon Plaform" id="90dc-dabb-5d4d-743c" hidden="false" targetId="a6bb-7a68-e3e4-d388" type="profile">
              <modifiers>
                <modifier field="b109-f88e-dcc7-8a24" type="set" value="2"/>
              </modifiers>
            </infoLink>
            <infoLink name="Immobile" id="56b9-ca13-b250-113f" hidden="false" targetId="de3d-c21c-3d4f-5259" type="rule"/>
            <infoLink name="Hyperios Ant-Aircraft Missiles" id="d9c9-e427-7cdc-637a" hidden="false" targetId="beb4-876e-921a-2c8f" type="profile"/>
          </infoLinks>
          <rules>
            <rule name="Anti Air" id="debe-94ce-59cc-73ee" hidden="false">
              <description>May fire at aircraft using normal BS</description>
            </rule>
            <rule name="Targeting" id="e455-32f8-4894-55bf" hidden="false">
              <description>A Hyperious platform will fire a single missile in its own Shooting phase at any enemy aircraft whose flight path takes it within 36&quot; of a platform. If the aircraft&apos;s flight path takes it within 36&quot; of multiple platforms then each plaform will fire a single missile.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Veteran Sergeant Naaman" id="fe78-3d4d-5e3b-9e66" collective="false" hidden="false" import="true" type="model">
      <categoryLinks>
        <categoryLink name="Dark Angel" id="800f-e4d6-c6b9-b727" hidden="false" primary="false" targetId="a0a1-0673-b637-2cc4"/>
      </categoryLinks>
      <constraints>
        <constraint id="e556-520c-6a65-f3bd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="f66c-1408-cec0-96d3" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
