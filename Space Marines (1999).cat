              <conditions>
                <condition childId="71f1-cbf9-c4ed-47ac" childName="Relictor" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Grimoire Pandaemonica" id="f6d3-4170-c27c-ce89" hidden="false">
              <description>The bearer of the Grimoiro Pandaemonica may force his opponent to reroll a single Daemonic Possession or a single Daemonic Summoning roll each game turn.</description>
            </rule>
          </rules>
        </selectionEntry>
