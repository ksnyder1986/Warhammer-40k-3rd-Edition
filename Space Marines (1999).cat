          </costs>
          <rules>
            <rule name="AA" id="c660-b97f-044d-2573" hidden="false">
              <description>The Lascannon may fire at aircraft using its normal BS</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
