          </costs>
          <rules>
            <rule name="Holy Relic" id="a8ff-44af-73dd-e24a" hidden="false">
              <description>Once per game the relic may be activated to grant all Adeptus Mechanicus within 2D6&quot; to gain +1 Attack for the rest of the turn. Note it may be activated during the enemy&apos;s turn.</description>
            </rule>
          </rules>
