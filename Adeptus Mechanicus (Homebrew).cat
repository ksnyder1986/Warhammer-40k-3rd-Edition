    <selectionEntryGroup name="Wargear" id="f1e6-9c47-7479-2f26" collapsible="true" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Artificer Armour" id="b139-02d0-1e3a-bfd9" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f59b-3a16-7e77-e2f4" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
