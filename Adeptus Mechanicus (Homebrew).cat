        <selectionEntry name="Holy Relic" id="0692-d8b4-6c9e-0b7b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0cb1-2f55-86d9-8fa3" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
