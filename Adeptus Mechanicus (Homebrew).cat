        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignores all armour saves. Rolls 2D6 + Strength when penetrating armour.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Night Fighters" id="4977-91af-d68c-cba0" hidden="false">
      <description>The crew may re-roll the dice when rolling to determine how far they can see in a Night Fight scenario. You must abide by the re-roll result even if it is worse.</description>
    </rule>
    <rule name="Sharpshooters" id="1a82-7408-f1a7-5ccb" hidden="false">
      <description>Any Guard infantry model with a BS 3 may re-roll to hit rolls of 1. May not be used on Plasma weapons or Sniper Rifles.</description>
    </rule>
    <rule name="Cyber-Enhancement" id="9786-4169-1cd4-91c9" hidden="false">
      <description>Gain invulnerable save of 6+</description>
    </rule>
    <rule name="Carapace Armor" id="bd6b-cb61-1e31-6813" hidden="false">
      <description>4+ Armour Save</description>
    </rule>
    <rule name="Chem-inhaler" id="f958-be95-5a44-3f15" hidden="false">
      <description>The unit will always test Morale, Leadership or Pinning with no negative modifiers. If they fail a Morale check for 25% shooting casualties, they will be pinned rather than fall back.</description>
    </rule>
    <rule name="Immune to Instant Death" id="4c28-c3fd-1612-78c7" hidden="false">
      <description>If impacted by any ability that would outright kill the model, instead only lose 1 wound.</description>
    </rule>
  </sharedRules>
