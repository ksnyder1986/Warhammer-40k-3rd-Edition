  <sharedInfoGroups>
    <infoGroup name="Death Korp" id="5d26-34e9-9386-7dc0" hidden="false">
      <infoLinks>
        <infoLink name="Death Before Dishonour" id="2e8c-3860-ce94-5170" hidden="false" targetId="c9cc-854b-30e2-0c2c" type="rule"/>
        <infoLink name="Hardened Fighters" id="422e-9f05-0f1c-845a" hidden="false" targetId="d5f7-46ce-8768-3e81" type="rule"/>
      </infoLinks>
    </infoGroup>
  </sharedInfoGroups>
  <sharedRules>
    <rule name="Hardened Fighters" id="d5f7-46ce-8768-3e81" hidden="false">
      <description>The Death Korp may ignore negative modifiers for Morale checks and tests for regrouping.</description>
    </rule>
    <rule name="Death Before Dishonour" id="c9cc-854b-30e2-0c2c" hidden="false">
      <description>Death Korp troops are Fearless in close combat, automatically passing any Morale checks they are required to make, and will carry on fighting until they have beaten their foes or until they are all dead. Additionally, the must Sweeping Advance after an enemy that falls back.</description>
    </rule>
  </sharedRules>
