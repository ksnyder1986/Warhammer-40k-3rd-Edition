        <infoLink name="Master of the Ravenwing" id="54fe-a4ae-352d-4921" hidden="false" targetId="f70b-a5e5-2a3f-0b9e" type="profile"/>
        <infoLink name="Jink" id="49d1-c63a-1677-6515" hidden="false" targetId="d569-9632-c94f-3fa3" type="rule"/>
