      <rules>
        <rule name="Master Interrogator" id="d972-0f22-6c09-292d" hidden="false">
          <description>Roll 2D6 for the number of victory points Asmodai earns for each captured prisoner when using the Blades of Reason.</description>
        </rule>
        <rule name="Fearful Reputation" id="8842-111e-605f-9413" hidden="false">
          <description>Any enemy unit with a model within 16&quot; of Asmodai suffers a -1 modifier on any Morale checks they must take.</description>
        </rule>
      </rules>
