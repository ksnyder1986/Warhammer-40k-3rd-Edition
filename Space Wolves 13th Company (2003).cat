      </categoryLinks>
      <constraints>
        <constraint id="ef61-102e-0179-4c85" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <infoLinks>
        <infoLink name="Scouts" id="992a-203a-8505-4eaa" hidden="false" targetId="8979-e442-986d-39d3" type="rule"/>
        <infoLink name="Move through Cover" id="b995-3764-a5a1-026e" hidden="false" targetId="46ba-a84f-a9b8-e0a1" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Wolf Priest" id="b644-fafd-eeb8-da38" hidden="false">
          <description>If a Wold Priest joins a Wulfen pack, you may choose whether or not it is subject to the Animal Rage rule each turn, so long as the Wolf Priest is with the pack. If the pack moves due to the Animal Rage rule, the Wolf Priest will move with them, but may not fire any weapons in the Shooting phase. A Wolf Priest may not take the Mark of the Wulfen.</description>
        </rule>
      </rules>
    </entryLink>
