      </infoLinks>
      <rules>
        <rule name="Animal Rage" id="6b42-9a45-2001-a488" hidden="false">
          <description>At the beginning of the 13th Company Movement phase, each Wulfen pack must advance a normal move + D6&quot; towards the nearest enemy instead of moving normally. The extra D6&quot; is not affected by difficult terrain.</description>
        </rule>
      </rules>
