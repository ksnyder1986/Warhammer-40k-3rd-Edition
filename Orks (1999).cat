    <selectionEntry name="Battle Fortress (IA)" id="e2e8-e321-6af7-930b" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Super-Heavy" id="7390-7e76-6d15-df61" hidden="false" primary="true" targetId="6b90-dc9c-1a49-3fdc"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="325"/>
      </costs>
      <entryLinks>
        <entryLink name="Ork Vehicle Upgrades" id="3921-e323-d8b0-af89" collective="false" hidden="false" import="true" sortIndex="4" targetId="7ab0-3a69-56f8-540b" type="selectionEntryGroup"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Battle Fortress" id="2410-e412-b415-844f" hidden="false" targetId="9388-8c78-ce61-689c" type="profile"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="3261-6601-5bfe-f5d0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Lumbering" id="5718-1065-8748-b598" hidden="false">
          <description>Can move up to 6&quot; per turn and it must always move straight ahead. It can pivot up to 90 degrees at the end of the move.</description>
        </rule>
        <rule name="Difficult Terrain" id="6bc0-ad77-3274-ae9c" hidden="false">
          <description>The vehicle ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal. However, if they roll a 1 they are not immobilised, but instead lose D3&quot; of movement.</description>
        </rule>
        <rule name="Targeting" id="4918-d737-8658-b939" hidden="false">
          <description>Instead of picking one target, pick a target for each of its weapons</description>
        </rule>
        <rule name="Tank Shock" id="7e7f-2828-a657-c2e8" hidden="false">
          <description>Enemy infantry test at -1 to their Leadership if they are Tank Shocked by a Battle Fortress</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Bolt-on Big Shootas" id="09a6-d50c-c027-6098" collective="false" hidden="false" import="true" sortIndex="2" type="upgrade">
          <constraints>
            <constraint id="af57-b743-6037-fdd4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="5"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <infoLinks>
            <infoLink name="Big Shoota" id="bdfd-07e0-ac57-2a42" hidden="false" targetId="b467-e518-11c9-c23a" type="profile">
              <modifiers>
                <modifier field="name" type="set" value="Bolt-on Big Shoota"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <rules>
            <rule name="Bolt-on Big Shootas" id="c8bb-7695-756e-7bb2" hidden="false">
              <description>These weapons must be fired by the Ork mob onboard.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Krusher (IA)" id="c3be-a758-856d-132f" collective="false" hidden="false" import="true" sortIndex="4" type="upgrade">
          <constraints>
            <constraint id="e3a6-0077-1959-88e9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
          </costs>
          <rules>
            <rule name="Krusher (IA)" id="6993-e3cb-2b06-a0d7" hidden="false">
              <description>If the Battlewagon makes a Tank Shock attack on an enemy unit and the enemy don&apos;t fall back, then roll a D6 for each model forced to move out of the way of the vehicle. On a 4+ they are caught and crushed, and suffer a wound with normal armour saves allowed.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
