        </modifier>
      </modifiers>
      <rules>
        <rule name="Transport" id="64bb-3ebd-a651-5a30" hidden="false">
          <description>A Squiggoth may carry up to 10 Orks in the howdah. Orks being transported may leave the Squiggoth as if they were exiting an open-topped vehicle.</description>
        </rule>
        <rule name="Monstrous Creature" id="cbf3-605a-d567-e85b" hidden="false">
          <description>Rolls 2D6 for vehicle armour penetration and ignores armour saving throws.</description>
        </rule>
      </rules>
