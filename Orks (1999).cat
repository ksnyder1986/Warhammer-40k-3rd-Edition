          <rules>
            <rule name="Kustom Force Field" id="e85d-7c11-4d82-a137" hidden="false">
              <description>Kustom Force Fields provides a 5+ cover saving throw to all models with 6&quot;. All vehicles with 6&quot; are treated as being hull down. The force field has no effect in close combat or against shooting within 6&quot; of the operator.</description>
            </rule>
