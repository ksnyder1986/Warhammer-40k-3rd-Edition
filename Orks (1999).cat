          </modifiers>
          <rules>
            <rule name="&apos;Urty Syringe" id="7ca3-7c2d-8ba8-86aa" hidden="false">
              <description>A Mad Dok (or Painboss) armed with a &apos;urty syringe always wounds on a 4+ regardless of the victim&apos;s Toughness. &apos;Urty syringes have no effect on vehicles, Tyranids, Daemons, Eldar Wraithguard or the Eldar Avatar.</description>
            </rule>
          </rules>
        </selectionEntry>
