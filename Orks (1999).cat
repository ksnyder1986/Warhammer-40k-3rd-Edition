          <infoLinks>
            <infoLink name="Invulnerable Saving Throw" id="1c6e-30dd-b07d-d6db" hidden="false" targetId="97b3-810d-a09e-872b" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Cybork Body" id="4a4c-a773-bf77-c55f" hidden="false">
              <description>An Ork with a Cybork Body has a 5+ Invulnerable Saving Throw.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Bionic Bonce" id="9683-c025-4671-f49c" collective="false" hidden="false" import="true" sortIndex="1" type="upgrade">
          <constraints>
            <constraint id="96af-9786-606c-17c1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="e1d5-99b0-4452-dfd4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
          </costs>
          <rules>
            <rule name="Bionik Bonce" id="dd6f-15f8-bdca-16fe" hidden="false">
              <description>An Ork with a bionik bonce adds +1 to its armor saving throw.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Bionik Arm" id="ecc3-4fa1-0c46-36ee" collective="false" hidden="false" import="true" sortIndex="2" type="upgrade">
          <constraints>
            <constraint id="0116-0e20-195e-5470" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="b3ef-acc0-26b2-9214" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
          </costs>
          <rules>
            <rule name="Bionik Arm" id="2387-3be4-2857-0335" hidden="false">
              <description>An Ork with a Bionik Arm causes one automatic S4 hit in close combat at Initiative 6, but only if in base-to-base contact with the target. It also counts as an additional close combat weapon.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Dok&apos;s Tools" id="0638-5dce-1f96-beec" collective="false" hidden="false" import="true" sortIndex="4" type="upgrade">
          <constraints>
            <constraint id="eb3f-7fae-79e8-26a7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="887e-b20d-cbb4-8528" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
          </costs>
          <rules>
            <rule name="Dok&apos;s Tools" id="356b-99e6-7e57-4242" hidden="false">
              <description>Once per turn at the end of the enemy&apos;s shooting phase a Mad Dok with Dok&apos;s Tools may attempt to &quot;heal&quot; a wounded or killed model. Roll a D6. On a 1 the Ork suffers 1 wound and if reduced to zero wounds is removed as a casualty. On a 2-5 there is no effect. On a 6 the Ork regains 1 wound up to the maximum it started the game with.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
