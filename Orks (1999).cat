          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1518-7a1b-daac-0172" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notEqualTo" value="1"/>
              </conditions>
            </modifier>
            <modifier field="4ed5-2f92-9abc-2870" type="increment" value="5">
              <conditions>
                <condition childId="838f-024c-52e0-08f2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Mega Boosta" id="8ca3-abc6-30b0-e0df" hidden="false">
              <description>An Ork with Mega Boostas rerolls the dice to determine the distance they move when they are wearing Mega Armor. If a unit of Orks in Mega Armor includes some with Mega Boosters and some without, only the ones with Mega Boosters will gain the benefit of the re-roll while the others move the original distance rolled.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Mekboy&apos;s Tools" id="ae8f-ac13-375a-f10c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e61c-ef10-b8df-39a5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="2"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="fdd0-6bc8-710f-4b77" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                    <condition childId="b4e1-5f13-9303-52ad" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier field="4ed5-2f92-9abc-2870" type="increment" value="5">
              <conditions>
                <condition childId="838f-024c-52e0-08f2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Mekboy&apos;s Tools" id="c8f3-91f0-a6d4-7a26" hidden="false">
              <description>A Mekboy equipped with Mekboy&apos;s Tools can attempt to repair a vehicle which has suffered an &quot;Immobilised&quot; or &quot;Weapon Destroyed&quot; damage result, or to fix a Big Gun that has been destroyed. If the Mekboy is in base-to-base contact with the vehicle or Big Gun at the end of his movement phase roll a D6. On a 1 the repair fails and the vehicle or Big Gun may not be repaired for the rest of the game. On a 2-5 the Mekboy fails the repair. On a 6 the repair succeeds and the Vehicle&apos;s weapon is fixed, or it is no longer immobilized, or a Big Gun is fixed.</description>
            </rule>
          </rules>
        </selectionEntry>
