            </modifier>
          </modifiers>
          <rules>
            <rule name="Super Stikkbombz" id="d7b7-0ea4-ebd7-070c" hidden="false">
              <description>Super Stikkbombz work just like krak stikkbombz but have a armor penetration roll of 10+2D6. On a roll of double ones the attack is resolved like normal but the Mekboy using them sufffers a wound that may attempt to be saved as normal.</description>
            </rule>
          </rules>
