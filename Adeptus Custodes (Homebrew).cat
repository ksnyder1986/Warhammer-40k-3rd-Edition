          </costs>
          <rules>
            <rule name="AA" id="0191-96dc-901d-cf11" hidden="false">
              <description>The Lascannon may fire at aircraft using its normal BS</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
