          <selectionEntries>
            <selectionEntry name="Auspex" id="de1d-844a-eb8b-1c72" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="506a-8c3a-2f7d-f9fc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="2"/>
              </costs>
              <rules>
                <rule name="Auspex" id="2b3e-53d2-2576-e2e2" hidden="false">
                  <description>If enemy infiltrators set up within 4D6&quot; of a model with a auspex, then that model and the unit they are attached to is allowed to take a &quot;free&quot; shot at them. These shots are taken before the battle begins and may cause the infiltrators to fall back.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Bionics" id="89de-97b8-eccb-0897" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="50d0-c319-a920-aeac" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10"/>
              </costs>
              <rules>
                <rule name="Bionics" id="b5a7-4bcf-6e0f-d14f" hidden="false">
                  <description>When a model with bionics is killed, instead place it on its side. Roll a D6 at the start of the next turn: on a roll of 6 the model stands back up with 1 wound, but on any other roll it is removed as a casualty.</description>
                </rule>
              </rules>
            </selectionEntry>
