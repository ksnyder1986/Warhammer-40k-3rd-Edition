                      </conditions>
                    </modifier>
                  </modifiers>
                  <rules>
                    <rule name="Power Lance" id="18bc-6b80-6181-7de8" hidden="false">
                      <description>The power lance grants +1 Initiative to any bike-mounted model that is charging or counter-attacking. Once an opponent gets inside their guard though, the improved weapon length becomes a disadvantage and they get a -1 Initative when they aren&apos;t charging or counter-attacking.</description>
                    </rule>
                  </rules>
