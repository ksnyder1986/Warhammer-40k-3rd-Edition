        <modifier field="error" type="add" value="Army cannot have both Nurgle and Tzeentch daemons">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="3c65-a03d-6aaf-f716" field="selections" scope="force" shared="true" type="atLeast" value="1"/>
                <condition childId="809b-d2b0-3687-745d" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="equalTo" value="0"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Foresight" id="af48-b1c3-e001-9454" hidden="false">
          <description>Fateweaver’s prophetic powers warns him of the enemy’s movements, allow him to direct the daemonic fire of Tzeentch daemons. This psychic power is used at the start of the Daemons of Chaos player’s turn. Nominate one Daemon unit within 6” of Fateweaver (including himself). This unit may re-roll any missed shooting to hit rolls until the start of the next Eldar turn. If the unit is using a weapon that scatters, the Scatter dice may be re-rolled if a ‘hit’ is not scored on the first roll.</description>
        </rule>
        <rule name="Omniscience" id="3de0-66cd-78a7-2f71" hidden="false">
          <description>Fateweaver scries all possible futures to see where his foes will attack. This psychic power is used at the start of the Daemons of Chaos player’s turn. Nominate one Daemon unit with a model within 6” of Fateweaver (including himself). This unit may re-roll any failed armour saves until the start of the next Daemons of Chaos turn.</description>
        </rule>
        <rule name="Master of the Warp" id="a030-5a7a-e2b7-a187" hidden="false">
          <description>Fateweaver may cast two psychic powers per turn instead of the normal limit of one.</description>
        </rule>
        <rule name="Oracle of Tzeentch" id="4fde-f3bc-0c48-cc46" hidden="false">
          <description>Fateweaver automatically passes all psychic tests they would required to take.</description>
        </rule>
      </rules>
    </selectionEntry>
