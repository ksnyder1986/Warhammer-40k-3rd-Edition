        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignore armour saves. Gain +D6 attacks. Only gain 1 Attack if all attacks are against a single model.</characteristic>
      </characteristics>
    </profile>
    <profile name="Plague Sword" id="eb1b-a0c2-7750-192f" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignore armour saves.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pandemic Staff" id="1c7f-e77b-bb9d-57c7" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">12&quot;</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">3</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">-</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Assault 1</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Each model in the target unit is hit on a roll of 4+</characteristic>
      </characteristics>
    </profile>
    <profile name="Needle of Desire" id="f792-fb53-1064-e5d7" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">2+</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">-</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2"/>
      </characteristics>
    </profile>
    <profile name="Kai Gun" id="a4ee-47d2-7f18-f17c" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">24&quot;</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">6</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">3</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Assault 2</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2"/>
      </characteristics>
    </profile>
    <profile name="Ether Lance" id="8da2-95db-5bb2-f37d" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Template</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">4</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">3</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Assault 1</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2"/>
      </characteristics>
    </profile>
    <profile name="Dreadaxe" id="424a-87c1-af11-13f0" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">As User or 4+</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">-</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignores invulnerable saves (but not armour saves). Never wounds on worse than a 4+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dark Blade" id="1505-1645-e6fd-458b" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">User +2</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignores armour saves</characteristic>
      </characteristics>
    </profile>
    <profile name="Bedlam Staff" id="3e98-2df7-cc10-6259" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignore armour saves</characteristic>
      </characteristics>
    </profile>
    <profile name="Warp Blade" id="8739-98c5-5f80-7bc2" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignore armour saves</characteristic>
      </characteristics>
    </profile>
    <profile name="Fateweaver" id="cab5-d06c-84e2-823e" hidden="false" typeId="1e16-2bd8-7cad-379b" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="c704-6128-f143-935a">3</characteristic>
        <characteristic name="BS" typeId="7928-3a9b-6080-ed95">6</characteristic>
        <characteristic name="S" typeId="df03-6292-d3f5-f778">5</characteristic>
        <characteristic name="T" typeId="e5f6-94c4-de8c-5fa8">5</characteristic>
        <characteristic name="W" typeId="4dc2-c603-0bc5-0561">4</characteristic>
        <characteristic name="I" typeId="eeda-4fb4-901e-b70d">5</characteristic>
        <characteristic name="A" typeId="abbf-0d11-fd86-d938">3</characteristic>
        <characteristic name="Ld" typeId="f47e-b15a-8f58-703c">10</characteristic>
        <characteristic name="Sv" typeId="b309-5233-122f-82bb">3+/5+</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Instability" id="2a8b-66d0-f877-0590" hidden="false">
      <description>Any time a Daemon unit takes a Morale check the unit suffers one wound for each point they failed the Morale check by.</description>
    </rule>
    <rule name="Summoned" id="e7c2-4a6f-5a30-723f" hidden="false">
      <description>Must be summoned from a chaos icon matching their alignment.</description>
    </rule>
    <rule name="Favoured by Khorne" id="ca89-b5bf-b2e4-7aa7" hidden="false">
      <description>A daemon unit of 8 or 16 models may receive a +1 on the summoning dice.</description>
    </rule>
    <rule name="Favoured by Nurgle" id="6ad3-86ea-9970-e0f2" hidden="false">
      <description>A daemon unit of 7 or 14 models may receive a +1 on the summoning dice.</description>
    </rule>
    <rule name="Favoured by Slaanesh" id="c9d6-5fd0-f797-2c69" hidden="false">
      <description>A daemon unit of 6, 12 or 18 models may receive a +1 on the summoning dice.</description>
    </rule>
    <rule name="Favoured by Tzeentch" id="b7fa-51f4-c230-8eda" hidden="false">
      <description>A daemon unit of 9 or 18 models may receive a +1 on the summoning dice.</description>
    </rule>
    <rule name="Invulnerable" id="161c-524a-0ed3-10be" hidden="false">
      <description>The Daemon has a 5+ invulnerable save.</description>
    </rule>
    <rule name="Daemonic Flight" id="51ae-ffd1-6467-ee83" hidden="false">
      <description>Gain the Jump Pack rule</description>
    </rule>
    <rule name="Daemonic Visage" id="3170-8915-888b-0973" hidden="false">
      <description>Models that lose close combat against this model take the morale test at -1 Ld. If the model is a Greater Daemon the test is -2 Ld instead.</description>
    </rule>
    <rule name="Daemonic Talons" id="f9b7-25cc-e7bd-6c85" hidden="false">
      <description>Any rolls to hit of a 6 causes an automatic wound with no armour saves allowed. Against vehicles, a roll of 6 allows the model to roll an addtional dice to determine the total Armour Penetration score.</description>
    </rule>
    <rule name="Warp Scream" id="dae6-60ce-da79-5a84" hidden="false">
      <description>Models attacking a model with this ability has their Initiative reduced by 1 to a minimum of 1.</description>
    </rule>
    <rule name="Collar of Khorne" id="2ff1-9193-31cc-91a5" hidden="false">
      <description>Force weapons lose their special rule against the bearer, and any psychic abilities that target the wearer or include him in their area of effect are nullified on a D6 roll of 2+</description>
    </rule>
    <rule name="Living Icons" id="259b-b868-1be6-f879" hidden="false">
      <description>This unit can be used as icons for the purposes of summoning daemons aligned to the same God.</description>
    </rule>
    <rule name="Nurgle&apos;s Rot" id="db9f-404e-be5e-0c3e" hidden="false">
      <description>Any model within 6&quot; of a model with Nurgle&apos;s Rot must roll a D6 at the end of the Chaos Shooting phase. On a roll of 6 the unit takes a wound, with armour and invulnerable saves as normal.</description>
    </rule>
    <rule name="Nurgling Infestation" id="6a65-c84e-7dde-2ad3" hidden="false">
      <description>If the model is in close combat the Nurglings make an extra D6 S3 I3 attacks.</description>
    </rule>
    <rule name="Pink Fire of Tzeentch" id="6c64-da41-4845-6b26" hidden="false">
      <description>During the Chaos player&apos;s shooting phase, instead of using their normal weapons they make an attack as if they had the Daemonic Fire gift</description>
    </rule>
    <rule name="Psychic Duel" id="5587-e1b2-72d8-0bf3" hidden="false">
      <description>During the Chaos player&apos;s shooting phase, choose one enemy psyker on the battlefield. That psyker will be at -1 Leadership for Psychic tests for the next player turn. This Modifier is cumulative with the Talisman of Tzeentch.</description>
    </rule>
    <rule name="Reckoning of Tzeentch" id="b7b4-8d20-1108-c4fa" hidden="false">
      <description>During the Chaos player&apos;s shooting phase, the psyker and any squad he is accompanied by may re-roll missed to hit rolls this shooting phase.</description>
    </rule>
    <rule name="Tzeentch Minor Psyker Powers" id="5ad4-5b0e-a4cd-1414" hidden="false">
      <description>1. No usable power
2. Pink Fire of Tzeentch
3. Psychic Duel
4. Reckoning of Tzeentch
5. Weaver of Fates
6. Withering Gaze</description>
    </rule>
    <rule name="Weaver of Fates" id="1c23-e807-3be7-bca0" hidden="false">
      <description>At the start of the battle, the Tzeentch player&apos;s strategy rating is 3.</description>
    </rule>
    <rule name="Withering Gaze" id="57b9-8bb5-8d1b-7b18" hidden="false">
      <description>During the enemy&apos;s assault phase, an enemy model or unit that wishes to assault the psyker or a unit he has joined must pass a Leadership test to succeed. If the test is failed the enemy model or unit may choose an alternative target if one is in range. Units which ignore or automatically pass Morale checks are unaffected by this power and the psyker cannot use this power if already in a melee.</description>
    </rule>
    <rule name="The Twisting Path" id="1b4b-6e58-4224-72ce" hidden="false">
      <description>This power is used in the Shooting Phase, has a range of 12&quot; and requires LOS. The target unit makes a Leadership test and if they fail they are pinned until the start of the next Chaos turn.
Additionally, earn 50 Victory Points each time this power succeeds, but only earn these Victory Points once from any unit.</description>
    </rule>
    <rule name="Touch of Slaanesh" id="d144-ca63-f8cb-e7fd" hidden="false">
      <description>During the Chaos player&apos;s assault phase, after a successful psychic test, all enemy models in base contact with the psyker suffer a -1 WS penalty (to a minimum of 1) for the remainder of the phase.</description>
    </rule>
    <rule name="Slaanesh Minor Psyker Powers" id="19e6-7492-269d-43f1" hidden="false">
      <description>1. No usable power
2. Fuelled by Pain
3. Siren
4. Beam of Slaanesh
5. Touch of Slaanesh
6. She Who Thirsts</description>
    </rule>
    <rule name="Siren" id="7931-1451-54da-d4e9" hidden="false">
      <description>Usable by a Sorceror that has no joined a unit or is part of a unit. During the enemy&apos;s shooting or assault phase, after passing a successful psychic test, the Sorceror may not be targeted by shooting attacks or assaults this turn. This power cannot be used if the Sorceror is already is base contact with an enemy model.</description>
    </rule>
    <rule name="She Who Thirsts" id="646e-aa42-8a53-cabe" hidden="false">
      <description>During the Chaos player&apos;s assault phase, after a successful psychic test, if the psyker has killed one or more enemy models this phase then the unit or units they belonged to will be at -1 Leadership if they lose the combat and take a Morale check.</description>
    </rule>
    <rule name="Fuelled by Pain" id="11da-3914-8f7f-8d19" hidden="false">
      <description>Always active. For every close combat attack the wounds the psyker, but is stopped by his Armour save, he may make an additional attack after all other attacks have been resolved but before combat results are determined.</description>
    </rule>
    <rule name="Beam of Slaanesh" id="396c-0795-57a9-0d30" hidden="false">
      <description>During the enemy shooting phase, choose a target within 18&quot;. On a successful psychic test the target model or unit must pass a Leadership Test or it counts as having moved for the purposes of determining which weapons can fire.</description>
    </rule>
    <rule name="Affliction" id="085f-403c-f3e8-cbec" hidden="false">
      <description>Affliction: The psyker attempts to target an independent character or single model within a unit (the target player chooses the model). If you roll over the victim&apos;s Toughness on a D6, or a roll of 6 regardless of Toughness, then the target model takes a single wound with normal saves allowed.</description>
    </rule>
    <rule name="Aura of Decay" id="0208-5ee1-c2e1-8ab1" hidden="false">
      <description>During either player&apos;s assault phase, after passing a Psychic test, all enemy models in base contact with the sorcerer are at -1 Attack (to a minimum of 1). On a failed Psychic test all friendly models within 2&quot; are impacted instead.</description>
    </rule>
    <rule name="Miasma of Pestilence" id="37c9-7dba-8c87-14df" hidden="false">
      <description>After the psychic test, place the small blast marker at any point within 24&quot; the sorcerer can see. Roll the Scatter Dice and a D6 to determine the final location. Any enemy units with models under the templace must pass a Morale check or fall back using the normal rules.</description>
    </rule>
    <rule name="Nausea" id="5991-6df5-2d24-8427" hidden="false">
      <description>During the enemy shooting phase, choose an enemy unit or independent character within 12&quot; and LOS. After passing a psychic test the target will be at - BS for this shooting phase.</description>
    </rule>
    <rule name="Nurgle Minor Psyker Powers" id="58e3-ca82-5c9c-7dd6" hidden="false">
      <description>1. No Usable Power
2. Nurgle&apos;s Dance
3. Nausea
4. Affliction
5. Miasma of Pestilence
6. Aura of Decay</description>
    </rule>
    <rule name="Nurgle&apos;s Dance" id="b695-4a72-8bc1-1aa7" hidden="false">
      <description>During the Chaos player&apos;s shoot phase choose a unit or model with 12&quot;. After passing the psychic test, if the target is behind cover it must pass a Leadership test or lose the benefits of that cover for the remainder of the turn.</description>
    </rule>
    <rule name="Mass Mutation" id="2d74-0cb5-9221-7cf8" hidden="false">
      <description>The power is used in the Shooting phase. If the test is passed, the unit of Chosen, Possessed, Marines, or Havocs joined by the Sorcerer gains an ability determined randomly by the table below for a single turn:
1 - No benefit. Roll a D6 for each model; On a roll of 1 the model is removed as a casualty
2 - Gain +1 S
3 - Cause -1 Ld versus units they win close combat against
4 - Gain +1 T
5 - Gain 5+ invulnerable save
6 - Gain +1 A</description>
    </rule>
    <rule name="Gift of Chaos" id="0363-ca21-ee2f-4944" hidden="false">
      <description>Pick an enemy or friendly model within 2&quot; of the Sorcerer and then take a Psychic test. If the test is successful, for a D6. If you roll over the victim&apos;s Toughness, or roll a natural 6, the victim is transformed into a Chaos Space, with no armour save allowed.</description>
    </rule>
    <rule name="Daemonic Speed" id="1c63-e366-f11e-bab6" hidden="false">
      <description>The model may choose to move as Cavalry, but must move as infantry on the turn it disembarks from a vehicle.</description>
    </rule>
    <rule name="Daemonic Venom" id="8cfe-f8f0-0c7b-eb90" hidden="false">
      <description>Always wounds on a 4+</description>
    </rule>
    <rule name="Furious Charge" id="b056-8420-97c1-5ce1" hidden="false">
      <description>When the unit charges, all models are at +1 I and +1 S</description>
    </rule>
    <rule name="Hit and Run" id="7a43-a220-c77b-3777" hidden="false">
      <description>At the end of a round of close combat the unit may choose to break off if they and at least some of their close combat opponents do not have to fall back. The unit falls back 3D6&quot; in any direction and automatically regroups at the end of the move. The enemy units may only consolidate.</description>
    </rule>
    <rule name="Feel no Pain" id="f47c-e4ac-d32a-7067" hidden="false">
      <description>If the model loses a wound roll a dice. On a 4+ the wound is ignored. This ability cannot be used against weapons whose strength is at least twice the Toughtness of the model or against close combat weapons that allow no save.</description>
    </rule>
    <rule name="Rage of Khorne" id="e52f-cf1a-25c3-ce5c" hidden="false">
      <description>The model gains +D3 attacks instead of the normal +1 when charging.</description>
    </rule>
    <rule name="Juggernaut of Khorne" id="12a7-3e98-c239-c8f6" hidden="false">
      <description>Steed that confers Daemonic Strength, Daemonic Essence and Daemonic Mutation</description>
    </rule>
    <rule name="Daemonic Essence" id="a4ed-33ce-50ba-f254" hidden="false">
      <description>+1 Wound</description>
    </rule>
    <rule name="Daemonic Mutation" id="bb66-2bde-5cfa-b6d3" hidden="false">
      <description>+1 Attack</description>
    </rule>
    <rule name="Daemonic Strength" id="e679-08ee-1c62-50fc" hidden="false">
      <description>+1 Strength</description>
    </rule>
    <rule name="Daemonic Aura" id="6027-131e-50e1-ca82" hidden="false">
      <description>Model gains a 5+ Invulnerable save</description>
    </rule>
    <rule name="Berserker Glaive" id="3418-023f-98bd-d364" hidden="false">
      <description>May not join units, have Followers, or ride a Steed. Always fails the Blood Frenzy test and the Glaive confers a 4+ invulnerable save and doubles the basic number of attacks of the bearer. The bearer must always make sweeping advances, unless wearing Terminator armour.</description>
    </rule>
    <rule name="Daemonic Resilience" id="3da2-af51-14a0-7df3" hidden="false">
      <description>+1 Toughness</description>
    </rule>
    <rule name="Allure of Slaanesh" id="f0f8-5cd0-bd7f-ac61" hidden="false">
      <description>Instead of firing a weapon the model projects a siren song up to 12&quot; at a single enemy independent character or unit that is not in close combat. Make a Leadership test for the model or unit affected. If they fail they must immediately move D6&quot; toward the model, stopping 1&quot; short of any Chaos models they encounter and ignoring difficult terrain penalties.</description>
    </rule>
    <rule name="Aura of Acquiescence" id="1ed8-c28d-1d52-39c6" hidden="false">
      <description>If an enemy unit fights in close combat against a model with the Aura of Acquiescence and loses they do not take a Morale check and will remain in combat.</description>
    </rule>
    <rule name="Daemonic Armour" id="315d-78a9-104e-afc9" hidden="false">
      <description>Gain 2+ Armour save</description>
    </rule>
    <rule name="Daemonic Rune" id="7b85-2962-8e32-4ece" hidden="false">
      <description>Ignored Instant Death rule</description>
    </rule>
    <rule name="Eye of Tzeentch" id="d5d6-c404-43e7-e17b" hidden="false">
      <description>The Eye allows the bearer to re-roll either a single armour save, a single to hit roll, or a single to wound roll in each of their turns.</description>
    </rule>
    <rule name="Talisman of Burning Blood" id="c68c-edbf-1fb0-0082" hidden="false">
      <description>Roll two dice instead of one to test for Blood Frenzy. If either is a 1 or 2 they advanced as described in the Blood Frenzy rule</description>
    </rule>
    <rule name="Talisman of Tzeentch" id="5e44-1037-b656-5667" hidden="false">
      <description>Opposing psykers suffer a -1 modifier to their Leadership for psyychic tests if the army includes a model with this talisman. The ability does not stack with other Talismans.</description>
    </rule>
    <rule name="Plague Sword" id="bcd3-9bdd-cbe4-a588" hidden="false">
      <description>Roll a D6 for each model wounded but not killed. On a roll of 4+ the model is killed outright no matter how many wounds they have.</description>
    </rule>
    <rule name="Needle of Desire" id="5593-9b5e-29fe-c0cb" hidden="false">
      <description>Always wounds on a 2+. Models wounded by Needle but not killed must take a Leadership test or take a further D3 wounds with no saves allowed. The needle otherwise never ignores armour saves, even when used by models with Daemonic Stature.</description>
    </rule>
    <rule name="Disc of Tzeentch" id="5f31-00df-4132-f07c" hidden="false">
      <description>Steed that grants Daemonic Flight and Daemonic Mutation. Cannot also have followers.</description>
    </rule>
    <rule name="Bedlam Staff" id="22a7-5a41-1e73-5cba" hidden="false">
      <description>Any models wounded but not killed by the Bedlam Staff may not attack until the end of the next Assault phase. Vehicles hit by it are &apos;crew shaken&apos; in addition to any other results they suffer.</description>
    </rule>
    <rule name="Lash of Torment" id="9135-c2aa-78e4-a125" hidden="false">
      <description>Units that lost one or more models to the Lash of Torment will be at -1 Ld if they lose the combat.</description>
    </rule>
    <rule name="Warp Blade" id="2a21-464f-d6ab-ccbf" hidden="false">
      <description>Enemy psykers who use a power within 12&quot; of the Warp Blade must roll a D6. On a 4+ the power works normally, but otherwise they immediately suffer a Perils of the Warp attack and the power fails to function.</description>
    </rule>
    <rule name="Steed of Slaanesh" id="f8da-4d2b-4c52-a0bb" hidden="false">
      <description>Steed that grants Daemonic Speed and Daemonic Mutation</description>
    </rule>
    <rule name="Chaos Icon" id="fea4-9a43-8403-b3aa" hidden="false">
      <description>This model can be used as icons for the purposes of summoning daemons aligned to the same God.</description>
    </rule>
  </sharedRules>
