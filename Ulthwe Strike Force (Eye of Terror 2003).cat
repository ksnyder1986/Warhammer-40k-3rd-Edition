    <selectionEntry name="Waystones" id="bf62-8a11-4ee8-6d21" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="334a-17f4-766e-9406" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="25"/>
      </costs>
      <rules>
        <rule name="Waystones" id="1155-50bc-a0e7-0fb8" hidden="false">
          <description>If a psyker still help in reserve has a waystone, one Reserve roll may be re-rolled per turn, whatever the result. Furthermore, by psychically attuning himself to the waystone, a psyker can channel the immense psychic power stored within it onto the battlefield. Once per game, the bearer may cast Eldritch Storm in addition to any other psychic powers he may have. This is cast automatically and may not be Augmented.</description>
        </rule>
      </rules>
    </selectionEntry>
