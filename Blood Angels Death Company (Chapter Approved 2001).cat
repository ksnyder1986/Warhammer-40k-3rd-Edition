    <entryLink name="Dreadnought" id="3a0f-d222-f3ba-16ed" collective="false" hidden="false" import="true" targetId="3f7e-ad94-b024-1a57" type="selectionEntry">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="6f6b-d25d-2441-5c06" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
