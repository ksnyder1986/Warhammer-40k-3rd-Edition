      <infoLinks>
        <infoLink name="Death Company Special Rules" id="58d2-5317-039c-f3cc" hidden="false" targetId="71bf-c6ac-56a8-9599" type="infoGroup"/>
      </infoLinks>
      <rules>
        <rule name="Black Rage" id="48bb-0a90-3782-da58" hidden="false">
          <description>The dreadnought must always move towards the enemy as fast as possible, and must assault an enemy within range in the assault phase.</description>
        </rule>
        <rule name="Rampage" id="1ce7-4847-7502-084d" hidden="false">
          <description>The dreadnought ignores any Crew Shaken and Crew Stunned results.</description>
        </rule>
      </rules>
    </entryLink>
