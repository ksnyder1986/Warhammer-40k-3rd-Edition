              <description>The bearer may re-roll one failed to hit roll per turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Melta Bombs" id="e1ec-88fb-18b4-e8b3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
