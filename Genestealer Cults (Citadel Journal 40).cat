                    <infoLink name="Cult Relic" id="c157-36d1-cde0-6d64" hidden="false" targetId="c8e6-e2a6-e887-5a21" type="rule"/>
                  </infoLinks>
                </selectionEntry>
              </selectionEntries>
              <selectionEntryGroups>
                <selectionEntryGroup name="Protectorates" id="f1f1-043c-5632-aa71" collective="false" defaultSelectionEntryId="81af-7b73-224e-460a" hidden="false" import="true" sortIndex="1">
                  <constraints>
                    <constraint id="7dfb-c13e-5cde-d91d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="10"/>
                    <constraint id="5859-3c7c-6191-20f2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="5"/>
                  </constraints>
                  <selectionEntries>
                    <selectionEntry name="Protectorate" id="81af-7b73-224e-460a" collective="false" hidden="false" import="true" type="model">
                      <costs>
                        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="9"/>
                      </costs>
                      <infoLinks>
                        <infoLink name="Protectorate" id="649e-93ca-2690-7daa" hidden="false" targetId="975f-c2b7-0b45-d50c" type="profile"/>
                        <infoLink name="Close Combat Weapon" id="6443-c412-e2a8-5746" hidden="false" targetId="46d5-85f2-d932-f0a2" type="profile"/>
                      </infoLinks>
                      <rules>
                        <rule name="Suicide Bombers" id="94d0-875e-227b-aec7" hidden="false">
                          <description>At the start of either player&apos;s Assault Phase each Protectorate model may detonate their bomb, instantly killing themselves but causing one model in contact to take an automatic Strength 6 hit. Only models in base contact are effected, and any casualties count toward resolving the Assault. Once all Suicide Bombs are completed, resolve the rest of the Assault Phase as normal.

This special attack can also be used against vehicles as well, with each model causing an automatic hit with an AP value of 6+D6, no matter the vehicle type or speed.</description>
                        </rule>
                        <rule name="Death or Glory Attack" id="e8dd-6885-7b71-b9fe" hidden="false">
                          <description>When Tank Shocked, multiple Protectorate members can stand and detonate their bomb. The cult player must declare how many Protectorate will be standing and remove them from play, and then resolve that many attacks against the vehicle.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
