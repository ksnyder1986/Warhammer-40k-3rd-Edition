    <selectionEntry name="Genestealers" id="e51d-d0f7-ea85-6f6b" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Rending Claws" id="1f8f-2af5-7671-b6ae" hidden="false" targetId="b3e6-8d18-5e36-d27e" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Master Predator" id="f870-02dd-337d-0c90" hidden="false">
          <description>Genestealer Brood can choose to either move an additional D6&quot; in the Shooting Phase, or remain stationary and gain a 5+ Cover Save, even if in open ground, unless they are in close combat. Cult Genestealer Broods also roll an extra D6 when moving through terrain.</description>
        </rule>
        <rule name="Hive Mind Link" id="720d-f468-2f4e-25ef" hidden="false">
          <description>In any game where the Reserve rules are in use, the Cult player may bring on any Genestealer Broods in any turn desired after the first without needing to roll for them.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Genestealers" id="a7ce-b24c-ebdb-b14f" collective="false" defaultSelectionEntryId="312b-e265-6d6e-8f45" hidden="false" import="true">
