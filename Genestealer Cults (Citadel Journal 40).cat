        <infoLink name="Independent Character" id="0271-c8ea-031a-7d04" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule"/>
        <infoLink name="Hypnotic Gaze" id="65c2-3871-8201-641a" hidden="false" targetId="7480-6633-9906-f11b" type="rule"/>
        <infoLink name="Genestealer Magus" id="6956-f18b-6931-4555" hidden="false" targetId="7626-8fa0-f433-5dba" type="profile"/>
        <infoLink name="Laspistol" id="cb19-1a6c-3138-86f1" hidden="false" targetId="95a9-d270-d218-1772" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="He Who Runs Away..." id="9d2f-f8aa-24a5-7ab3" hidden="false">
          <description>The Magus can make a Voluntary Fall-back by making a successful Leadership Test, leaving his Bodyguard to keep on fighting in an Assault. He will automatically Regroup after this movement has ended, or if he reaches the edge of the board.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Bodyguard" id="e19f-61e5-eacd-63fd" collapsible="true" collective="false" hidden="false" import="true" sortIndex="3" type="upgrade">
          <constraints>
            <constraint id="9973-f58c-50bd-e859" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
