    <selectionEntry name="Land Raider Crusader" id="f995-47f0-4378-bdfb" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="4dde-5f84-ef50-5a93" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
