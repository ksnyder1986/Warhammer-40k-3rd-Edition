    <selectionEntry name="Artillery Strike" id="d33f-f31c-064d-1c81" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="e527-b597-d52c-ab7e" hidden="false" primary="true" targetId="aacb-8a81-62c0-3db8"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0"/>
      </costs>
      <rules>
        <rule name="Inaccuracy" id="e150-e6dd-34fd-0ffb" hidden="false">
          <description>An Orbital Strike scatters just like ordinary ordnance weapons, except when a miss is rolled the distance scattered is double the number scored on the D6. If a hit is rolled, the template deviates by the distance shown on the Hit Symbol.</description>
        </rule>
        <rule name="Pinning" id="aea5-adcb-195d-fc91" hidden="false">
          <description>All Orbital Strikes cause Pinning tests</description>
        </rule>
        <rule name="Placement" id="901f-1304-a7d0-20dc" hidden="false">
          <description>The blast marker for the artillery strike can be placed anywhere visible to the Artillery Forward Observer, Company Command Tank, or the Armoured Fist Company Command HQ that is calling in the fire. This can be an enemy unit, or just a point on the tabletop.</description>
        </rule>
        <rule name="Timing" id="5f33-65cb-3807-1d26" hidden="false">
          <description>An artillery strike uses the Reserve special rule to determine when it strikes. Once the artillery strike passes the Reserve roll it fires each Imperial Guard shooting phases for the rest of the game. It cannot be stopped once started.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Strike Type" id="87c9-1454-8048-a932" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="846e-368c-e846-d57c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5108-55fa-a292-4d58" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
