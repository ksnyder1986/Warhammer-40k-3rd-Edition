    <selectionEntry name="Cyclops" id="c296-a03a-693a-5578" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="25"/>
      </costs>
      <infoLinks>
        <infoLink name="Cyclops" id="e36b-791e-fedf-8dd9" hidden="false" targetId="0fec-d2b4-d14c-dd2c" type="profile"/>
        <infoLink name="Demolition Charge" id="bd9b-b06e-b12a-820e" hidden="false" targetId="60f0-36e3-b539-71ac" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="Remote Controlled" id="e495-ab7e-8f4f-f3ea" hidden="false">
          <description>The Cyclops is controlled by a single guardsman, or by the crew of a transporting Chimera. It moves independently of its controller, but it must remain with 48&quot; of the controller, otherwise it simple stops and cannot do anything until control is restored.
During the Imperial Guard Shooting Phase the Cyclops can be detonated. Place the Ordnance template centered on the Cyclops. It is destroyed during the explosion.</description>
        </rule>
        <rule name="Damage" id="bdf6-b3cb-a136-9da1" hidden="false">
          <description>The Cyclops is destroyed by any glancing or penetrating hits. When rolling for armour penetration, if a weapon scores a 6, and this results in a penetrating hit, then the Cyclops explodes as normal.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Operator" id="78c9-999e-ce86-cd03" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6f80-3013-44f4-357e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
